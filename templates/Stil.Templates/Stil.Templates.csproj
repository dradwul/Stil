<Project Sdk="Microsoft.NET.Sdk">

  <!-- A dotnet new template package. It has no code; the templates are in content/. The version
       and the shared package metadata come from Directory.Build.props. -->
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Stil.Templates</PackageId>
    <Title>Stil for Blazor templates</Title>
    <Description>dotnet new templates for Stil for Blazor: stil-app creates a Blazor Web App with Stil's themeable components, a navbar, a color-mode switch, optional sample pages and the features you choose (charts, editors, planners, chat and more); stil-site creates a product website from Stil's page blocks, with pricing, a blog and a contact form.</Description>
    <PackageTags>dotnet-new;templates;Blazor;CSS;components;Stil</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <ContentTargetFolders>content</ContentTargetFolders>
    <!-- Pack .gitignore and .template.config, which NuGet skips by default. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <!-- The package has no lib/ folder on purpose. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**;content\**\.vs\**;content\**\*.user" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
