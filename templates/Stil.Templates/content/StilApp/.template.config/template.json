{
  "$schema": "https://json.schemastore.org/template",
  "author": "Ludvig Andersson",
  "classifications": [ "Web", "Blazor" ],
  "identity": "Stil.Templates.StilApp",
  "groupIdentity": "Stil.Templates.StilApp",
  "name": "Stil for Blazor App",
  "description": "A Blazor Web App styled with Stil for Blazor: a navbar, a color-mode switch, themes, dialogs and toasts, and optional sample pages with a data grid and a form.",
  "shortName": "stil-app",
  "defaultName": "StilApp",
  "sourceName": "StilApp",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!HasCharts)",
          "exclude": [ "Components/Pages/Features/Charts.razor" ]
        },
        {
          "condition": "(!HasMarkdown)",
          "exclude": [ "Components/Pages/Features/Notes.razor" ]
        },
        {
          "condition": "(!HasRichText)",
          "exclude": [ "Components/Pages/Features/ProductText.razor" ]
        },
        {
          "condition": "(!HasDataGrid)",
          "exclude": [ "Components/Pages/Features/Sales.razor" ]
        },
        {
          "condition": "(!HasCalendar)",
          "exclude": [ "Components/Pages/Features/Planner.razor" ]
        },
        {
          "condition": "(!HasKanban)",
          "exclude": [ "Components/Pages/Features/Board.razor" ]
        },
        {
          "condition": "(!HasGantt)",
          "exclude": [ "Components/Pages/Features/Project.razor" ]
        },
        {
          "condition": "(!HasSchedule)",
          "exclude": [ "Components/Pages/Features/Bookings.razor" ]
        },
        {
          "condition": "(!HasChat)",
          "exclude": [ "Components/Pages/Features/Chat.razor" ]
        },
        {
          "condition": "(!HasActivity)",
          "exclude": [ "Components/Pages/Features/Activity.razor" ]
        },
        {
          "condition": "(!HasScanner)",
          "exclude": [ "Components/Pages/Features/Scan.razor" ]
        },
        {
          "condition": "(!HasSignature)",
          "exclude": [ "Components/Pages/Features/Sign.razor" ]
        },
        {
          "condition": "(!HasNotifications)",
          "exclude": [ "Components/Pages/Features/Notifications.razor" ]
        },
        {
          "condition": "(!HasCommands)",
          "exclude": [ "Components/Layout/AppCommands.razor" ]
        },
        {
          "condition": "(!HasOrders)",
          "exclude": [ "Components/Pages/NewOrder.razor", "Data/Order.cs", "Data/OrderService.cs" ]
        },
        {
          "condition": "(!IsAdmin)",
          "exclude": [ "Components/Pages/Admin/**" ]
        },
        {
          "condition": "(!IsDashboard)",
          "exclude": [ "Components/Pages/Dashboard/**", "Data/SalesService.cs" ]
        },
        {
          "condition": "(!IsMonitoring)",
          "exclude": [ "Components/Pages/Monitoring/**", "Data/MonitoringService.cs" ]
        },
        {
          "condition": "(!IsFinance)",
          "exclude": [ "Components/Pages/Finance/**", "Data/FinanceService.cs" ]
        },
        {
          "condition": "(!IsPlanner)",
          "exclude": [ "Components/Pages/Planner/**" ]
        },
        {
          "condition": "(!IsBlank)",
          "exclude": [ "Components/Pages/Home.razor", "Components/Pages/Home.Empty.razor" ]
        },
        {
          "condition": "(HasSampleOrders)",
          "exclude": [ "Components/Pages/Home.Empty.razor" ]
        },
        {
          "condition": "(IsBlank && !IncludeSampleContent)",
          "exclude": [ "Components/Pages/Home.razor" ],
          "rename": { "Components/Pages/Home.Empty.razor": "Components/Pages/Home.razor" }
        }
      ]
    }
  ],
  "symbols": {
    "AppTitle": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "identity",
      "replaces": "My Stil App"
    },
    "Framework": {
      "type": "parameter",
      "description": "The target framework for the project.",
      "datatype": "choice",
      "choices": [
        { "choice": "net10.0", "description": "Target net10.0" }
      ],
      "replaces": "net10.0",
      "defaultValue": "net10.0"
    },
    "Primary": {
      "type": "parameter",
      "description": "The brand color, as a CSS color such as #7048e8. It is set with AddStil() in Program.cs. Without it, the app uses Stil's default teal (#34dbbf).",
      "datatype": "text",
      "defaultValue": "",
      "replaces": "STIL_PRIMARY_COLOR"
    },
    "HasPrimary": {
      "type": "computed",
      "value": "(Primary != \"\")"
    },
    "Radius": {
      "type": "parameter",
      "description": "How round the corners are: of buttons, fields, cards and dialogs. It is set with AddStil() in Program.cs.",
      "datatype": "choice",
      "choices": [
        { "choice": "sharp", "description": "Square corners" },
        { "choice": "small", "description": "Slightly rounded" },
        { "choice": "default", "description": "Stil's default" },
        { "choice": "large", "description": "Rounder" },
        { "choice": "round", "description": "Very round" }
      ],
      "defaultValue": "default"
    },
    "HasRadius": {
      "type": "computed",
      "value": "(Radius != \"default\")"
    },
    "RadiusSmall": {
      "type": "generated",
      "generator": "switch",
      "replaces": "STIL_RADIUS_SM",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(Radius == \"sharp\")", "value": "0" },
          { "condition": "(Radius == \"small\")", "value": "0.0625rem" },
          { "condition": "(Radius == \"large\")", "value": "0.25rem" },
          { "condition": "(Radius == \"round\")", "value": "0.5rem" },
          { "condition": "", "value": "0.125rem" }
        ]
      }
    },
    "RadiusMedium": {
      "type": "generated",
      "generator": "switch",
      "replaces": "STIL_RADIUS_MD",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(Radius == \"sharp\")", "value": "0" },
          { "condition": "(Radius == \"small\")", "value": "0.125rem" },
          { "condition": "(Radius == \"large\")", "value": "0.5rem" },
          { "condition": "(Radius == \"round\")", "value": "1rem" },
          { "condition": "", "value": "0.25rem" }
        ]
      }
    },
    "RadiusLarge": {
      "type": "generated",
      "generator": "switch",
      "replaces": "STIL_RADIUS_LG",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(Radius == \"sharp\")", "value": "0" },
          { "condition": "(Radius == \"small\")", "value": "0.25rem" },
          { "condition": "(Radius == \"large\")", "value": "1rem" },
          { "condition": "(Radius == \"round\")", "value": "2rem" },
          { "condition": "", "value": "0.5rem" }
        ]
      }
    },
    "Font": {
      "type": "parameter",
      "description": "The app's font. Lexend, the default, is free (SIL Open Font License) and comes from Google Fonts; the others come from cdnfonts.com (check their license there; the BR fonts are commercial). It is set with AddStil() in Program.cs. --GoogleFont takes any Google font instead.",
      "datatype": "choice",
      "choices": [
        { "choice": "lexend", "description": "Lexend, Stil's default (free, from Google Fonts)" },
        { "choice": "br-shape", "description": "BR Shape (commercial)" },
        { "choice": "br-cobane", "description": "BR Cobane (commercial)" },
        { "choice": "br-segma", "description": "BR Segma (commercial)" },
        { "choice": "br-sonoma", "description": "BR Sonoma (commercial)" },
        { "choice": "averral", "description": "Averral" },
        { "choice": "sukplena", "description": "Sukplena" },
        { "choice": "tasa-explorer", "description": "TASA Explorer" },
        { "choice": "halcom", "description": "Halcom" },
        { "choice": "utara", "description": "Utara" },
        { "choice": "geologica", "description": "Geologica" },
        { "choice": "blowreph", "description": "BLOWREPH (display font)" },
        { "choice": "taster", "description": "Taster (display font)" },
        { "choice": "warm-stories", "description": "WARM STORIES (display font)" },
        { "choice": "system", "description": "The operating system's font; nothing is downloaded" }
      ],
      "defaultValue": "lexend"
    },
    "FontValue": {
      "type": "generated",
      "generator": "switch",
      "replaces": "StilFonts.Lexend",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(Font == \"br-shape\")", "value": "StilFonts.BrShape" },
          { "condition": "(Font == \"br-cobane\")", "value": "StilFonts.BrCobane" },
          { "condition": "(Font == \"br-segma\")", "value": "StilFonts.BrSegma" },
          { "condition": "(Font == \"br-sonoma\")", "value": "StilFonts.BrSonoma" },
          { "condition": "(Font == \"averral\")", "value": "StilFonts.Averral" },
          { "condition": "(Font == \"sukplena\")", "value": "StilFonts.Sukplena" },
          { "condition": "(Font == \"tasa-explorer\")", "value": "StilFonts.TasaExplorer" },
          { "condition": "(Font == \"halcom\")", "value": "StilFonts.Halcom" },
          { "condition": "(Font == \"utara\")", "value": "StilFonts.Utara" },
          { "condition": "(Font == \"geologica\")", "value": "StilFonts.Geologica" },
          { "condition": "(Font == \"blowreph\")", "value": "StilFonts.Blowreph" },
          { "condition": "(Font == \"taster\")", "value": "StilFonts.Taster" },
          { "condition": "(Font == \"warm-stories\")", "value": "StilFonts.WarmStories" },
          { "condition": "", "value": "StilFonts.Lexend" }
        ]
      }
    },
    "GoogleFont": {
      "type": "parameter",
      "description": "Any Google font by its family name, for example \"Inter\" or \"Open Sans\". It replaces --Font.",
      "datatype": "text",
      "defaultValue": "",
      "replaces": "STIL_GOOGLE_FONT"
    },
    "HasGoogleFont": {
      "type": "computed",
      "value": "(GoogleFont != \"\")"
    },
    "HasWebFont": {
      "type": "computed",
      "value": "(GoogleFont == \"\" && Font != \"system\")"
    },
    "ColorMode": {
      "type": "parameter",
      "description": "The color mode the app starts in. Users can change it with the switch in the navbar.",
      "datatype": "choice",
      "choices": [
        { "choice": "light", "description": "Light mode" },
        { "choice": "dark", "description": "Dark mode" },
        { "choice": "auto", "description": "Follow the operating system setting" }
      ],
      "defaultValue": "auto"
    },
    "ColorModeValue": {
      "type": "generated",
      "generator": "switch",
      "replaces": "StilThemeMode.Auto",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(ColorMode == \"light\")", "value": "StilThemeMode.Light" },
          { "condition": "(ColorMode == \"dark\")", "value": "StilThemeMode.Dark" },
          { "condition": "", "value": "StilThemeMode.Auto" }
        ]
      }
    },
    "Culture": {
      "type": "parameter",
      "description": "The app's default language, for visitors whose browser asks for none of the offered ones. Users can change it with the language selector in the navbar. Stil's components have built-in texts in all of these; the app's own texts are in Locales/*.json (English and Swedish to start with).",
      "datatype": "choice",
      "choices": [
        { "choice": "en", "description": "English" },
        { "choice": "sv", "description": "Swedish" },
        { "choice": "nb", "description": "Norwegian (Bokmål)" },
        { "choice": "da", "description": "Danish" },
        { "choice": "fi", "description": "Finnish" }
      ],
      "defaultValue": "en",
      "replaces": "STIL_DEFAULT_CULTURE"
    },
    "Interactivity": {
      "type": "parameter",
      "description": "The render mode of the app.",
      "datatype": "choice",
      "choices": [
        { "choice": "Server", "description": "Interactive server rendering for the whole app" },
        { "choice": "None", "description": "Static server rendering only (no interactivity)" }
      ],
      "defaultValue": "Server"
    },
    "UseServer": {
      "type": "computed",
      "value": "(Interactivity == \"Server\")"
    },
    "IncludeSampleContent": {
      "type": "parameter",
      "description": "Add a dashboard page with KPI cards and a data grid, and a form page with validation. Without it, the app has one empty Home page. Only for --Starter blank.",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "Features": {
      "type": "parameter",
      "description": "Extra features, each with what it needs (a package, a stylesheet, a using) and an example page with sample data in the Features menu. Choose several, or all.",
      "datatype": "choice",
      "allowMultipleValues": true,
      "enableQuotelessLiterals": true,
      "choices": [
        { "choice": "charts", "description": "Line, bar and donut charts (adds the Stil.Charts package)" },
        { "choice": "markdown", "description": "Notes in Markdown, with an editor and a view (adds the Stil.Markdown package)" },
        { "choice": "richtext", "description": "A rich text editor and view that store sanitized HTML (adds the Stil.RichText package)" },
        { "choice": "datagrid", "description": "A data grid with filters, grouping, totals and CSV export" },
        { "choice": "calendar", "description": "A week planner: drag to create, move and resize events" },
        { "choice": "kanban", "description": "A kanban board with drag and drop and column limits" },
        { "choice": "gantt", "description": "A Gantt chart with progress, dependencies and milestones" },
        { "choice": "schedule", "description": "A resource schedule: rooms, people or vehicles as rows, the day across" },
        { "choice": "chat", "description": "A chat and a comment thread" },
        { "choice": "activity", "description": "An activity log with search and filters" },
        { "choice": "scanner", "description": "Barcode and QR code scanning, with the camera or a handheld scanner" },
        { "choice": "signature", "description": "A signature pad in a form" },
        { "choice": "commands", "description": "A command palette (Ctrl+K) that finds every page" },
        { "choice": "notifications", "description": "A notification bell in the navbar, and toasts that stay under it" },
        { "choice": "all", "description": "Every feature above" }
      ],
      "defaultValue": ""
    },
    "HasCharts": {
      "type": "computed",
      "value": "(Features == \"charts\" || Features == \"all\")"
    },
    "HasMarkdown": {
      "type": "computed",
      "value": "(Features == \"markdown\" || Features == \"all\")"
    },
    "HasRichText": {
      "type": "computed",
      "value": "(Features == \"richtext\" || Features == \"all\")"
    },
    "HasDataGrid": {
      "type": "computed",
      "value": "(Features == \"datagrid\" || Features == \"all\")"
    },
    "HasCalendar": {
      "type": "computed",
      "value": "(Features == \"calendar\" || Features == \"all\" || IsPlanner)"
    },
    "HasKanban": {
      "type": "computed",
      "value": "(Features == \"kanban\" || Features == \"all\" || IsPlanner)"
    },
    "HasGantt": {
      "type": "computed",
      "value": "(Features == \"gantt\" || Features == \"all\" || IsPlanner)"
    },
    "HasSchedule": {
      "type": "computed",
      "value": "(Features == \"schedule\" || Features == \"all\" || IsPlanner)"
    },
    "HasChat": {
      "type": "computed",
      "value": "(Features == \"chat\" || Features == \"all\")"
    },
    "HasActivity": {
      "type": "computed",
      "value": "(Features == \"activity\" || Features == \"all\")"
    },
    "HasScanner": {
      "type": "computed",
      "value": "(Features == \"scanner\" || Features == \"all\")"
    },
    "HasSignature": {
      "type": "computed",
      "value": "(Features == \"signature\" || Features == \"all\")"
    },
    "HasCommands": {
      "type": "computed",
      "value": "(Features == \"commands\" || Features == \"all\" || IsAdmin || IsPlanner)"
    },
    "HasNotifications": {
      "type": "computed",
      "value": "(Features == \"notifications\" || Features == \"all\")"
    },
    "HasFeatures": {
      "type": "computed",
      "value": "(HasCharts || HasMarkdown || HasRichText || HasDataGrid || HasCalendar || HasKanban || HasGantt || HasSchedule || HasChat || HasActivity || HasScanner || HasSignature || HasCommands || HasNotifications)"
    },
    "HasFeaturePages": {
      "type": "computed",
      "value": "(HasCharts || HasMarkdown || HasRichText || HasDataGrid || HasCalendar || HasKanban || HasGantt || HasSchedule || HasChat || HasActivity || HasScanner || HasSignature || HasNotifications)"
    },
    "HasFeatureMenu": {
      "type": "computed",
      "value": "(HasCharts || HasMarkdown || HasRichText || HasDataGrid || ((HasCalendar || HasKanban || HasGantt || HasSchedule) && !IsPlanner) || HasChat || HasActivity || HasScanner || HasSignature || HasNotifications)"
    },
    "Starter": {
      "type": "parameter",
      "description": "A complete app to start from: a set of features with its own pages, menu and sample data. The sample data sits behind a small interface in Data/, so the app can swap in real data without touching the pages.",
      "datatype": "choice",
      "choices": [
        { "choice": "blank", "description": "A dashboard and an order form (with --IncludeSampleContent), or one empty page" },
        { "choice": "admin", "description": "Orders in a data grid with editing, export and a change history" },
        { "choice": "dashboard", "description": "KPI cards with sparklines, line, bar and donut charts, and a product list" },
        { "choice": "monitoring", "description": "Gauges, sparklines and a heat map refreshed every few seconds, alerts under the bell, and an event log" },
        { "choice": "finance", "description": "Budget against actuals, a margin line, month notes in Markdown, and transactions with totals and export" },
        { "choice": "planner", "description": "A week planner, a resource schedule, a kanban board and a Gantt plan" }
      ],
      "defaultValue": "blank"
    },
    "IsBlank": {
      "type": "computed",
      "value": "(Starter == \"blank\")"
    },
    "IsAdmin": {
      "type": "computed",
      "value": "(Starter == \"admin\")"
    },
    "IsDashboard": {
      "type": "computed",
      "value": "(Starter == \"dashboard\")"
    },
    "IsMonitoring": {
      "type": "computed",
      "value": "(Starter == \"monitoring\")"
    },
    "IsFinance": {
      "type": "computed",
      "value": "(Starter == \"finance\")"
    },
    "IsPlanner": {
      "type": "computed",
      "value": "(Starter == \"planner\")"
    },
    "HasSampleOrders": {
      "type": "computed",
      "value": "(IsBlank && IncludeSampleContent)"
    },
    "HasOrders": {
      "type": "computed",
      "value": "(HasSampleOrders || IsAdmin)"
    },
    "HasNotificationBell": {
      "type": "computed",
      "value": "(HasNotifications || IsAdmin || IsMonitoring)"
    },
    "UseCharts": {
      "type": "computed",
      "value": "(HasCharts || IsDashboard || IsMonitoring || IsFinance)"
    },
    "UseMarkdown": {
      "type": "computed",
      "value": "(HasMarkdown || IsFinance)"
    },
    "UseRichText": {
      "type": "computed",
      "value": "(HasRichText)"
    },
    "NeedsInteractivity": {
      "type": "computed",
      "value": "(HasFeatures || !IsBlank)"
    },
    "StilVersion": {
      "type": "parameter",
      "description": "The version of the Stil NuGet package to reference.",
      "datatype": "text",
      "defaultValue": "0.1.0",
      "replaces": "STIL_PACKAGE_VERSION"
    },
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "description": "If specified, skips the automatic restore of the project on create.",
      "defaultValue": "false"
    },
    "HttpPort": {
      "type": "parameter",
      "datatype": "integer",
      "description": "Port number to use for the HTTP endpoint in launchSettings.json."
    },
    "HttpPortGenerated": {
      "type": "generated",
      "generator": "port",
      "parameters": { "low": 5000, "high": 5300 }
    },
    "HttpPortReplacer": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": { "sourceVariableName": "HttpPort", "fallbackVariableName": "HttpPortGenerated" },
      "replaces": "5500"
    },
    "HttpsPort": {
      "type": "parameter",
      "datatype": "integer",
      "description": "Port number to use for the HTTPS endpoint in launchSettings.json."
    },
    "HttpsPortGenerated": {
      "type": "generated",
      "generator": "port",
      "parameters": { "low": 7000, "high": 7300 }
    },
    "HttpsPortReplacer": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": { "sourceVariableName": "HttpsPort", "fallbackVariableName": "HttpsPortGenerated" },
      "replaces": "5501"
    }
  },
  "primaryOutputs": [
    { "path": "StilApp.csproj" }
  ],
  "postActions": [
    {
      "id": "restore",
      "condition": "(!skipRestore)",
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [ { "text": "Run 'dotnet restore'" } ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
