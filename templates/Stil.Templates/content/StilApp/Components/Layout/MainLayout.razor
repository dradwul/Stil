@inherits LayoutComponentBase
@inject IStringLocalizer<MainLayout> L

@* StilThemeProvider sets the color mode for the whole app. *@
<StilThemeProvider Mode="_mode" class="app-shell">
    <StilNavbar Sticky CollapseBelow="StilBreakpoint.Medium" BrandText="My Stil App">
        <ChildContent>
            <StilNav Label="@L["Nav.Main"]">
                @*#if (HasSampleOrders)
                <StilNavLink Href="" Match="NavLinkMatch.All" Icon="@StilIcons.Home">@L["Nav.Dashboard"]</StilNavLink>
                <StilNavLink Href="orders/new" Icon="@StilIcons.Plus">@L["Nav.NewOrder"]</StilNavLink>
                ##endif*@
                @*#if (IsBlank && !IncludeSampleContent)
                <StilNavLink Href="" Match="NavLinkMatch.All" Icon="@StilIcons.Home">@L["Nav.Home"]</StilNavLink>
                ##endif*@
                @*#if (IsAdmin)
                <StilNavLink Href="" Match="NavLinkMatch.All" Icon="@StilIcons.Home">@L["Nav.Orders"]</StilNavLink>
                <StilNavLink Href="orders/new" Icon="@StilIcons.Plus">@L["Nav.NewOrder"]</StilNavLink>
                <StilNavLink Href="history">@L["Nav.History"]</StilNavLink>
                ##endif*@
                @*#if (IsDashboard)
                <StilNavLink Href="" Match="NavLinkMatch.All" Icon="@StilIcons.Home">@L["Nav.Overview"]</StilNavLink>
                <StilNavLink Href="products">@L["Nav.Products"]</StilNavLink>
                ##endif*@
                @*#if (IsMonitoring)
                <StilNavLink Href="" Match="NavLinkMatch.All" Icon="@StilIcons.Home">@L["Nav.Overview"]</StilNavLink>
                <StilNavLink Href="events">@L["Nav.Events"]</StilNavLink>
                ##endif*@
                @*#if (IsFinance)
                <StilNavLink Href="" Match="NavLinkMatch.All" Icon="@StilIcons.Home">@L["Nav.Overview"]</StilNavLink>
                <StilNavLink Href="transactions">@L["Nav.Transactions"]</StilNavLink>
                ##endif*@
                @*#if (IsPlanner)
                <StilNavLink Href="" Match="NavLinkMatch.All" Icon="@StilIcons.Home">@L["Nav.Overview"]</StilNavLink>
                <StilNavLink Href="planner">@L["Nav.Planner"]</StilNavLink>
                <StilNavLink Href="bookings">@L["Nav.Bookings"]</StilNavLink>
                <StilNavLink Href="board">@L["Nav.Board"]</StilNavLink>
                <StilNavLink Href="project">@L["Nav.Project"]</StilNavLink>
                ##endif*@
                @*#if (HasFeatureMenu)
                @* The example page of each feature chosen with --Features. *@
                <StilDropdown Text="@L["Nav.Features"]" Variant="StilVariant.Secondary" Appearance="StilButtonAppearance.Ghost">
                ##endif*@
                @*#if (HasCharts)
                    <StilDropdownItem Href="charts">@L["Nav.Charts"]</StilDropdownItem>
                ##endif*@
                @*#if (HasDataGrid)
                    <StilDropdownItem Href="sales">@L["Nav.Sales"]</StilDropdownItem>
                ##endif*@
                @*#if (HasCalendar && !IsPlanner)
                    <StilDropdownItem Href="planner">@L["Nav.Planner"]</StilDropdownItem>
                ##endif*@
                @*#if (HasSchedule && !IsPlanner)
                    <StilDropdownItem Href="bookings">@L["Nav.Bookings"]</StilDropdownItem>
                ##endif*@
                @*#if (HasKanban && !IsPlanner)
                    <StilDropdownItem Href="board">@L["Nav.Board"]</StilDropdownItem>
                ##endif*@
                @*#if (HasGantt && !IsPlanner)
                    <StilDropdownItem Href="project">@L["Nav.Project"]</StilDropdownItem>
                ##endif*@
                @*#if (HasMarkdown)
                    <StilDropdownItem Href="notes">@L["Nav.Notes"]</StilDropdownItem>
                ##endif*@
                @*#if (HasRichText)
                    <StilDropdownItem Href="product-text">@L["Nav.ProductText"]</StilDropdownItem>
                ##endif*@
                @*#if (HasChat)
                    <StilDropdownItem Href="chat">@L["Nav.Chat"]</StilDropdownItem>
                ##endif*@
                @*#if (HasActivity)
                    <StilDropdownItem Href="activity">@L["Nav.Activity"]</StilDropdownItem>
                ##endif*@
                @*#if (HasScanner)
                    <StilDropdownItem Href="scan">@L["Nav.Scan"]</StilDropdownItem>
                ##endif*@
                @*#if (HasSignature)
                    <StilDropdownItem Href="sign">@L["Nav.Sign"]</StilDropdownItem>
                ##endif*@
                @*#if (HasNotifications)
                    <StilDropdownItem Href="notifications">@L["Nav.Notifications"]</StilDropdownItem>
                ##endif*@
                @*#if (HasFeatureMenu)
                </StilDropdown>
                ##endif*@
            </StilNav>
        </ChildContent>
        <End>
            @*#if (HasCommands && UseServer)
            <AppCommands />
            ##endif*@
            @*#if (HasCommands && !UseServer)
            <AppCommands @rendermode="InteractiveServer" />
            ##endif*@
            @*#if (HasNotificationBell && UseServer)
            <StilNotificationCenter />
            ##endif*@
            @*#if (HasNotificationBell && !UseServer)
            <StilNotificationCenter @rendermode="InteractiveServer" />
            ##endif*@
            <StilLanguageSelector Cultures="AppCultures.All" Size="StilSize.Small" AlignEnd />
            @*#if (UseServer)
            <StilSelect @bind-Value="_mode" Size="StilSize.Small" aria-label="@L["ColorMode"]" />
            ##else
            @* The app has no interactivity, so the switch is a form. The choice is kept in a cookie. *@
            <form method="post" @formname="color-mode" @onsubmit="SaveColorMode" data-enhance>
                <AntiforgeryToken />
                <StilButtonGroup Label="@L["ColorMode"]">
                    @foreach (var mode in Enum.GetValues<StilThemeMode>())
                    {
                        <StilButton Type="submit" name="ColorMode" value="@mode" Size="StilSize.Small"
                                    Variant="StilVariant.Secondary" Appearance="StilButtonAppearance.Outline"
                                    Pressed="@(mode == _mode)">@mode</StilButton>
                    }
                </StilButtonGroup>
            </form>
            ##endif*@
        </End>
    </StilNavbar>

    <main class="stil-container stil-py-5">
        @Body
    </main>
    @*#if (UseServer)

    @* The hosts for IStilDialogService and IStilToastService. Inside the theme provider, dialogs
       and toasts follow the color mode. *@
    <StilDialogHost />
    <StilToastHost />

    <div id="blazor-error-ui" class="stil-alert stil-alert-danger" data-nosnippet>
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss">🗙</span>
    </div>
    ##endif*@
    @*#if ((HasNotificationBell || IsFinance) && !UseServer)

    @* Shows the toasts of the interactive pages. *@
    <StilToastHost @rendermode="InteractiveServer" />
    ##endif*@
</StilThemeProvider>
@*#if (UseServer)

@code {
    private StilThemeMode _mode = StilThemeMode.Auto;
}
##else

@code {
    private const string ColorModeCookie = "color-mode";

    private StilThemeMode _mode = StilThemeMode.Auto;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = "color-mode")]
    private StilThemeMode? ColorMode { get; set; }

    protected override void OnInitialized()
    {
        if (Enum.TryParse<StilThemeMode>(HttpContext?.Request.Cookies[ColorModeCookie], out var saved) && Enum.IsDefined(saved))
        {
            _mode = saved;
        }
    }

    private void SaveColorMode()
    {
        if (ColorMode is not { } mode || !Enum.IsDefined(mode))
        {
            return;
        }

        _mode = mode;
        HttpContext?.Response.Cookies.Append(ColorModeCookie, mode.ToString(),
            new() { MaxAge = TimeSpan.FromDays(365), IsEssential = true, HttpOnly = true });
    }
}
##endif*@
