@page "/blog/{Slug}"
@inject IBlogService Posts
@inject NavigationManager Navigation

@if (_post is { } post)
{
    @* An article for link previews and search engines: its dates, author and picture. *@
    <StilSeo Title="@post.Title" SiteName="@SiteInfo.Name" Description="@post.Excerpt" Type="StilSeoType.Article"
             Published="post.Date" Author="@post.Author" Image="@post.Image" ImageAlt="@post.Title"
             StructuredData="@([StilStructuredData.Article(post.Title, Navigation.ToAbsoluteUri($"blog/{post.Slug}").AbsoluteUri,
                 published: post.Date, author: post.Author, description: post.Excerpt, publisher: SiteInfo.Name,
                 image: post.Image is null ? null : Navigation.ToAbsoluteUri(post.Image).AbsoluteUri)])" />

    <StilSection>
        <StilArticle Eyebrow="Blog" EyebrowHref="blog" Title="@post.Title" Lead="@post.Excerpt"
                     Author="@post.Author" Date="post.Date" ReadingTime="@post.ReadingTime"
                     Image="@post.Image" Tags="@post.Tags.Select(tag => new StilLinkItem(tag))"
                     Contents="@post.Sections.Select(section => new StilLinkItem(section.Heading, $"blog/{post.Slug}#{section.Id}"))">
            <ChildContent>
                <p>@post.Intro</p>
                @foreach (var section in post.Sections)
                {
                    <h2 id="@section.Id">@section.Heading</h2>
                    @foreach (var paragraph in section.Paragraphs)
                    {
                        <p>@paragraph</p>
                    }
                }
            </ChildContent>
            <Footer>
                <a href="blog">All posts</a>
            </Footer>
        </StilArticle>
    </StilSection>

    @if (Related.Any())
    {
        <StilSection Title="Read next" Tone="StilBlockTone.Muted">
            <StilPostList>
                @foreach (var related in Related)
                {
                    <StilPostCard Href="@($"blog/{related.Slug}")" Title="@related.Title" Image="@related.Image"
                                  Author="@related.Author" Date="related.Date" HeadingLevel="3" />
                }
            </StilPostList>
        </StilSection>
    }
}

@code {
    private BlogPost? _post;

    [Parameter]
    public string Slug { get; set; } = "";

    // Up to two other posts, those that share a tag first.
    private IEnumerable<BlogPost> Related => Posts.All()
        .Where(other => other != _post)
        .OrderByDescending(other => other.Tags.Intersect(_post!.Tags).Count())
        .Take(2);

    protected override void OnParametersSet()
    {
        _post = Posts.Find(Slug);
        if (_post is null)
        {
            // Shows the not-found page, with status 404.
            Navigation.NotFound();
        }
    }
}
