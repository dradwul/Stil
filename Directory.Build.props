<Project>

  <!--
    Shared settings for every project: the version and the package metadata. Nothing is
    published; the metadata only describes the packages that dotnet pack builds.
  -->
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>Ludvig Andersson</Authors>
    <Copyright>Copyright (c) Ludvig Andersson</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/dradwul/Stil</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dradwul/Stil</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <!-- Source Link (built into the .NET SDK), symbols and reproducible builds. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)assets/icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
