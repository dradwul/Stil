<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Stil.Charts</PackageId>
    <AssemblyName>Stil.Charts</AssemblyName>
    <RootNamespace>Stil.Charts</RootNamespace>
    <Description>Themeable SVG charts for Stil for Blazor: line, area, bar, donut and sparkline charts that render on the server, work in static SSR and follow the Stil tokens and dark mode.</Description>
    <PackageTags>blazor;charts;svg;theme;dark-mode;accessibility;stil</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- XML docs for IntelliSense and the API tables on the docs site. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <InternalsVisibleTo Include="Stil.Charts.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stil.Blazor\Stil.Blazor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
