@inherits StilComponentBase

@* A column of links in a StilFooter, under a title. *@
<div @attributes="AdditionalAttributes" class="@Classes("stil-footer-column")">
    <StilHeading Level="HeadingLevel" class="stil-footer-title">@Title</StilHeading>
    <ul class="stil-footer-links">
        @if (Links is not null)
        {
            @foreach (var link in Links)
            {
                <li><a href="@link.Href">@link.Text</a></li>
            }
        }
        @ChildContent
    </ul>
</div>

@code {
    /// <summary>The column's title, such as "Product".</summary>
    [Parameter, EditorRequired]
    public string? Title { get; set; }

    /// <summary>The links.</summary>
    [Parameter]
    public IEnumerable<StilLinkItem>? Links { get; set; }

    /// <summary>More list items (li) after the links.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>The heading level of the title, 1 to 6. The default is 2.</summary>
    [Parameter]
    public int HeadingLevel { get; set; } = 2;
}
