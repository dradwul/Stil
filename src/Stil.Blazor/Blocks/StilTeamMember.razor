@inherits StilComponentBase

@* One person in a StilTeam: a photo (or their initials), name, role, a line about them and links. *@
<li @attributes="AdditionalAttributes" class="@Classes("stil-team-member")">
    @if (!string.IsNullOrWhiteSpace(Photo))
    {
        <img class="stil-team-photo" src="@Photo" alt="" loading="lazy" />
    }
    else
    {
        <span class="stil-avatar stil-team-photo" aria-hidden="true">@StilAvatar.InitialsOf(Name)</span>
    }
    <StilHeading Level="HeadingLevel" class="stil-team-name">@Name</StilHeading>
    @if (!string.IsNullOrWhiteSpace(Role))
    {
        <p class="stil-team-role">@Role</p>
    }
    @if (!string.IsNullOrWhiteSpace(Text))
    {
        <p class="stil-team-bio">@Text</p>
    }
    @ChildContent
    @if (Links?.Any() == true)
    {
        <ul class="stil-team-links">
            @foreach (var link in Links)
            {
                <li><a href="@link.Href">@link.Text</a></li>
            }
        </ul>
    }
</li>

@code {
    /// <summary>The person's name.</summary>
    [Parameter, EditorRequired]
    public string? Name { get; set; }

    /// <summary>Their role, such as "Founder".</summary>
    [Parameter]
    public string? Role { get; set; }

    /// <summary>A line about them.</summary>
    [Parameter]
    public string? Text { get; set; }

    /// <summary>A photo. It is decorative, since the name follows it. Without it, their initials are shown.</summary>
    [Parameter]
    public string? Photo { get; set; }

    /// <summary>Links, such as a profile or an e-mail address.</summary>
    [Parameter]
    public IEnumerable<StilLinkItem>? Links { get; set; }

    /// <summary>The heading level of the name, 1 to 6. The default is 3.</summary>
    [Parameter]
    public int HeadingLevel { get; set; } = 3;

    /// <summary>More content under the text.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
