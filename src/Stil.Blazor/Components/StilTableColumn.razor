@typeparam TItem
@implements IDisposable

@code {
    [CascadingParameter]
    private StilTable<TItem>? Table { get; set; }

    /// <summary>The header text.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>The value shown in the cell, for example <c>o =&gt; o.Customer</c>.</summary>
    [Parameter]
    public Func<TItem, object?>? Value { get; set; }

    /// <summary>A format string for the values, for example "N2" or "d MMM yyyy".</summary>
    [Parameter]
    public string? Format { get; set; }

    /// <summary>Custom cell content instead of Value, for example a badge or buttons.</summary>
    [Parameter]
    public RenderFragment<TItem>? Template { get; set; }

    /// <summary>Text alignment of the header and cells. End suits numbers.</summary>
    [Parameter]
    public StilTextAlign Align { get; set; }

    /// <summary>Extra classes on every cell in the column.</summary>
    [Parameter]
    public string? Class { get; set; }

    internal string? AlignClass => Align switch
    {
        StilTextAlign.Center => "stil-text-center",
        StilTextAlign.End => "stil-text-end",
        _ => null
    };

    internal string? CellClass => string.Join(' ', new[] { AlignClass, Class }.Where(c => !string.IsNullOrWhiteSpace(c))) is { Length: > 0 } css ? css : null;

    internal RenderFragment RenderCell(TItem item) => Template is not null
        ? Template(item)
        : builder => builder.AddContent(0, FormatValue(Value?.Invoke(item)));

    private string? FormatValue(object? value) =>
        value is IFormattable formattable && Format is not null
            ? formattable.ToString(Format, System.Globalization.CultureInfo.CurrentCulture)
            : value?.ToString();

    protected override void OnInitialized()
    {
        if (Table is null)
        {
            throw new InvalidOperationException($"StilTableColumn must be placed in the Columns of a StilTable.");
        }

        Table.AddColumn(this);
    }

    public void Dispose() => Table?.RemoveColumn(this);
}
