@inherits StilComponentBase

@if (Href is not null)
{
    <a href="@(Disabled ? null : Href)" aria-disabled="@StilCssClasses.AriaBool(Disabled)"
       @attributes="AdditionalAttributes" class="@Classes("stil-dropdown-item")">@ChildContent</a>
}
else
{
    <button type="button" disabled="@Disabled" @attributes="AdditionalAttributes"
            class="@Classes("stil-dropdown-item")" @onclick="OnClick">@ChildContent</button>
}

@code {
    /// <summary>Makes the item a link. Otherwise it is a button that raises OnClick.</summary>
    [Parameter]
    public string? Href { get; set; }

    /// <summary>Raised when the item is chosen. Not used with Href.</summary>
    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>The item cannot be chosen.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>The item text.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
