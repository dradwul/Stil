@inherits StilComponentBase

<div @attributes="AdditionalAttributes" class="@Classes("stil-grid", StilCssClasses.Gap(Gap))">
    @ChildContent
</div>

@code {
    /// <summary>The gap between cells, as a spacing step from 0 to 7. The default is 4 (1rem).</summary>
    [Parameter]
    public int? Gap { get; set; }

    /// <summary>StilCol components (or any elements; they span the full row by default).</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
