@inherits StilComponentBase

<nav aria-label="@Label" @attributes="AdditionalAttributes" class="@Classes()">
    <ol class="stil-breadcrumb">
        @if (Items is not null)
        {
            var items = Items.ToList();
            @for (var i = 0; i < items.Count; i++)
            {
                var item = items[i];
                <StilBreadcrumbItem Text="@item.Text" Href="@item.Href" Current="@(i == items.Count - 1)" />
            }
        }
        @ChildContent
    </ol>
</nav>

@code {
    /// <summary>The trail, from the top level to the current page. The last item is the current page.</summary>
    [Parameter]
    public IEnumerable<StilLinkItem>? Items { get; set; }

    /// <summary>StilBreadcrumbItem components, as an alternative to Items. Mark the last one Current.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>The accessible name of the navigation landmark.</summary>
    [Parameter]
    public string Label { get; set; } = "Breadcrumb";
}
