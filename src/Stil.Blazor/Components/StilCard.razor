@inherits StilComponentBase

<div @attributes="AdditionalAttributes" class="@Classes("stil-card")">
    @if (HeaderActions is not null)
    {
        <div class="stil-card-header">
            <div>
                @TitleMarkup
            </div>
            <div class="stil-cluster">@HeaderActions</div>
        </div>
    }
    else
    {
        @TitleMarkup
    }

    @ChildContent

    @if (Footer is not null)
    {
        <div class="stil-card-footer">@Footer</div>
    }
</div>

@code {
    /// <summary>The card title, rendered as a heading.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>Muted text under the title.</summary>
    [Parameter]
    public string? Subtitle { get; set; }

    /// <summary>The heading level of the title, 1 to 6. The default is 2.</summary>
    [Parameter]
    public int HeadingLevel { get; set; } = 2;

    /// <summary>Buttons or other controls. When set, the title moves into a header bar.</summary>
    [Parameter]
    public RenderFragment? HeaderActions { get; set; }

    /// <summary>Actions in a footer bar, aligned to the end.</summary>
    [Parameter]
    public RenderFragment? Footer { get; set; }

    /// <summary>The card body.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private RenderFragment TitleMarkup => @<text>
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <StilHeading Level="HeadingLevel" class="stil-card-title">@Title</StilHeading>
        }
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <p class="stil-card-subtitle">@Subtitle</p>
        }
    </text>;
}
