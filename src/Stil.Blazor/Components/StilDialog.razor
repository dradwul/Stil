@inherits StilComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS

@* A native modal <dialog>: focus is trapped, Escape closes it and the page behind is inert.
   Opening and closing needs an interactive render mode. *@
<dialog @ref="_element" @attributes="AdditionalAttributes" class="@CssClass" aria-labelledby="@TitleId">
    @if (Open)
    {
        <div class="stil-dialog-header">
            <h2 class="stil-dialog-title" id="@TitleId">@Title</h2>
            @if (ShowClose)
            {
                <button type="button" class="stil-close" aria-label="@CloseLabel" @onclick="CloseAsync"></button>
            }
        </div>
        <div class="stil-dialog-body">
            @ChildContent
        </div>
        @if (Footer is not null)
        {
            <div class="stil-dialog-footer">@Footer</div>
        }
    }
</dialog>

@code {
    private ElementReference _element;
    private IJSObjectReference? _module;
    private DotNetObjectReference<StilDialog>? _self;
    private bool _shown;
    private readonly string _titleId = StilIds.Next("dialog-title");

    /// <summary>Whether the dialog is open. Supports two-way binding (@bind-Open).</summary>
    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public string? Title { get; set; }

    /// <summary>Small, Medium (default) or Large.</summary>
    [Parameter]
    public StilSize Size { get; set; }

    [Parameter]
    public bool ShowClose { get; set; } = true;

    [Parameter]
    public string CloseLabel { get; set; } = "Close";

    /// <summary>Raised after the dialog closes, whatever closed it (button, Escape or code).</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>Actions in the footer, aligned to the end.</summary>
    [Parameter]
    public RenderFragment? Footer { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string TitleId => _titleId;

    private string CssClass => Classes("stil-dialog", StilCssClasses.Size("stil-dialog", Size));

    /// <summary>Closes the dialog and updates the bound Open value.</summary>
    public async Task CloseAsync()
    {
        if (!Open)
        {
            return;
        }

        Open = false;
        await OpenChanged.InvokeAsync(false);
        await OnClose.InvokeAsync();
        StateHasChanged();
    }

    /// <summary>Called by stil.js when the browser closes the dialog, for example on Escape.</summary>
    [JSInvokable]
    public async Task OnDialogClosed()
    {
        _shown = false;
        await CloseAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open == _shown)
        {
            return;
        }

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Stil/stil.js");
        if (Open)
        {
            _self ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("showDialog", _element, _self);
        }
        else
        {
            await _module.InvokeVoidAsync("closeDialog", _element);
        }

        _shown = Open;
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone; there is nothing to clean up in the browser.
            }
        }

        _self?.Dispose();
    }
}
