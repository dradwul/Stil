@inherits StilModalBase<StilDialog>

@* A native modal <dialog>: focus is trapped, Escape closes it and the page behind is inert.
   Opening and closing needs an interactive render mode. *@
<dialog @ref="Element" @attributes="AdditionalAttributes" class="@CssClass" aria-labelledby="@TitleId">
    @if (Open)
    {
        <div class="stil-dialog-header">
            <h2 class="stil-dialog-title" id="@TitleId">@Title</h2>
            @if (ShowClose)
            {
                <button type="button" class="stil-close" aria-label="@CloseLabel" @onclick="CloseAsync"></button>
            }
        </div>
        <div class="stil-dialog-body">
            @ChildContent
        </div>
        @if (Footer is not null)
        {
            <div class="stil-dialog-footer">@Footer</div>
        }
    }
</dialog>

@code {
    /// <summary>Small, Medium (default) or Large.</summary>
    [Parameter]
    public StilSize Size { get; set; }

    private string CssClass => Classes("stil-dialog", StilCssClasses.Size("stil-dialog", Size));
}
