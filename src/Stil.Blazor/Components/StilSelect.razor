@typeparam TValue
@inherits StilInputBase<TValue>

<StilField Label="@Label" Hint="@Hint" InputId="@InputId" Messages="@Messages" Class="@FieldClass" Style="@FieldStyle">
    <InputSelect TValue="TValue" Value="@Value" ValueChanged="@ValueChanged" ValueExpression="@ValueExpression"
                 @attributes="ControlAttributes(StilCss)">
        @if (Placeholder is not null)
        {
            <option value="">@Placeholder</option>
        }
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            @foreach (var item in OptionItems)
            {
                <option value="@FormatValue(item)">@Text(item)</option>
            }
        }
    </InputSelect>
</StilField>

@code {
    /// <summary>
    /// The options. When neither Items nor ChildContent is set and the value is an enum, every
    /// enum value becomes an option.
    /// </summary>
    [Parameter]
    public IEnumerable<TValue>? Items { get; set; }

    /// <summary>The option text for an item. The default is the item's ToString().</summary>
    [Parameter]
    public Func<TValue, string>? ItemText { get; set; }

    /// <summary>A first option with an empty value, for example "Choose…".</summary>
    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public StilSize Size { get; set; }

    /// <summary>Custom &lt;option&gt; elements instead of Items.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string StilCss => $"stil-select {StilCssClasses.Size("stil-select", Size)}".TrimEnd();

    private IEnumerable<TValue> OptionItems
    {
        get
        {
            if (Items is not null)
            {
                return Items;
            }

            var enumType = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);
            return enumType.IsEnum ? Enum.GetValues(enumType).Cast<TValue>() : [];
        }
    }

    private string Text(TValue item) => ItemText is not null ? ItemText(item) : item?.ToString() ?? "";

    // Must match InputSelect.FormatValueAsString, so the bound value selects the right option:
    // bools are "true"/"false" and everything else uses ToString() in the current culture.
    private static string? FormatValue(TValue item) => item switch
    {
        null => null,
        bool b => b ? "true" : "false",
        _ => item.ToString()
    };
}
