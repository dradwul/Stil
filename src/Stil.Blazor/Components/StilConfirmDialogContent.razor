@inject IServiceProvider StilServices
@* Used by IStilDialogService.ConfirmAsync; not for use on its own. *@
@attribute [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
@* The body and buttons of IStilDialogService.ConfirmAsync. *@
<p>@Message</p>
<div class="stil-cluster stil-justify-content-end stil-mt-4">
    <StilButton Variant="StilVariant.Secondary" Appearance="StilButtonAppearance.Ghost" OnClick="() => Dialog?.Close(false)" autofocus="@IsDestructive">@Localize(Options.CancelText, "Dialog.Cancel")</StilButton>
    <StilButton Variant="Options.ConfirmVariant" OnClick="() => Dialog?.Close(true)" autofocus="@(!IsDestructive)">@Localize(Options.ConfirmText, "Dialog.Confirm")</StilButton>
</div>

@code {
    [CascadingParameter]
    private StilDialogReference? Dialog { get; set; }

    /// <summary>The message above the buttons.</summary>
    [Parameter]
    public string Message { get; set; } = "";

    /// <summary>The button texts and the color of the confirm button.</summary>
    [Parameter]
    public StilConfirmOptions Options { get; set; } = new();

    // For destructive actions, focus starts on Cancel so Enter does not confirm by accident.
    private bool IsDestructive => Options.ConfirmVariant == StilVariant.Danger;

    private string Localize(string? text, string key) =>
        text ?? StilLocalizer.Get(StilLocalizer.From(StilServices), key, System.Globalization.CultureInfo.CurrentUICulture);
}
