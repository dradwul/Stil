@inherits StilComponentBase

@* A <details> dropdown: it opens without JavaScript, and stil.js (loaded automatically by
   Stil for Blazor) closes it on an outside click, on Escape and after choosing an item, and
   moves between items with the arrow keys. *@
<details @attributes="DetailsAttributes" class="@Classes("stil-dropdown")" open="@(Open && !Disabled)">
    <summary class="@SummaryClass" aria-label="@AriaLabel"
             aria-disabled="@StilCssClasses.AriaBool(Disabled)" tabindex="@(Disabled ? -1 : (int?)null)">
        @if (Toggle is not null)
        {
            @Toggle
        }
        else
        {
            @Text
        }
    </summary>
    <div class="@MenuClass">
        @if (Items is not null)
        {
            @foreach (var item in Items)
            {
                if (item.IsDivider)
                {
                    <StilDropdownDivider />
                }
                else if (item.IsHeader)
                {
                    <StilDropdownHeader>@item.Text</StilDropdownHeader>
                }
                else if (item.Href is not null)
                {
                    <StilDropdownItem Href="@item.Href" Disabled="item.Disabled">@item.Text</StilDropdownItem>
                }
                else
                {
                    <StilDropdownItem Disabled="item.Disabled" OnClick="() => item.OnClick?.Invoke() ?? Task.CompletedTask">@item.Text</StilDropdownItem>
                }
            }
        }
        @ChildContent
    </div>
</details>

@code {
    /// <summary>The text on the toggle button.</summary>
    [Parameter]
    public string? Text { get; set; }

    /// <summary>Rich toggle content instead of Text, for example an icon.</summary>
    [Parameter]
    public RenderFragment? Toggle { get; set; }

    /// <summary>The accessible name of the toggle when it only shows an icon.</summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public StilVariant Variant { get; set; } = StilVariant.Primary;

    [Parameter]
    public StilButtonAppearance Appearance { get; set; }

    [Parameter]
    public StilSize Size { get; set; }

    /// <summary>A square icon-only toggle without the arrow.</summary>
    [Parameter]
    public bool IconOnly { get; set; }

    /// <summary>Align the menu with the end of the toggle instead of the start.</summary>
    [Parameter]
    public bool AlignEnd { get; set; }

    /// <summary>Open the menu above the toggle, for toggles near the bottom of the screen.</summary>
    [Parameter]
    public bool DropUp { get; set; }

    /// <summary>The toggle cannot be used and the menu stays closed.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Whether the menu is open. Supports two-way binding (@bind-Open).</summary>
    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>The menu as data, as an alternative to child components. See StilMenuItem.</summary>
    [Parameter]
    public IEnumerable<StilMenuItem>? Items { get; set; }

    /// <summary>StilDropdownItem, StilDropdownHeader and StilDropdownDivider components.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string MenuClass => string.Join(' ', new[]
    {
        "stil-dropdown-menu",
        AlignEnd ? "stil-dropdown-menu-end" : null,
        DropUp ? "stil-dropdown-menu-up" : null,
    }.Where(c => c is not null));

    private string SummaryClass => string.Join(' ', new[]
    {
        "stil-btn",
        StilCssClasses.Variant("stil-btn", Variant),
        Appearance switch
        {
            StilButtonAppearance.Outline => "stil-btn-outline",
            StilButtonAppearance.Ghost => "stil-btn-ghost",
            _ => null
        },
        StilCssClasses.Size("stil-btn", Size),
        IconOnly ? "stil-btn-icon" : null,
    }.Where(c => c is not null));

    // The consumer's attributes plus the stiltoggle handler. Razor cannot bind @onstiltoggle inside
    // the assembly that declares it, so the handler is added as an attribute.
    private IReadOnlyDictionary<string, object> DetailsAttributes
    {
        get
        {
            var attributes = AdditionalAttributes is null
                ? new Dictionary<string, object>()
                : new Dictionary<string, object>(AdditionalAttributes);
            attributes["onstiltoggle"] = EventCallback.Factory.Create<StilToggleEventArgs>(this, OnToggleAsync);
            return attributes;
        }
    }

    private async Task OnToggleAsync(StilToggleEventArgs e)
    {
        if (e.Open == Open)
        {
            return;
        }

        Open = e.Open;
        await OpenChanged.InvokeAsync(e.Open);
    }
}
