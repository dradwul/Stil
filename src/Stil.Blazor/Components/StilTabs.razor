@inherits StilComponentBase

<CascadingValue Value="this" IsFixed="true">
    <div @attributes="AdditionalAttributes" class="@Classes()">
        <div role="tablist" aria-label="@Label" class="@(Appearance == StilTabsAppearance.Pills ? "stil-tabs stil-tabs-pills" : "stil-tabs")">
            @for (var i = 0; i < _tabs.Count; i++)
            {
                var index = i;
                var tab = _tabs[index];
                var selected = index == SelectedIndex;
                <button type="button" role="tab" class="stil-tab" id="@TabId(index)"
                        aria-selected="@(selected ? "true" : "false")" aria-controls="@PanelId(index)"
                        tabindex="@(selected ? 0 : -1)" disabled="@tab.Disabled"
                        @ref="tab.Element" @onclick="() => SelectAsync(index)" @onkeydown="e => OnKeyDownAsync(e, index)">
                    @tab.Title
                </button>
            }
        </div>
        @ChildContent
    </div>
</CascadingValue>

@code {
    private readonly List<StilTab> _tabs = [];
    private readonly List<StilTab> _renderOrder = [];
    private readonly string _id = StilIds.Next("tabs");
    private bool _focusSelected;

    /// <summary>The index of the selected tab. Supports two-way binding.</summary>
    [Parameter]
    public int ActiveIndex { get; set; }

    /// <summary>Raised when another tab is selected.</summary>
    [Parameter]
    public EventCallback<int> ActiveIndexChanged { get; set; }

    /// <summary>
    /// The Id of the selected tab, as an alternative to ActiveIndex that does not change when tabs
    /// are added or removed. Supports two-way binding (@bind-ActiveId). Set Id on each StilTab.
    /// </summary>
    [Parameter]
    public string? ActiveId { get; set; }

    /// <summary>Raised with the Id of the tab when another tab is selected.</summary>
    [Parameter]
    public EventCallback<string?> ActiveIdChanged { get; set; }

    /// <summary>Underline (default) or Pills.</summary>
    [Parameter]
    public StilTabsAppearance Appearance { get; set; }

    /// <summary>
    /// Keep every panel's content rendered (hidden when not selected) instead of only the
    /// selected one, so state such as form input survives switching tabs.
    /// </summary>
    [Parameter]
    public bool KeepAlive { get; set; }

    /// <summary>The accessible name of the tab list.</summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>The StilTab components.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    internal string TabId(int index) => $"{_id}-tab-{index}";

    internal string PanelId(int index) => $"{_id}-panel-{index}";

    internal int IndexOf(StilTab tab) => _tabs.IndexOf(tab);

    internal bool IsActive(StilTab tab) => IndexOf(tab) == SelectedIndex;

    // ActiveId wins when it matches a tab; otherwise ActiveIndex decides.
    private int SelectedIndex =>
        ActiveId is not null && _tabs.FindIndex(t => t.Id == ActiveId) is var byId and >= 0 ? byId : ActiveIndex;

    internal void Register(StilTab tab)
    {
        if (!_tabs.Contains(tab))
        {
            _tabs.Add(tab);
            StateHasChanged();
        }
    }

    internal void Unregister(StilTab tab)
    {
        if (_tabs.Remove(tab))
        {
            StateHasChanged();
        }
    }

    internal void TabChanged() => StateHasChanged();

    // Called by each tab as it renders. When every tab has rendered in one pass, their order is
    // the markup order; a tab that appeared later in the middle is moved to its place.
    internal void Touch(StilTab tab)
    {
        if (!_renderOrder.Contains(tab))
        {
            _renderOrder.Add(tab);
        }
    }

    private async Task SelectAsync(int index)
    {
        if (index == SelectedIndex || _tabs[index].Disabled)
        {
            return;
        }

        ActiveIndex = index;
        ActiveId = _tabs[index].Id;
        await ActiveIndexChanged.InvokeAsync(index);
        await ActiveIdChanged.InvokeAsync(ActiveId);
    }

    // Arrow keys, Home and End move between tabs and select them (WAI-ARIA tabs pattern).
    private async Task OnKeyDownAsync(KeyboardEventArgs e, int index)
    {
        var enabled = Enumerable.Range(0, _tabs.Count).Where(i => !_tabs[i].Disabled).ToList();
        if (enabled.Count == 0)
        {
            return;
        }

        var position = enabled.IndexOf(index);
        int? target = e.Key switch
        {
            "ArrowRight" => enabled[(position + 1) % enabled.Count],
            "ArrowLeft" => enabled[(position - 1 + enabled.Count) % enabled.Count],
            "Home" => enabled[0],
            "End" => enabled[^1],
            _ => null
        };

        if (target is { } next)
        {
            _focusSelected = true;
            await SelectAsync(next);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var reorder = _renderOrder.Count == _tabs.Count && !_renderOrder.SequenceEqual(_tabs);
        if (reorder)
        {
            _tabs.Clear();
            _tabs.AddRange(_renderOrder);
        }

        _renderOrder.Clear();
        if (reorder)
        {
            StateHasChanged();
            return;
        }

        if (_focusSelected && SelectedIndex >= 0 && SelectedIndex < _tabs.Count)
        {
            _focusSelected = false;
            await _tabs[SelectedIndex].Element.FocusAsync();
        }
    }
}
