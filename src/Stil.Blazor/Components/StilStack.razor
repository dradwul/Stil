@inherits StilComponentBase

<div @attributes="AdditionalAttributes" class="@Classes("stil-stack", StilCssClasses.Gap(Gap), StilCssClasses.Align(Align))">
    @ChildContent
</div>

@code {
    /// <summary>The gap between children, as a spacing step from 0 to 7. The default is 4 (1rem).</summary>
    [Parameter]
    public int? Gap { get; set; }

    /// <summary>How children align horizontally. By default they stretch to the full width.</summary>
    [Parameter]
    public StilAlign? Align { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
