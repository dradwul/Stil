@typeparam TItem
@attribute [CascadingTypeParameter(nameof(TItem))]
@using Microsoft.AspNetCore.Components.Web.Virtualization
@inherits StilComponentBase
@implements IDisposable
@inject IJSRuntime JS
@inject IServiceProvider Services

<CascadingValue Value="this" IsFixed="true">
    @Columns
</CascadingValue>

<div @attributes="RootAttributes" class="@Classes("stil-data-grid", IsTree ? "stil-tree-grid" : null)" aria-busy="@StilCssClasses.AriaBool(_loading)">
    @if (Toolbar is not null || ShowExport || ShowColumnChooser || (ShowGroupChooser && !IsTree) || Grouped)
    {
        <div class="stil-data-grid-toolbar">
            @Toolbar
            @if (ShowGroupChooser && !IsTree)
            {
                <StilPopover Text="@Localize(GroupByText, "DataGrid.GroupBy")" Title="@Localize(GroupByText, "DataGrid.GroupBy")" Size="StilSize.Small"
                             class="stil-data-grid-grouping">
                    <ul class="stil-data-grid-chooser">
                        @foreach (var choice in Ordered.Where(c => c.CanGroup))
                        {
                            var level = _groupBy.IndexOf(choice.ColumnKey);
                            <li>
                                <label class="stil-check">
                                    <input type="checkbox" class="stil-check-input" checked="@(level >= 0)" @onchange="() => ToggleGroupByAsync(choice)" />
                                    @choice.DisplayTitle
                                </label>
                                @if (level >= 0 && _groupBy.Count > 1)
                                {
                                    <span class="stil-text-muted stil-fs-sm">@(level + 1)</span>
                                }
                            </li>
                        }
                    </ul>
                </StilPopover>
            }
            @if (Grouped)
            {
                <StilButton Variant="StilVariant.Secondary" Appearance="StilButtonAppearance.Ghost" Size="StilSize.Small" OnClick="ExpandAllGroupsAsync">
                    @Localize(null, "DataGrid.ExpandAll")
                </StilButton>
                <StilButton Variant="StilVariant.Secondary" Appearance="StilButtonAppearance.Ghost" Size="StilSize.Small" OnClick="CollapseAllGroupsAsync">
                    @Localize(null, "DataGrid.CollapseAll")
                </StilButton>
            }
            @if (ShowColumnChooser)
            {
                <StilPopover Text="@Localize(ColumnsText, "DataGrid.Columns")" Title="@Localize(ColumnsText, "DataGrid.Columns")" Size="StilSize.Small"
                             class="stil-data-grid-columns">
                    <ul class="stil-data-grid-chooser">
                        @{ var ordered = Ordered.ToList(); }
                        @for (var i = 0; i < ordered.Count; i++)
                        {
                            var choice = ordered[i];
                            var index = i;
                            <li>
                                <label class="stil-check">
                                    <input type="checkbox" class="stil-check-input" checked="@(!_hidden.Contains(choice.ColumnKey))"
                                           disabled="@(!CanHide(choice))" @onchange="() => ToggleColumnAsync(choice)" />
                                    @choice.DisplayTitle
                                </label>
                                @if (IsReorderable(choice))
                                {
                                    <StilButton Variant="StilVariant.Secondary" Appearance="StilButtonAppearance.Ghost" Size="StilSize.Small" IconOnly
                                                Disabled="index == 0" OnClick="() => MoveColumnAsync(choice, -1)" aria-label="@MoveLabel(choice, earlier: true)">
                                        <StilIcon Name="@StilIcons.ChevronUp" />
                                    </StilButton>
                                    <StilButton Variant="StilVariant.Secondary" Appearance="StilButtonAppearance.Ghost" Size="StilSize.Small" IconOnly
                                                Disabled="index == ordered.Count - 1" OnClick="() => MoveColumnAsync(choice, 1)" aria-label="@MoveLabel(choice, earlier: false)">
                                        <StilIcon Name="@StilIcons.ChevronDown" />
                                    </StilButton>
                                }
                            </li>
                        }
                    </ul>
                    <StilButton Variant="StilVariant.Secondary" Appearance="StilButtonAppearance.Outline" Size="StilSize.Small" class="stil-mt-3"
                                OnClick="ResetLayoutAsync">@Localize(null, "DataGrid.ResetColumns")</StilButton>
                </StilPopover>
            }
            @if (ShowExport)
            {
                <StilButton Variant="StilVariant.Secondary" Appearance="StilButtonAppearance.Outline" Size="StilSize.Small"
                            class="stil-data-grid-export" Loading="_exporting" OnClick="DownloadCsvAsync">
                    <StilIcon Name="@StilIcons.Download" /> @Localize(ExportText, "DataGrid.Export")
                </StilButton>
            }
        </div>
    }

    <div class="@ScrollClass" style="@ScrollStyle" tabindex="@(Height is null ? null : 0)"
         role="@(Height is null ? null : "region")" aria-label="@(Height is null ? null : Caption ?? "Table")">
        <table class="@TableClass" role="@(IsTree ? "treegrid" : null)" @ref="_table">
            @if (!string.IsNullOrWhiteSpace(Caption))
            {
                <caption>@Caption</caption>
            }
            <thead>
                <tr>
                    @if (SelectionMode == StilSelectionMode.Multiple)
                    {
                        <th scope="col" class="stil-data-grid-select" data-stil-frozen="@SelectFrozen">
                            <input type="checkbox" class="stil-check-input" aria-label="@Localize(SelectAllLabel, "DataGrid.SelectAll")"
                                   checked="@AllOnPageSelected" disabled="@(_page.Count == 0)" @onchange="ToggleAllOnPageAsync" />
                        </th>
                    }
                    @foreach (var column in _visible)
                    {
                        <th @key="column.ColumnKey" scope="col" class="@column.AlignClass" style="@WidthOf(column)" aria-sort="@AriaSort(column)"
                            data-stil-column="@column.ColumnKey" data-stil-frozen="@column.FrozenValue"
                            data-stil-reorder="@(IsReorderable(column) ? "" : null)"
                            data-stil-min="@(IsResizable(column) ? column.MinWidth : null)" data-stil-max="@(IsResizable(column) ? column.MaxWidth : null)">
                            @if (column.CanSort)
                            {
                                <button type="button" class="stil-data-grid-sort" @onclick="() => SortAsync(column)">
                                    @column.DisplayTitle
                                    <StilIcon Name="@SortIcon(column)" />
                                </button>
                            }
                            else
                            {
                                @column.DisplayTitle
                            }
                            @if (IsResizable(column))
                            {
                                <span class="stil-data-grid-resize" role="separator" aria-orientation="vertical" tabindex="0" aria-label="@ResizeLabel(column)"></span>
                            }
                        </th>
                    }
                </tr>
                @if (_visible.Any(c => c.CanFilter))
                {
                    <tr class="stil-data-grid-filters">
                        @if (SelectionMode == StilSelectionMode.Multiple)
                        {
                            <td data-stil-frozen="@SelectFrozen"></td>
                        }
                        @foreach (var column in _visible)
                        {
                            <td data-stil-frozen="@column.FrozenValue">
                                @if (column.CanFilter)
                                {
                                    var label = string.Format(System.Globalization.CultureInfo.CurrentCulture, Localize(FilterLabelFormat, "DataGrid.FilterLabelFormat"), column.DisplayTitle);
                                    if (column.FilterOptions is { } options)
                                    {
                                        <select class="stil-select stil-select-sm" aria-label="@label" value="@FilterValue(column)"
                                                @onchange="e => FilterChangedAsync(column, e.Value?.ToString(), debounce: false)">
                                            <option value="">@Localize(AllOptionText, "DataGrid.All")</option>
                                            @foreach (var (value, text) in options)
                                            {
                                                <option value="@value">@text</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <input type="search" class="stil-input stil-input-sm" aria-label="@label" placeholder="@Localize(FilterPlaceholder, "DataGrid.Filter")"
                                               value="@FilterValue(column)" @oninput="e => FilterChangedAsync(column, e.Value?.ToString(), debounce: true)" />
                                    }
                                }
                            </td>
                        }
                    </tr>
                }
            </thead>
            <tbody>
                @if (_editing && _editIsNew)
                {
                    @EditRow(_editItem!, null)
                }
                @if (Virtualize)
                {
                    <Virtualize @ref="_virtualize" TItem="Entry" ItemsProvider="ProvideVirtualizedAsync" ItemSize="ItemSize"
                                SpacerElement="tr" OverscanCount="10" Context="entry">
                        <ItemContent>@EntryRow(entry)</ItemContent>
                        <EmptyContent>@MessageRow(EmptyContent, Localize(EmptyText, "DataGrid.Empty"))</EmptyContent>
                    </Virtualize>
                }
                else if (_entries.Count == 0 && !(_editing && _editIsNew))
                {
                    @(_loading ? LoadingRow : MessageRow(EmptyContent, Localize(EmptyText, "DataGrid.Empty")))
                }
                else
                {
                    @foreach (var entry in _entries)
                    {
                        @EntryRow(entry)
                    }
                }
            </tbody>
            @if (_visible.Any(c => c.HasAggregate))
            {
                <tfoot>
                    <tr class="stil-data-grid-totals">
                        @if (SelectionMode == StilSelectionMode.Multiple)
                        {
                            <td data-stil-frozen="@SelectFrozen"></td>
                        }
                        @for (var i = 0; i < _visible.Count; i++)
                        {
                            var column = _visible[i];
                            if (column.HasAggregate)
                            {
                                <td class="@column.CellClass" data-stil-frozen="@column.FrozenValue">@column.FormatTotal(IsTree ? TreeTotal(column, null) : _aggregates.GetValueOrDefault(column.ColumnKey))</td>
                            }
                            else if (i == 0)
                            {
                                <th scope="row" data-stil-frozen="@column.FrozenValue">@Localize(TotalText, "DataGrid.Total")</th>
                            }
                            else
                            {
                                <td data-stil-frozen="@column.FrozenValue"></td>
                            }
                        }
                    </tr>
                </tfoot>
            }
        </table>
    </div>

    @if (Paged)
    {
        <div class="stil-data-grid-footer">
            <span class="stil-text-muted stil-fs-sm" aria-live="polite">@Summary</span>
            <div class="stil-cluster stil-gap-3">
                @if (PageSizeOptions is { Length: > 0 })
                {
                    <select class="stil-select stil-select-sm stil-w-auto" aria-label="@Localize(RowsPerPageLabel, "DataGrid.RowsPerPage")" value="@_pageSize"
                            @onchange="PageSizeChangedAsync">
                        @foreach (var size in PageSizeOptions)
                        {
                            <option value="@size">@size</option>
                        }
                    </select>
                }
                <StilPagination Page="_pageNumber" PageChanged="GoToPageAsync" TotalItems="_rowCount" PageSize="_pageSize"
                                Size="StilSize.Small" Label="@Localize(PaginationLabel, "DataGrid.Pages")" />
            </div>
        </div>
    }
</div>

@code {
    private readonly List<StilDataGridColumnBase<TItem>> _columns = [];
    private List<StilDataGridColumnBase<TItem>> _visible = [];
    private List<string> _order = [];
    private readonly Dictionary<string, string> _widths = [];
    private readonly HashSet<string> _hidden = [];
    private StilDataGridLayout? _appliedLayout;
    private string? _layoutSortKey;
    private ElementReference _table;
    private IJSObjectReference? _module;
    private readonly Dictionary<StilDataGridColumnBase<TItem>, string> _filters = [];
    private List<TItem> _page = [];
    private List<Entry> _entries = [];
    private Virtualize<Entry>? _virtualize;
    private List<string> _groupBy = [];
    private IReadOnlyList<string>? _appliedGroupBy;
    private readonly HashSet<string> _collapsed = [];
    private List<GroupRow> _groupRows = [];
    private int _groupLevels;
    private bool _groupsStale = true;
    private int _rowCount;
    private bool _editing;
    private bool _editIsNew;
    private TItem? _editItem;
    private StilDataGridColumnBase<TItem>? _editColumn;
    private EditContext? _editContext;
    private object? _editSnapshot;
    private bool _focusEditor;
    private readonly object _newRowKey = new();
    private StilDataGridColumnBase<TItem>? _sortColumn;
    private StilSortDirection _sortDirection;
    private int _pageNumber = 1;
    private int _pageSize;
    private int _total;
    private bool _loading;
    private bool _initialSortApplied;
    private bool _exporting;
    private bool _reloadQueued;
    private IReadOnlyDictionary<string, object?> _aggregates = new Dictionary<string, object?>();
    private CancellationTokenSource? _loadCts;
    private CancellationTokenSource? _debounceCts;
    private object? _loadedItems;
    private object? _loadedProvider;

    /// <summary>
    /// The rows, kept in memory. An IQueryable (for example an EF Core DbSet) is filtered, sorted
    /// and paged by the query provider. For asynchronous queries, use ItemsProvider instead.
    /// </summary>
    [Parameter]
    public IEnumerable<TItem>? Items { get; set; }

    /// <summary>Loads rows on demand (server-side paging, sorting and filtering). Takes precedence over Items.</summary>
    [Parameter]
    public Func<StilDataGridRequest<TItem>, Task<StilDataGridResult<TItem>>>? ItemsProvider { get; set; }

    /// <summary>StilDataGridColumn and StilDataGridTemplateColumn components.</summary>
    [Parameter]
    public RenderFragment? Columns { get; set; }

    /// <summary>Content above the table, for example a search box or buttons.</summary>
    [Parameter]
    public RenderFragment? Toolbar { get; set; }

    /// <summary>Lets the user resize every column by dragging the edge of its header or with the keyboard. A column can override it with Resizable.</summary>
    [Parameter]
    public bool ResizableColumns { get; set; }

    /// <summary>Lets the user move every column by dragging its header, or in the column chooser. A column can override it with Reorderable.</summary>
    [Parameter]
    public bool ReorderableColumns { get; set; }

    /// <summary>Shows a Columns button in the toolbar that hides, shows and moves columns.</summary>
    [Parameter]
    public bool ShowColumnChooser { get; set; }

    /// <summary>
    /// The column layout: order, widths, hidden columns and sort. Supports two-way binding
    /// (@bind-Layout), so an app can save the user's layout and restore it.
    /// </summary>
    [Parameter]
    public StilDataGridLayout? Layout { get; set; }

    [Parameter]
    public EventCallback<StilDataGridLayout> LayoutChanged { get; set; }

    /// <summary>The column chooser's button text. The default is the localized "Columns".</summary>
    [Parameter]
    public string? ColumnsText { get; set; }

    /// <summary>
    /// The Keys of the columns the rows are grouped by, outermost first. Supports two-way binding
    /// (@bind-GroupBy). Each group gets a header row with its value, its number of rows and the
    /// totals of the columns with an Aggregate.
    /// </summary>
    [Parameter]
    public IReadOnlyList<string>? GroupBy { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyList<string>> GroupByChanged { get; set; }

    /// <summary>Shows a Group by button in the toolbar that groups the rows by the columns the user picks.</summary>
    [Parameter]
    public bool ShowGroupChooser { get; set; }

    /// <summary>The group chooser's button text. The default is the localized "Group by".</summary>
    [Parameter]
    public string? GroupByText { get; set; }

    /// <summary>Shows an export button in the toolbar that downloads the filtered rows as CSV (see ExportCsvAsync).</summary>
    [Parameter]
    public bool ShowExport { get; set; }

    /// <summary>The name of the downloaded CSV file. The default is "export.csv".</summary>
    [Parameter]
    public string ExportFileName { get; set; } = "export.csv";

    /// <summary>The export button's text. The default is the localized "Export CSV".</summary>
    [Parameter]
    public string? ExportText { get; set; }

    /// <summary>The label of the totals row, in the first column when that column has no total. The default is the localized "Total".</summary>
    [Parameter]
    public string? TotalText { get; set; }

    /// <summary>
    /// Edits rows in place: Row (with a StilDataGridEditColumn, a double click, Enter or F2) or
    /// Cell (click a cell). The columns get Stil fields that fit their type, or their EditTemplate;
    /// the item is edited in place and validated with its data annotations.
    /// </summary>
    [Parameter]
    public StilDataGridEditMode EditMode { get; set; }

    /// <summary>
    /// Saves an edited or new row (for example to a database). Return false to keep editing, for
    /// example after a server error. Without it, edits stay on the item.
    /// </summary>
    [Parameter]
    public Func<StilDataGridEditArgs<TItem>, Task<bool>>? OnRowSave { get; set; }

    /// <summary>Raised when editing is cancelled, after the item's values are put back.</summary>
    [Parameter]
    public EventCallback<StilDataGridEditArgs<TItem>> OnRowCancel { get; set; }

    /// <summary>Rows per page. 0 shows all rows without a pager. The default is 10.</summary>
    [Parameter]
    public int PageSize { get; set; } = 10;

    /// <summary>Choices for rows per page, for example [10, 25, 50]. Shows a select next to the pager.</summary>
    [Parameter]
    public int[]? PageSizeOptions { get; set; }

    /// <summary>Show a filter row for every column that can be filtered (text, enum and bool columns).</summary>
    [Parameter]
    public bool Filterable { get; set; }

    /// <summary>None (default), Single or Multiple.</summary>
    [Parameter]
    public StilSelectionMode SelectionMode { get; set; }

    /// <summary>The selected row in Single mode. Supports two-way binding.</summary>
    [Parameter]
    public TItem? SelectedItem { get; set; }

    /// <summary>Raised when the selected row changes.</summary>
    [Parameter]
    public EventCallback<TItem?> SelectedItemChanged { get; set; }

    /// <summary>The selected rows in Multiple mode. Supports two-way binding.</summary>
    [Parameter]
    public IReadOnlyCollection<TItem>? SelectedItems { get; set; }

    /// <summary>Raised when the selected rows change.</summary>
    [Parameter]
    public EventCallback<IReadOnlyCollection<TItem>> SelectedItemsChanged { get; set; }

    /// <summary>
    /// Identifies a row, for selection and rendering, when rows are new objects on every load
    /// (for example from a database). The default compares the items themselves.
    /// </summary>
    [Parameter]
    public Func<TItem, object>? ItemKey { get; set; }

    /// <summary>Raised when a row is clicked, or focused and Enter is pressed.</summary>
    [Parameter]
    public EventCallback<TItem> OnRowClick { get; set; }

    /// <summary>Extra classes for a row.</summary>
    [Parameter]
    public Func<TItem, string?>? RowClass { get; set; }

    /// <summary>
    /// Render only the visible rows while scrolling, for very long lists. Needs Height; replaces
    /// paging. Rows must all be ItemSize pixels high.
    /// </summary>
    [Parameter]
    public bool Virtualize { get; set; }

    /// <summary>The height of a row in pixels, for Virtualize. The default is 41.</summary>
    [Parameter]
    public float ItemSize { get; set; } = 41;

    /// <summary>A CSS max-height for the scrolling table, for example "28rem". The header stays visible.</summary>
    [Parameter]
    public string? Height { get; set; }

    /// <summary>A caption shown with the table, also its accessible name.</summary>
    [Parameter]
    public string? Caption { get; set; }

    /// <summary>Shade every other row.</summary>
    [Parameter]
    public bool Striped { get; set; }

    /// <summary>Smaller cell padding.</summary>
    [Parameter]
    public bool Compact { get; set; }

    /// <summary>Borders on every cell.</summary>
    [Parameter]
    public bool Bordered { get; set; }

    /// <summary>Shown when there are no rows. The default is EmptyText.</summary>
    [Parameter]
    public RenderFragment? EmptyContent { get; set; }

    /// <summary>The text shown when there are no rows.</summary>
    [Parameter]
    public string? EmptyText { get; set; }

    /// <summary>The text shown while rows are loading.</summary>
    [Parameter]
    public string? LoadingText { get; set; }

    /// <summary>The placeholder of the text filters.</summary>
    [Parameter]
    public string? FilterPlaceholder { get; set; }

    /// <summary>The accessible name of a column filter; {0} is the column title.</summary>
    [Parameter]
    public string? FilterLabelFormat { get; set; }

    /// <summary>The first option of a choice filter, which shows every row.</summary>
    [Parameter]
    public string? AllOptionText { get; set; }

    /// <summary>The row range summary; {0} first row, {1} last row, {2} total.</summary>
    [Parameter]
    public string? SummaryFormat { get; set; }

    /// <summary>The accessible name of the rows per page select.</summary>
    [Parameter]
    public string? RowsPerPageLabel { get; set; }

    /// <summary>The accessible name of the pager.</summary>
    [Parameter]
    public string? PaginationLabel { get; set; }

    /// <summary>The accessible name of the header checkbox in Multiple mode.</summary>
    [Parameter]
    public string? SelectAllLabel { get; set; }

    /// <summary>The accessible name of a row checkbox in Multiple mode.</summary>
    [Parameter]
    public string? SelectRowLabel { get; set; }

    /// <summary>The rows currently shown (the current page).</summary>
    public IReadOnlyList<TItem> CurrentItems => _page;

    /// <summary>The number of rows after filtering.</summary>
    public int TotalCount => _total;

    private bool Paged => !Virtualize && PageSize > 0;

    private bool Grouped => GroupColumns.Count > 0;

    private bool Interactive => SelectionMode == StilSelectionMode.Single || OnRowClick.HasDelegate;

    private string TableClass => string.Join(' ', new[]
    {
        "stil-table",
        Striped ? "stil-table-striped" : null,
        Interactive ? "stil-table-hover" : null,
        Compact ? "stil-table-compact" : null,
        Bordered ? "stil-table-bordered" : null,
    }.Where(c => c is not null));

    private string ScrollClass => Height is null ? "stil-table-responsive" : "stil-table-responsive stil-data-grid-scroll";

    private string? ScrollStyle => Height is null ? null : $"max-height: {Height}";

    private string Summary
    {
        get
        {
            // Every group collapsed: there are rows, but none to count on the pages.
            if (_rowCount == 0 && _groupRows.Count > 0)
            {
                return "";
            }

            if (_rowCount == 0)
            {
                return string.Format(System.Globalization.CultureInfo.CurrentCulture, Localize(SummaryFormat, "DataGrid.SummaryFormat"), 0, 0, 0);
            }

            var first = (_pageNumber - 1) * _pageSize + 1;
            var last = Math.Min(_rowCount, first + _page.Count - 1);
            return string.Format(System.Globalization.CultureInfo.CurrentCulture, Localize(SummaryFormat, "DataGrid.SummaryFormat"), first, last, _rowCount);
        }
    }

    // ----- Columns -------------------------------------------------------------------------

    internal void AddColumn(StilDataGridColumnBase<TItem> column)
    {
        if (_columns.Contains(column))
        {
            return;
        }

        _columns.Add(column);
        UpdateVisible();
        if (_layoutSortKey is not null && column.ColumnKey == _layoutSortKey)
        {
            // The saved layout's sort, now that its column is here.
            _layoutSortKey = null;
            _sortColumn = column;
            _ = InvokeAsync(RefreshAsync);
        }
        else if (!_initialSortApplied && _sortColumn is null && column.InitialSortDirection != StilSortDirection.None)
        {
            _initialSortApplied = true;
            _sortColumn = column;
            _sortDirection = column.InitialSortDirection;
            _ = InvokeAsync(RefreshAsync);
        }
        else if ((column.HasAggregate || _groupBy.Contains(column.ColumnKey)) && !_reloadQueued && !IsTree)
        {
            // The columns register after the first load, which therefore had no totals to compute
            // and no columns to group by. Reload once all of them are in: after the current render.
            // (A tree grid computes its totals when it renders them.)
            _reloadQueued = true;
            _ = InvokeAsync(async () =>
            {
                await Task.Yield();
                await RefreshAsync();
            });
        }
        else
        {
            StateHasChanged();
        }
    }

    internal void RemoveColumn(StilDataGridColumnBase<TItem> column)
    {
        if (!_columns.Remove(column))
        {
            return;
        }

        _filters.Remove(column);
        UpdateVisible();
        if (ReferenceEquals(_sortColumn, column))
        {
            _sortColumn = null;
            _sortDirection = StilSortDirection.None;
        }

        StateHasChanged();
    }

    // ----- Loading -------------------------------------------------------------------------

    protected override async Task OnParametersSetAsync()
    {
        if (IsTree && ItemsProvider is not null)
        {
            throw new InvalidOperationException("A StilTreeGrid takes its top-level rows from Items; load children with LoadChildren.");
        }

        if (Layout is not null && !ReferenceEquals(Layout, _appliedLayout))
        {
            ApplyLayout(Layout);
        }

        if (_pageSize == 0 || (PageSizeOptions is null && _pageSize != PageSize))
        {
            _pageSize = PageSize;
        }

        var reload = false;
        if (GroupBy is not null && !ReferenceEquals(GroupBy, _appliedGroupBy))
        {
            _appliedGroupBy = GroupBy;
            if (!GroupBy.SequenceEqual(_groupBy))
            {
                _groupBy = GroupBy.ToList();
                _collapsed.Clear();
                _pageNumber = 1;
                reload = true;
            }
        }

        // Reload when the data source itself changes (a new list or provider), not on every render.
        if (!ReferenceEquals(_loadedItems, Items) || !ReferenceEquals(_loadedProvider, ItemsProvider))
        {
            _loadedItems = Items;
            _loadedProvider = ItemsProvider;
            reload = true;
        }

        if (reload)
        {
            await RefreshAsync();
        }
    }

    /// <summary>Loads the rows again, for example after the data has changed.</summary>
    public Task RefreshAsync() => RefreshAsync(keepGroups: false);

    // keepGroups: only the collapsed groups changed, so the groups need not be computed again.
    private async Task RefreshAsync(bool keepGroups)
    {
        if (!keepGroups)
        {
            _groupsStale = true;
        }

        _treeStale = true;
        if (Virtualize)
        {
            if (_virtualize is not null)
            {
                await _virtualize.RefreshDataAsync();
            }

            StateHasChanged();
            return;
        }

        if (IsTree)
        {
            // The tree is in memory: no loading state.
            ShowTree();
            StateHasChanged();
            return;
        }

        _loadCts?.Cancel();
        var cts = _loadCts = new CancellationTokenSource();
        _loading = true;
        StateHasChanged();

        try
        {
            if (Grouped)
            {
                await LoadGroupedPageAsync(cts.Token);
                return;
            }

            var count = Paged ? _pageSize : (int?)null;
            var result = await LoadAsync((_pageNumber - 1) * _pageSize, count, cts.Token);

            // The page fell outside the data (for example after filtering): go to the last page.
            if (Paged && result.Items.Count == 0 && result.TotalCount > 0 && _pageNumber > 1)
            {
                _pageNumber = (int)Math.Ceiling(result.TotalCount / (double)_pageSize);
                result = await LoadAsync((_pageNumber - 1) * _pageSize, count, cts.Token);
            }

            if (cts.IsCancellationRequested)
            {
                return;
            }

            _page = result.Items.ToList();
            _entries = _page.Select(item => new Entry(null, item)).ToList();
            _total = _rowCount = result.TotalCount;
            _aggregates = result.Aggregates ?? new Dictionary<string, object?>();
            _groupRows = [];
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            return;
        }
        finally
        {
            if (ReferenceEquals(_loadCts, cts))
            {
                _loading = false;
                StateHasChanged();
            }
        }
    }

    private async Task<StilDataGridResult<TItem>> LoadAsync(int startIndex, int? count, CancellationToken cancellationToken, bool withAggregates = true, bool withGroups = false)
    {
        var aggregated = withAggregates ? _columns.Where(c => c.Aggregate != StilAggregate.None).Select(c => c.ColumnKey).ToList() : [];
        var request = new StilDataGridRequest<TItem>(
            startIndex,
            count,
            _sortColumn?.ColumnKey,
            _sortColumn is null ? StilSortDirection.None : _sortDirection,
            _filters.Where(f => !string.IsNullOrWhiteSpace(f.Value)).ToDictionary(f => f.Key.ColumnKey, f => f.Value),
            ApplyFiltersAndSorting,
            cancellationToken,
            aggregated,
            ComputeAggregates,
            GroupColumns.Select(c => c.ColumnKey).ToList(),
            query => ComputeGroups(query, custom: false),
            withGroups);

        if (ItemsProvider is not null)
        {
            return await ItemsProvider(request);
        }

        if (Items is null)
        {
            return new StilDataGridResult<TItem>([], 0);
        }

        var query = ApplyFiltersAndSorting(Items.AsQueryable());
        var total = query.Count();
        var aggregates = new Dictionary<string, object?>(request.ComputeAggregates(query));
        if (withAggregates)
        {
            foreach (var column in _columns.Where(c => c.AggregateValue is not null))
            {
                aggregates[column.ColumnKey] = column.AggregateValue!(query);
            }
        }

        var groups = withGroups ? ComputeGroups(query, custom: true) : null;
        return new StilDataGridResult<TItem>(request.ApplyPaging(query).ToList(), total, aggregates, groups);
    }

    private IReadOnlyDictionary<string, object?> ComputeAggregates(IQueryable<TItem> query) =>
        _columns.Where(c => c.Aggregate != StilAggregate.None).ToDictionary(c => c.ColumnKey, c => c.ComputeAggregate(query));

    /// <summary>
    /// The filtered and sorted rows of every page as CSV, with a header row and the columns that
    /// can be exported. Numbers have no thousands separators, so spreadsheets read them as
    /// numbers; the separator is the culture's list separator. With an ItemsProvider the rows
    /// are fetched in batches.
    /// </summary>
    public async Task<string> ExportCsvAsync(CancellationToken cancellationToken = default)
    {
        var columns = _visible.Where(c => c.CanExport).ToList();
        var rows = new List<TItem>();
        if (IsTree)
        {
            rows.AddRange(TreeExportRows());
        }
        else if (ItemsProvider is null)
        {
            rows.AddRange(Items is null ? [] : ApplyFiltersAndSorting(Items.AsQueryable()));
        }
        else
        {
            const int batch = 500;
            while (true)
            {
                var result = await LoadAsync(rows.Count, batch, cancellationToken, withAggregates: false);
                rows.AddRange(result.Items);
                if (result.Items.Count < batch || rows.Count >= result.TotalCount)
                {
                    break;
                }
            }
        }

        return StilDataGridExport.Csv(columns, rows, System.Globalization.CultureInfo.CurrentCulture);
    }

    /// <summary>Exports the rows (see ExportCsvAsync) and lets the browser download them as ExportFileName.</summary>
    public async Task DownloadCsvAsync()
    {
        _exporting = true;
        StateHasChanged();
        try
        {
            var csv = await ExportCsvAsync();
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Stil/stil.js");
            // The byte order mark tells Excel the file is UTF-8.
            await module.InvokeVoidAsync("downloadFile", ExportFileName, "text/csv;charset=utf-8", "﻿" + csv);
        }
        finally
        {
            _exporting = false;
        }
    }

    private IQueryable<TItem> ApplyFilters(IQueryable<TItem> query)
    {
        foreach (var (column, value) in _filters)
        {
            query = column.ApplyFilter(query, value);
        }

        return query;
    }

    private IQueryable<TItem> ApplyFiltersAndSorting(IQueryable<TItem> query)
    {
        query = ApplyFilters(query);

        // Grouped rows are sorted by their groups first, so each group's rows come together.
        var groups = GroupColumns;
        for (var i = 0; i < groups.Count; i++)
        {
            query = groups[i].ApplySort(query, GroupDescending(groups[i]), thenBy: i > 0);
        }

        if (_sortColumn is not null && _sortDirection != StilSortDirection.None && !groups.Contains(_sortColumn))
        {
            query = _sortColumn.ApplySort(query, _sortDirection == StilSortDirection.Descending, thenBy: groups.Count > 0);
        }

        return query;
    }

    private async ValueTask<ItemsProviderResult<Entry>> ProvideVirtualizedAsync(ItemsProviderRequest request)
    {
        if (IsTree)
        {
            return ProvideTree(request.StartIndex, request.Count);
        }

        if (Grouped)
        {
            if (_groupsStale)
            {
                await LoadGroupsAsync(request.CancellationToken);
                _ = InvokeAsync(StateHasChanged);
            }

            // Here a group header takes a row's place, so the range counts both.
            var segments = Segments();
            var entries = await LoadPlanAsync(RangePlan(segments, request.StartIndex, request.StartIndex + request.Count), request.CancellationToken);
            return new ItemsProviderResult<Entry>(entries, segments.Sum(s => s.Rows ? s.Group.Group.Count : 1));
        }

        // The totals cover every row, so they are computed with the first rows only.
        var first = request.StartIndex == 0;
        var result = await LoadAsync(request.StartIndex, request.Count, request.CancellationToken, withAggregates: first);
        if (_total != result.TotalCount || (first && result.Aggregates is { Count: > 0 }))
        {
            _total = result.TotalCount;
            if (first && result.Aggregates is { } aggregates)
            {
                _aggregates = aggregates;
            }

            _ = InvokeAsync(StateHasChanged);
        }

        return new ItemsProviderResult<Entry>(result.Items.Select(item => new Entry(null, item)).ToList(), result.TotalCount);
    }

    // ----- Sorting, filtering and paging ------------------------------------------------------

    private async Task SortAsync(StilDataGridColumnBase<TItem> column)
    {
        // Ascending, then descending, then unsorted.
        if (ReferenceEquals(_sortColumn, column))
        {
            _sortDirection = _sortDirection switch
            {
                StilSortDirection.Ascending => StilSortDirection.Descending,
                StilSortDirection.Descending => StilSortDirection.None,
                _ => StilSortDirection.Ascending
            };
            if (_sortDirection == StilSortDirection.None)
            {
                _sortColumn = null;
            }
        }
        else
        {
            _sortColumn = column;
            _sortDirection = StilSortDirection.Ascending;
        }

        _pageNumber = 1;
        await RefreshAsync();
        await NotifyLayoutAsync();
    }

    private string? AriaSort(StilDataGridColumnBase<TItem> column)
    {
        if (!column.CanSort)
        {
            return null;
        }

        return ReferenceEquals(_sortColumn, column) && _sortDirection != StilSortDirection.None
            ? (_sortDirection == StilSortDirection.Ascending ? "ascending" : "descending")
            : "none";
    }

    private string SortIcon(StilDataGridColumnBase<TItem> column) =>
        ReferenceEquals(_sortColumn, column) && _sortDirection == StilSortDirection.Descending
            ? StilIcons.ChevronDown
            : StilIcons.ChevronUp;

    private string FilterValue(StilDataGridColumnBase<TItem> column) =>
        _filters.TryGetValue(column, out var value) ? value : "";

    private async Task FilterChangedAsync(StilDataGridColumnBase<TItem> column, string? value, bool debounce)
    {
        _filters[column] = value ?? "";
        _pageNumber = 1;

        if (debounce)
        {
            _debounceCts?.Cancel();
            var cts = _debounceCts = new CancellationTokenSource();
            try
            {
                await Task.Delay(300, cts.Token);
            }
            catch (TaskCanceledException)
            {
                return;
            }
        }

        await RefreshAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        _pageNumber = page;
        await RefreshAsync();
    }

    private async Task PageSizeChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
        {
            _pageSize = size;
            _pageNumber = 1;
            await RefreshAsync();
        }
    }

    // ----- Selection -----------------------------------------------------------------------

    private object KeyOf(TItem item) => ItemKey?.Invoke(item) ?? (object?)item ?? "";

    private bool IsSelected(TItem item) => SelectionMode switch
    {
        StilSelectionMode.Single => SelectedItem is not null && KeyOf(SelectedItem).Equals(KeyOf(item)),
        StilSelectionMode.Multiple => SelectedItems?.Any(selected => KeyOf(selected).Equals(KeyOf(item))) == true,
        _ => false
    };

    private bool AllOnPageSelected => _page.Count > 0 && _page.All(IsSelected);

    private async Task ActivateRowAsync(TItem item)
    {
        if (SelectionMode == StilSelectionMode.Single && !IsSelected(item))
        {
            SelectedItem = item;
            await SelectedItemChanged.InvokeAsync(item);
        }

        await OnRowClick.InvokeAsync(item);
    }

    private async Task OnRowClickedAsync(TItem item)
    {
        if (Interactive)
        {
            await ActivateRowAsync(item);
        }
    }

    private async Task OnRowKeyDownAsync(KeyboardEventArgs e, TItem item, TreeRow? node)
    {
        if (node is not null && await OnTreeKeyDownAsync(e, node))
        {
            return;
        }

        if (EditMode == StilDataGridEditMode.Row && e.Key is "Enter" or "F2")
        {
            await BeginEditAsync(item);
            return;
        }

        if (Interactive && e.Key == "Enter")
        {
            await ActivateRowAsync(item);
        }
    }

    private async Task ToggleRowAsync(TItem item)
    {
        var selected = (SelectedItems ?? []).ToList();
        var index = selected.FindIndex(s => KeyOf(s).Equals(KeyOf(item)));
        if (index >= 0)
        {
            selected.RemoveAt(index);
        }
        else
        {
            selected.Add(item);
        }

        SelectedItems = selected;
        await SelectedItemsChanged.InvokeAsync(selected);
    }

    private async Task ToggleAllOnPageAsync()
    {
        var selected = (SelectedItems ?? []).ToList();
        if (AllOnPageSelected)
        {
            selected.RemoveAll(s => _page.Any(item => KeyOf(item).Equals(KeyOf(s))));
        }
        else
        {
            selected.AddRange(_page.Where(item => !IsSelected(item)));
        }

        SelectedItems = selected;
        await SelectedItemsChanged.InvokeAsync(selected);
    }

    // ----- Rendering -----------------------------------------------------------------------

    private RenderFragment Row(TItem item, TreeRow? node) => IsEditing(item) ? EditRow(_editItem!, node) : @<tr @key="KeyOf(item)" class="@RowClass?.Invoke(item)"
                                                    style="@LevelStyle(node)" aria-level="@node?.Level" aria-setsize="@node?.SetSize" aria-posinset="@node?.Position"
                                                    aria-expanded="@(node is { HasChildren: true } ? (node.Expanded ? "true" : "false") : null)"
                                                    aria-busy="@(node is not null && _loadingRows.Contains(node.Key) ? "true" : null)"
                                                    aria-selected="@(SelectionMode == StilSelectionMode.None ? null : (IsSelected(item) ? "true" : "false"))"
                                                    tabindex="@(node is not null ? TreeTabIndex(node) : Interactive || EditMode == StilDataGridEditMode.Row ? 0 : (int?)null)"
                                                    @onfocus="@(node is null ? null : () => OnTreeRowFocus(node))"
                                                    @onclick="() => OnRowClickedAsync(item)"
                                                    @ondblclick="@(EditMode == StilDataGridEditMode.Row ? () => BeginEditAsync(item) : null)"
                                                    @onkeydown="e => OnRowKeyDownAsync(e, item, node)">
        @if (SelectionMode == StilSelectionMode.Multiple)
        {
            <td class="stil-data-grid-select" data-stil-frozen="@SelectFrozen" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                <input type="checkbox" class="stil-check-input" aria-label="@Localize(SelectRowLabel, "DataGrid.SelectRow")" checked="@IsSelected(item)"
                       @onchange="() => ToggleRowAsync(item)" />
            </td>
        }
        @foreach (var column in _visible)
        {
            var editable = EditMode == StilDataGridEditMode.Cell && column.CanEdit && !column.IsCommand;
            <td @key="column.ColumnKey" class="@column.CellClass" data-stil-frozen="@column.FrozenValue" data-stil-editable="@(editable ? "" : null)"
                @onclick="@(editable ? () => BeginCellEditAsync(item, column) : null)"
                @onclick:stopPropagation="column.IsCommand" @onkeydown:stopPropagation="column.IsCommand">@Cell(column, CellContent(item, column, node), node)</td>
        }
    </tr>;

    // A row being edited: Stil fields in the edited columns, in the row's EditContext.
    private RenderFragment EditRow(TItem item, TreeRow? node) => @<CascadingValue Value="_editContext">
        <tr @key="@(_editIsNew ? _newRowKey : KeyOf(item))" class="stil-data-grid-editing" @onkeydown="OnEditKeyDownAsync"
            style="@LevelStyle(node)" aria-level="@(node?.Level ?? (IsTree ? 1 : null))">
            @if (SelectionMode == StilSelectionMode.Multiple)
            {
                <td class="stil-data-grid-select" data-stil-frozen="@SelectFrozen"></td>
            }
            @foreach (var column in _visible)
            {
                @if (IsEdited(column))
                {
                    <td @key="column.ColumnKey" class="@column.CellClass" data-stil-frozen="@column.FrozenValue" data-stil-editor
                        @onfocusout="OnEditorFocusOutAsync">@Cell(column, column.RenderEditor(item), node)</td>
                }
                else
                {
                    <td @key="column.ColumnKey" class="@column.CellClass" data-stil-frozen="@column.FrozenValue">@Cell(column, CellContent(item, column, node), node)</td>
                }
            }
        </tr>
    </CascadingValue>;

    private RenderFragment EntryRow(Entry entry) => entry.Group is null ? Row(entry.Item, entry.Node) : GroupHeader(entry.Group);

    // A row with children shows the totals of the rows below it in the columns with an Aggregate.
    private RenderFragment CellContent(TItem item, StilDataGridColumnBase<TItem> column, TreeRow? node) =>
        node is { Leaves: not null } && column.HasAggregate
            ? builder => builder.AddContent(0, column.FormatTotal(TreeTotal(column, node)))
            : column.RenderCell(item);

    // In a tree grid the first column holds the expand toggle, indented by the row's level.
    private RenderFragment Cell(StilDataGridColumnBase<TItem> column, RenderFragment content, TreeRow? node) =>
        IsTree && _visible.Count > 0 && ReferenceEquals(column, _visible[0]) ? TreeCell(content, node) : content;

    private RenderFragment TreeCell(RenderFragment content, TreeRow? node) => @<span class="stil-tree-grid-cell">
        @if (node is { HasChildren: true } && _loadingRows.Contains(node.Key))
        {
            <span class="stil-tree-grid-toggle">
                <span class="stil-spinner stil-spinner-sm" role="status"><span class="stil-visually-hidden">@Localize(LoadingText, "Common.Loading")</span></span>
            </span>
        }
        else if (node is { HasChildren: true })
        {
            <span class="stil-tree-grid-toggle" aria-hidden="true"
                  @onclick="() => SetRowExpandedAsync(node.Item, !node.Expanded)" @onclick:stopPropagation="true">
                <StilIcon Name="@StilIcons.ChevronRight" />
            </span>
        }
        else
        {
            <span class="stil-tree-grid-toggle" aria-hidden="true"></span>
        }
        @content
    </span>;

    private static string? LevelStyle(TreeRow? node) => node is null ? null : $"--_level: {node.Level - 1}";

    // A group's header row: a button that expands and collapses it, with the group's value and
    // row count, followed by the group's totals under their columns.
    private RenderFragment GroupHeader(GroupRow group) => @<tr @key="group.Key" class="stil-data-grid-group" data-stil-level="@group.Level">
        @{
            var collapsed = _collapsed.Contains(group.Id);
            var span = GroupSpan;
        }
        <td colspan="@(span + (SelectionMode == StilSelectionMode.Multiple ? 1 : 0))" class="stil-data-grid-group-cell">
            <button type="button" class="stil-data-grid-group-toggle" style="--_level: @group.Level" aria-expanded="@(collapsed ? "false" : "true")"
                    @onclick="() => ToggleGroupAsync(group)" @onkeydown="e => OnGroupKeyDownAsync(e, group)">
                <StilIcon Name="@(collapsed ? StilIcons.ChevronRight : StilIcons.ChevronDown)" />
                <span class="stil-data-grid-group-title">@group.Column.DisplayTitle:</span>
                @group.Column.FormatGroupValue(group.Group.Path[^1])
                <span class="stil-data-grid-group-count">(@group.Group.Count.ToString("N0", System.Globalization.CultureInfo.CurrentCulture))</span>
            </button>
        </td>
        @for (var i = span; i < _visible.Count; i++)
        {
            var column = _visible[i];
            <td class="@column.CellClass">@(column.HasAggregate ? column.FormatTotal(group.Group.Aggregates?.GetValueOrDefault(column.ColumnKey)) : null)</td>
        }
    </tr>;

    // While the first rows load: skeleton lines, and the loading text for screen readers.
    private RenderFragment LoadingRow => @<tr>
        <td colspan="@Math.Max(1, _visible.Count + (SelectionMode == StilSelectionMode.Multiple ? 1 : 0))" class="stil-data-grid-message" aria-busy="true"><span class="stil-visually-hidden" role="status">@Localize(LoadingText, "Common.Loading")</span><StilSkeleton Shape="StilSkeletonShape.Text" Lines="3" /></td>
    </tr>;

    private RenderFragment MessageRow(RenderFragment? content, string text) => @<tr>
        <td colspan="@Math.Max(1, _visible.Count + (SelectionMode == StilSelectionMode.Multiple ? 1 : 0))" class="stil-data-grid-message">
            @if (content is not null)
            {
                @content
            }
            else
            {
                @text
            }
        </td>
    </tr>;

    // ----- Grouping ----------------------------------------------------------------------------

    // A row of the table body: a group header (Group) or a data row (Item), in a tree grid with its Node.
    private readonly record struct Entry(GroupRow? Group, TItem Item, TreeRow? Node = null);

    private sealed record GroupKey(string Id);

    private sealed class GroupRow(StilDataGridGroup group, StilDataGridColumnBase<TItem> column, string id, int start)
    {
        public StilDataGridGroup Group { get; } = group;

        public StilDataGridColumnBase<TItem> Column { get; } = column;

        public string Id { get; } = id;

        public GroupKey Key { get; } = new(id);

        /// <summary>The index of the group's first row among all sorted rows.</summary>
        public int Start { get; } = start;

        public int Level => Group.Path.Count - 1;
    }

    // A group header to show, or a range of rows (by index among all sorted rows) to load.
    private readonly record struct PlanItem(GroupRow Group, bool Header, int Start = 0, int Count = 0);

    private List<StilDataGridColumnBase<TItem>> GroupColumns => IsTree ? [] : _groupBy
        .Select(key => _columns.FirstOrDefault(c => c.ColumnKey == key && c.CanGroup))
        .OfType<StilDataGridColumnBase<TItem>>()
        .ToList();

    // Groups follow the sort direction when the grid is sorted by their column.
    private bool GroupDescending(StilDataGridColumnBase<TItem> column) =>
        ReferenceEquals(_sortColumn, column) && _sortDirection == StilSortDirection.Descending;

    // The columns a group header's text spans: those before the first column with a total.
    private int GroupSpan
    {
        get
        {
            var index = _visible.FindIndex(c => c.HasAggregate);
            return index < 0 ? _visible.Count : Math.Max(1, index);
        }
    }

    private List<StilDataGridGroup> ComputeGroups(IQueryable<TItem> query, bool custom)
    {
        var columns = GroupColumns;
        var groups = new List<StilDataGridGroup>();
        if (columns.Count > 0)
        {
            Add(query, 0, []);
        }

        return groups;

        void Add(IQueryable<TItem> rows, int level, IReadOnlyList<object?> path)
        {
            var column = columns[level];
            foreach (var value in column.GroupValues(rows, GroupDescending(column)))
            {
                var subset = column.WhereGroup(rows, value);
                List<object?> groupPath = [.. path, value];
                var aggregates = new Dictionary<string, object?>(ComputeAggregates(subset));
                if (custom)
                {
                    foreach (var aggregated in _columns.Where(c => c.AggregateValue is not null))
                    {
                        aggregates[aggregated.ColumnKey] = aggregated.AggregateValue!(subset);
                    }
                }

                groups.Add(new StilDataGridGroup(groupPath, subset.Count(), aggregates));
                if (level + 1 < columns.Count)
                {
                    Add(subset, level + 1, groupPath);
                }
            }
        }
    }

    private async Task LoadGroupsAsync(CancellationToken cancellationToken)
    {
        var result = await LoadAsync(0, 0, cancellationToken, withGroups: true);
        if (cancellationToken.IsCancellationRequested)
        {
            return;
        }

        _total = result.TotalCount;
        _aggregates = result.Aggregates ?? new Dictionary<string, object?>();

        var columns = GroupColumns;
        var rows = new List<GroupRow>();
        var offset = 0;
        foreach (var group in result.Groups ?? [])
        {
            var level = group.Path.Count - 1;
            if (level < 0 || level >= columns.Count)
            {
                continue;
            }

            var id = string.Join('\u001f', group.Path.Select(value => value is null ? "\u0000" : Convert.ToString(value, System.Globalization.CultureInfo.InvariantCulture)));
            rows.Add(new GroupRow(group, columns[level], id, offset));
            if (level == columns.Count - 1)
            {
                offset += group.Count;
            }
        }

        _groupRows = rows;
        _groupLevels = columns.Count;
        _groupsStale = false;
    }

    // The groups as shown: each header, followed by its rows (innermost groups) or subgroups,
    // unless it is collapsed.
    private List<(GroupRow Group, bool Rows)> Segments()
    {
        var segments = new List<(GroupRow Group, bool Rows)>();
        int? hiddenBelow = null;
        foreach (var group in _groupRows)
        {
            if (hiddenBelow is { } level && group.Level > level)
            {
                continue;
            }

            hiddenBelow = null;
            segments.Add((group, false));
            if (_collapsed.Contains(group.Id))
            {
                hiddenBelow = group.Level;
            }
            else if (group.Level == _groupLevels - 1)
            {
                segments.Add((group, true));
            }
        }

        return segments;
    }

    // A page counts rows only: it shows the headers between its first and last row, and repeats
    // the headers of a group that continues from the page before.
    private static List<PlanItem> PagePlan(List<(GroupRow Group, bool Rows)> segments, int first, int end, int total)
    {
        var plan = new List<PlanItem>();
        var shown = new HashSet<GroupRow>();
        var open = new List<GroupRow>();
        var position = 0;
        foreach (var (group, rows) in segments)
        {
            if (!rows)
            {
                open.RemoveRange(Math.Min(group.Level, open.Count), Math.Max(0, open.Count - group.Level));
                open.Add(group);
                if (first <= position && (position < end || position == total))
                {
                    plan.Add(new PlanItem(group, Header: true));
                    shown.Add(group);
                }

                continue;
            }

            var from = Math.Max(first, position);
            var to = Math.Min(end, position + group.Group.Count);
            if (from < to)
            {
                foreach (var parent in open.Where(parent => !shown.Contains(parent)))
                {
                    plan.Add(new PlanItem(parent, Header: true));
                    shown.Add(parent);
                }

                plan.Add(new PlanItem(group, Header: false, group.Start + from - position, to - from));
            }

            position += group.Group.Count;
        }

        return plan;
    }

    // For virtualization, where every header and row takes one place.
    private static List<PlanItem> RangePlan(List<(GroupRow Group, bool Rows)> segments, int first, int end)
    {
        var plan = new List<PlanItem>();
        var position = 0;
        foreach (var (group, rows) in segments)
        {
            if (position >= end)
            {
                break;
            }

            if (!rows)
            {
                if (position >= first)
                {
                    plan.Add(new PlanItem(group, Header: true));
                }

                position++;
                continue;
            }

            var from = Math.Max(first, position);
            var to = Math.Min(end, position + group.Group.Count);
            if (from < to)
            {
                plan.Add(new PlanItem(group, Header: false, group.Start + from - position, to - from));
            }

            position += group.Group.Count;
        }

        return plan;
    }

    // Loads the plan's rows, one request per run of adjacent rows, and puts the headers between them.
    private async Task<List<Entry>> LoadPlanAsync(List<PlanItem> plan, CancellationToken cancellationToken)
    {
        var rows = new Dictionary<int, TItem>();
        var slices = plan.Where(p => !p.Header).ToList();
        for (var i = 0; i < slices.Count;)
        {
            var start = slices[i].Start;
            var end = start + slices[i].Count;
            for (i++; i < slices.Count && slices[i].Start == end; i++)
            {
                end += slices[i].Count;
            }

            var result = await LoadAsync(start, end - start, cancellationToken, withAggregates: false);
            for (var r = 0; r < result.Items.Count; r++)
            {
                rows[start + r] = result.Items[r];
            }
        }

        var entries = new List<Entry>();
        foreach (var item in plan)
        {
            if (item.Header)
            {
                entries.Add(new Entry(item.Group, default!));
                continue;
            }

            for (var index = item.Start; index < item.Start + item.Count; index++)
            {
                if (rows.TryGetValue(index, out var row))
                {
                    entries.Add(new Entry(null, row));
                }
            }
        }

        return entries;
    }

    private async Task LoadGroupedPageAsync(CancellationToken cancellationToken)
    {
        if (_groupsStale)
        {
            await LoadGroupsAsync(cancellationToken);
        }

        var segments = Segments();
        _rowCount = segments.Where(s => s.Rows).Sum(s => s.Group.Group.Count);
        int first = 0, end = _rowCount;
        if (Paged)
        {
            // The page fell outside the rows (for example after collapsing): go to the last page.
            if (_pageNumber > 1 && (_pageNumber - 1) * _pageSize >= _rowCount)
            {
                _pageNumber = Math.Max(1, (int)Math.Ceiling(_rowCount / (double)_pageSize));
            }

            first = (_pageNumber - 1) * _pageSize;
            end = first + _pageSize;
        }

        var entries = await LoadPlanAsync(PagePlan(segments, first, end, _rowCount), cancellationToken);
        if (cancellationToken.IsCancellationRequested)
        {
            return;
        }

        _entries = entries;
        _page = entries.Where(e => e.Group is null).Select(e => e.Item).ToList();
    }

    private async Task ToggleGroupAsync(GroupRow group)
    {
        if (!_collapsed.Remove(group.Id))
        {
            _collapsed.Add(group.Id);
        }

        await RefreshAsync(keepGroups: true);
    }

    private async Task OnGroupKeyDownAsync(KeyboardEventArgs e, GroupRow group)
    {
        var collapsed = _collapsed.Contains(group.Id);
        if ((e.Key == "ArrowRight" && collapsed) || (e.Key == "ArrowLeft" && !collapsed))
        {
            await ToggleGroupAsync(group);
        }
    }

    /// <summary>Expands every group.</summary>
    public async Task ExpandAllGroupsAsync()
    {
        _collapsed.Clear();
        await RefreshAsync(keepGroups: true);
    }

    /// <summary>Collapses every group, so only the group headers show.</summary>
    public async Task CollapseAllGroupsAsync()
    {
        _collapsed.UnionWith(_groupRows.Select(g => g.Id));
        await RefreshAsync(keepGroups: true);
    }

    private async Task ToggleGroupByAsync(StilDataGridColumnBase<TItem> column)
    {
        var keys = _groupBy.ToList();
        if (!keys.Remove(column.ColumnKey))
        {
            keys.Add(column.ColumnKey);
        }

        _groupBy = keys;
        _appliedGroupBy = keys;
        _collapsed.Clear();
        _pageNumber = 1;
        await RefreshAsync();
        await GroupByChanged.InvokeAsync(keys);
    }

    // ----- Editing -----------------------------------------------------------------------------

    private static readonly System.Reflection.MethodInfo CloneMethod =
        typeof(object).GetMethod("MemberwiseClone", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic)!;

    /// <summary>The item being edited, or default when no row is.</summary>
    public TItem? EditingItem => _editing ? _editItem : default;

    private bool IsEditing(TItem item) =>
        _editing && !_editIsNew && (ReferenceEquals(item, _editItem) || KeyOf(item).Equals(KeyOf(_editItem!)));

    // In cell editing only the clicked cell has an editor; a new row has all of them.
    private bool IsEdited(StilDataGridColumnBase<TItem> column) =>
        column.CanEdit && (EditMode != StilDataGridEditMode.Cell || _editIsNew || ReferenceEquals(column, _editColumn));

    private StilDataGridEditArgs<TItem> EditArgs => new(_editItem!, _editIsNew, _editColumn?.ColumnKey);

    /// <summary>Starts editing a row. A row that is already being edited is saved first; false when it cannot be.</summary>
    public Task<bool> BeginEditAsync(TItem item) => BeginAsync(item, isNew: false, column: null);

    /// <summary>
    /// Adds a new row at the top of the grid and starts editing it. Save calls OnRowSave with
    /// IsNew, where the app adds the item to its data; Cancel removes the row.
    /// </summary>
    public Task<bool> AddRowAsync(TItem item) => BeginAsync(item, isNew: true, column: null);

    private Task<bool> BeginCellEditAsync(TItem item, StilDataGridColumnBase<TItem> column) => BeginAsync(item, isNew: false, column);

    private async Task<bool> BeginAsync(TItem item, bool isNew, StilDataGridColumnBase<TItem>? column)
    {
        if (_editing)
        {
            if (!isNew && !_editIsNew && IsEditing(item) && ReferenceEquals(column, _editColumn))
            {
                return true;
            }

            if (!await SaveEditAsync())
            {
                return false;
            }
        }

        _editing = true;
        _editItem = item;
        _editIsNew = isNew;
        _editColumn = column;
        // Cancel puts the item's values back from a copy.
        _editSnapshot = isNew || item is null ? null : CloneMethod.Invoke(item, null);
        _editContext = new EditContext(item!);
        _editContext.EnableDataAnnotationsValidation(Services);
        _focusEditor = true;
        StateHasChanged();
        return true;
    }

    /// <summary>
    /// Validates the edited fields and saves the row through OnRowSave. False when a field is not
    /// valid or OnRowSave returns false; the row is then still being edited.
    /// </summary>
    public async Task<bool> SaveEditAsync()
    {
        if (!_editing || _editContext is null)
        {
            return true;
        }

        var fields = _visible.Where(c => IsEdited(c) && !c.IsCommand)
            .Select(c => c.EditField(_editItem!))
            .Where(field => field.HasValue)
            .Select(field => field!.Value)
            .ToList();
        foreach (var field in fields)
        {
            _editContext.NotifyFieldChanged(field);
        }

        if (fields.Any(field => _editContext.GetValidationMessages(field).Any()))
        {
            StateHasChanged();
            return false;
        }

        if (OnRowSave is { } save)
        {
            // Called like an EventCallback, so the component that handles it renders again (with new Items).
            var accepted = false;
            var args = EditArgs;
            await EventCallback.Factory.Create(save.Target ?? this, async () => accepted = await save(args)).InvokeAsync();
            if (!accepted)
            {
                StateHasChanged();
                return false;
            }
        }

        EndEdit();
        await RefreshAsync();
        return true;
    }

    /// <summary>Stops editing and puts the item's values back; a new row is removed.</summary>
    public async Task CancelEditAsync()
    {
        if (!_editing)
        {
            return;
        }

        var args = EditArgs;
        if (_editSnapshot is not null && _editItem is not null)
        {
            foreach (var property in _editItem.GetType().GetProperties(System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.Public)
                         .Where(p => p.CanRead && p.SetMethod?.IsPublic == true && p.GetIndexParameters().Length == 0))
            {
                property.SetValue(_editItem, property.GetValue(_editSnapshot));
            }
        }

        EndEdit();
        StateHasChanged();
        await OnRowCancel.InvokeAsync(args);
    }

    private void EndEdit()
    {
        _editing = false;
        _editIsNew = false;
        _editItem = default;
        _editColumn = null;
        _editContext = null;
        _editSnapshot = null;
    }

    private async Task OnEditKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CancelEditAsync();
        }
        else if (e.Key == "Enter" && EditMode == StilDataGridEditMode.Cell)
        {
            await SaveEditAsync();
        }
    }

    // In cell editing, leaving the cell saves it.
    private async Task OnEditorFocusOutAsync()
    {
        if (EditMode == StilDataGridEditMode.Cell && _editColumn is not null)
        {
            await SaveEditAsync();
        }
    }

    // ----- Column layout ---------------------------------------------------------------------

    /// <summary>The columns in the user's order: the saved order first, then the rest as declared.</summary>
    private IEnumerable<StilDataGridColumnBase<TItem>> Ordered => _columns
        .Select((column, index) => (column, index, position: _order.IndexOf(column.ColumnKey)))
        .OrderBy(c => c.position < 0 ? int.MaxValue : c.position)
        .ThenBy(c => c.index)
        .Select(c => c.column);

    private void UpdateVisible() => _visible = Ordered.Where(c => !_hidden.Contains(c.ColumnKey)).ToList();

    private bool IsResizable(StilDataGridColumnBase<TItem> column) => column.Resizable ?? ResizableColumns;

    private bool IsReorderable(StilDataGridColumnBase<TItem> column) => column.Reorderable ?? ReorderableColumns;

    private bool CanHide(StilDataGridColumnBase<TItem> column) =>
        column.Hideable && (_hidden.Contains(column.ColumnKey) || _visible.Count > 1);

    // The selection column stays with the frozen start columns.
    private string? SelectFrozen => _visible.Any(c => c.Frozen == StilFrozen.Start) ? "start" : null;

    private string? WidthOf(StilDataGridColumnBase<TItem> column) =>
        _widths.TryGetValue(column.ColumnKey, out var width) ? $"width: {width}; min-width: {width}" : column.WidthStyle;

    private string ResizeLabel(StilDataGridColumnBase<TItem> column) =>
        string.Format(System.Globalization.CultureInfo.CurrentCulture, Localize(null, "DataGrid.ResizeFormat"), column.DisplayTitle);

    private string MoveLabel(StilDataGridColumnBase<TItem> column, bool earlier) =>
        string.Format(System.Globalization.CultureInfo.CurrentCulture, Localize(null, earlier ? "DataGrid.MoveEarlierFormat" : "DataGrid.MoveLaterFormat"), column.DisplayTitle);

    /// <summary>The current layout, as LayoutChanged reports it.</summary>
    public StilDataGridLayout CurrentLayout => new(
        Ordered.Select(c => c.ColumnKey).ToList(),
        new Dictionary<string, string>(_widths),
        _hidden.ToList(),
        _sortColumn?.ColumnKey,
        _sortColumn is null ? StilSortDirection.None : _sortDirection);

    private void ApplyLayout(StilDataGridLayout layout)
    {
        _appliedLayout = layout;
        _order = layout.Order.ToList();
        _widths.Clear();
        foreach (var (key, width) in layout.Widths)
        {
            _widths[key] = width;
        }

        _hidden.Clear();
        _hidden.UnionWith(layout.Hidden);
        UpdateVisible();

        if (layout.SortBy is { } sortBy && layout.SortDirection != StilSortDirection.None)
        {
            _initialSortApplied = true;
            _sortDirection = layout.SortDirection;
            var column = _columns.FirstOrDefault(c => c.ColumnKey == sortBy);
            _sortColumn = column;
            _layoutSortKey = column is null ? sortBy : null;
        }
    }

    private async Task NotifyLayoutAsync()
    {
        _appliedLayout = CurrentLayout;
        await LayoutChanged.InvokeAsync(_appliedLayout);
    }

    private async Task OnColumnResizeAsync(StilColumnResizeEventArgs e)
    {
        _widths[e.Key] = $"{Math.Round(e.Width).ToString(System.Globalization.CultureInfo.InvariantCulture)}px";
        await NotifyLayoutAsync();
    }

    private async Task OnColumnMoveAsync(StilColumnMoveEventArgs e)
    {
        var keys = Ordered.Select(c => c.ColumnKey).ToList();
        if (!keys.Remove(e.Key))
        {
            return;
        }

        var index = e.Before is null ? -1 : keys.IndexOf(e.Before);
        keys.Insert(index < 0 ? keys.Count : index, e.Key);
        _order = keys;
        UpdateVisible();
        await NotifyLayoutAsync();
    }

    private async Task MoveColumnAsync(StilDataGridColumnBase<TItem> column, int step)
    {
        var keys = Ordered.Select(c => c.ColumnKey).ToList();
        var index = keys.IndexOf(column.ColumnKey);
        var target = Math.Clamp(index + step, 0, keys.Count - 1);
        keys.RemoveAt(index);
        keys.Insert(target, column.ColumnKey);
        _order = keys;
        UpdateVisible();
        await NotifyLayoutAsync();
    }

    private async Task ToggleColumnAsync(StilDataGridColumnBase<TItem> column)
    {
        if (!_hidden.Remove(column.ColumnKey) && CanHide(column))
        {
            _hidden.Add(column.ColumnKey);
        }

        UpdateVisible();
        await NotifyLayoutAsync();
    }

    /// <summary>Puts the columns back in their declared order, widths and visibility.</summary>
    public async Task ResetLayoutAsync()
    {
        _order = [];
        _widths.Clear();
        _hidden.Clear();
        UpdateVisible();
        await NotifyLayoutAsync();
    }

    // The consumer's attributes plus the column layout handlers (Razor cannot bind custom events in this assembly).
    private IReadOnlyDictionary<string, object> RootAttributes
    {
        get
        {
            var attributes = AdditionalAttributes is null
                ? new Dictionary<string, object>()
                : AdditionalAttributes.Where(a => a.Key != "class").ToDictionary();
            attributes["onstilcolumnresize"] = EventCallback.Factory.Create<StilColumnResizeEventArgs>(this, OnColumnResizeAsync);
            attributes["onstilcolumnmove"] = EventCallback.Factory.Create<StilColumnMoveEventArgs>(this, OnColumnMoveAsync);
            return attributes;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusRowPending)
        {
            _focusRowPending = false;
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Stil/stil.js");
            await _module.InvokeVoidAsync("focusRow", _table);
        }

        if (_focusEditor && _editing)
        {
            _focusEditor = false;
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Stil/stil.js");
            await _module.InvokeVoidAsync("focusEditor", _table);
        }

        // stil.js places frozen columns and gives the resize handles their width (aria-valuenow).
        if (_visible.Any(c => c.Frozen != StilFrozen.None || IsResizable(c)))
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Stil/stil.js");
            await _module.InvokeVoidAsync("freezeColumns", _table);
        }
    }

    public void Dispose()
    {
        _loadCts?.Cancel();
        _debounceCts?.Cancel();
        _loadCts?.Dispose();
        _debounceCts?.Dispose();
    }
}
