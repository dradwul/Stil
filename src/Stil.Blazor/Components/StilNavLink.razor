@using Microsoft.AspNetCore.Components.Routing
@inherits StilComponentBase
@implements IDisposable
@inject NavigationManager Navigation

@* Wraps Blazor's NavLink, so aria-current="page" follows the current route. Inside a
   StilNavGroup, the current link opens its group. *@
<NavLink href="@Href" Match="Match" @attributes="AdditionalAttributes" class="@Classes("stil-nav-link")">
    @if (Icon is not null)
    {
        <StilIcon Name="@Icon" />
    }
    @ChildContent
    @if (!string.IsNullOrWhiteSpace(Badge))
    {
        <StilBadge Variant="BadgeVariant" Subtle class="stil-ms-auto">@Badge</StilBadge>
    }
</NavLink>

@code {
    [Parameter, EditorRequired]
    public string Href { get; set; } = "";

    /// <summary>Prefix (default) marks the link current for sub-pages too; All only for the exact URL.</summary>
    [Parameter]
    public NavLinkMatch Match { get; set; } = NavLinkMatch.Prefix;

    /// <summary>A built-in or provider icon name shown before the text.</summary>
    [Parameter]
    public string? Icon { get; set; }

    /// <summary>A count or status at the end of the link, for example "12".</summary>
    [Parameter]
    public string? Badge { get; set; }

    [Parameter]
    public StilVariant BadgeVariant { get; set; } = StilVariant.Secondary;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [CascadingParameter]
    private StilNavGroup? Group { get; set; }

    protected override void OnInitialized()
    {
        if (Group is not null)
        {
            Navigation.LocationChanged += OnLocationChanged;
            OpenGroupIfCurrent();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => OpenGroupIfCurrent();

    private void OpenGroupIfCurrent()
    {
        if (Group is not null && IsCurrent(Navigation.Uri))
        {
            Group.OpenForCurrentLink();
        }
    }

    // The same rule as NavLink: the query and fragment are ignored, and Prefix also matches sub-paths.
    private bool IsCurrent(string uri)
    {
        static string Path(string value) => value.Split('?', '#')[0].TrimEnd('/');

        var current = Path(uri);
        var link = Path(Navigation.ToAbsoluteUri(Href).AbsoluteUri);
        if (string.Equals(current, link, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return Match == NavLinkMatch.Prefix
            && current.StartsWith(link + "/", StringComparison.OrdinalIgnoreCase)
            && link.Length > Path(Navigation.BaseUri).Length;
    }

    public void Dispose()
    {
        if (Group is not null)
        {
            Navigation.LocationChanged -= OnLocationChanged;
        }
    }
}
