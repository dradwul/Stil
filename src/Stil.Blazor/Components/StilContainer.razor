@inherits StilComponentBase

<div @attributes="AdditionalAttributes" class="@CssClass">
    @ChildContent
</div>

@code {
    /// <summary>Full width instead of the maximum container width.</summary>
    [Parameter]
    public bool Fluid { get; set; }

    /// <summary>The page content.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string CssClass => Classes("stil-container", Fluid ? "stil-container-fluid" : null);
}
