@inject StilOptions Options

@* Put <StilHead /> in the <head> of App.razor: it adds the stylesheet, the font and the global theme. *@
<link rel="stylesheet" href="@Assets[Minified ? "_content/Stil/stil.min.css" : "_content/Stil/stil.css"]" />
@if (Blocks)
{
    <link rel="stylesheet" href="@Assets[Minified ? "_content/Stil/stil-blocks.min.css" : "_content/Stil/stil-blocks.css"]" />
}
@if ((Font ?? Options.Font)?.StylesheetUrl is { } fontUrl)
{
    <link rel="stylesheet" href="@fontUrl" />
}
@if (Declarations is { Length: > 0 } declarations)
{
    @((MarkupString)$"<style>:root {{ {declarations} }}</style>")
}

@code {
    /// <summary>Use the minified stylesheet. The default is true.</summary>
    [Parameter]
    public bool Minified { get; set; } = true;

    /// <summary>Also adds the stylesheet of the page blocks (Stil.Blazor.Blocks: hero, sections, features and more), for websites.</summary>
    [Parameter]
    public bool Blocks { get; set; }

    /// <summary>The font of this document, instead of the one in the options: such as a site's font stored with its pages.</summary>
    [Parameter]
    public StilFont? Font { get; set; }

    /// <summary>Token overrides for this document, after those in the options: such as a site's theme stored with its pages.</summary>
    [Parameter]
    public StilTheme? Theme { get; set; }

    protected override void OnParametersSet() => (Font ?? Options.Font)?.Validate();

    // The font comes first, so a FontFamily in a theme wins; this document's theme comes last.
    private string Declarations => string.Join(' ', new[]
    {
        (Font ?? Options.Font) is { } font ? $"--stil-font-family: {font.FontFamily}; --stil-font-variation-settings: {font.VariationSettings ?? "normal"};" : null,
        Options.Theme.HasOverrides ? Options.Theme.ToCssDeclarations() : null,
        Theme is { HasOverrides: true } theme ? theme.ToCssDeclarations() : null,
    }.Where(d => d is not null));
}
