@inherits StilComponentBase

<span @attributes="AdditionalAttributes" class="@CssClass">@ChildContent</span>

@code {
    /// <summary>The color. The default is Primary.</summary>
    [Parameter]
    public StilVariant Variant { get; set; } = StilVariant.Primary;

    /// <summary>A light tint with normal text instead of a solid color.</summary>
    [Parameter]
    public bool Subtle { get; set; }

    /// <summary>The badge text.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string CssClass => Classes(
        "stil-badge",
        StilCssClasses.Variant("stil-badge", Variant),
        Subtle ? "stil-badge-subtle" : null);
}
