<div role="alert" @attributes="AdditionalAttributes" class="@CssClass">
    @ChildContent
</div>

@code {
    [Parameter]
    public StilVariant Variant { get; set; } = StilVariant.Info;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => StilCssClasses.Merge(
        $"stil-alert {StilCssClasses.Variant("stil-alert", Variant)}",
        AdditionalAttributes);
}
