<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Stil</PackageId>
    <AssemblyName>Stil.Blazor</AssemblyName>
    <RootNamespace>Stil.Blazor</RootNamespace>
    <Description>Themeable Blazor components built on the Stil CSS class library: forms with validation, a data grid, pickers, tree view, tabs, dropdowns, dialogs and toasts. Fully themeable, with dark mode and WCAG AA colors.</Description>
    <PackageTags>blazor;components;css;datagrid;theme;dark-mode;accessibility;stil</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- XML docs for IntelliSense and the docs site. Not every public member is documented yet. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <InternalsVisibleTo Include="Stil.Blazor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
    <!-- IStringLocalizer<T> for AddStilLocalization(); part of the ASP.NET Core shared framework. -->
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- The built-in icons; the same file generates the stil-icon-* CSS classes. -->
    <EmbeddedResource Include="..\Stil.Css\src\icons.json" LogicalName="Stil.Blazor.icons.json" />
    <!-- The built-in texts in en, sv, nb, da and fi. -->
    <EmbeddedResource Include="Localization\Texts\*.json" LogicalName="Stil.Blazor.Texts.%(Filename).json" WithCulture="false" />
    <Content Remove="Localization\Texts\*.json" />
    <!-- Embeds an app's Locales/*.json for AddStilLocalization(), in apps and in apps that reference them. -->
    <None Include="build\Stil.targets" Pack="true" PackagePath="build\Stil.targets" />
    <None Include="build\Stil.targets" Pack="true" PackagePath="buildTransitive\Stil.targets" />
  </ItemGroup>

  <!--
    The stylesheet is built from src/Stil.Css into src/Stil.Css/dist (committed, so this build
    needs no Node.js). Register the built files as static web assets with that folder as content
    root, so they are served as _content/Stil/stil.css, stil.min.css and stil.js, packed into the NuGet
    package, and picked up live (no copy) when running the demo with "npm run watch".
  -->
  <PropertyGroup>
    <StilCssDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', 'Stil.Css', 'dist'))</StilCssDirectory>
  </PropertyGroup>

  <Target Name="DefineStilCssStaticWebAssets" AfterTargets="ResolveProjectStaticWebAssets" Condition="'$(NoBuild)' != 'true'">
    <ItemGroup>
      <_StilCssCandidate Include="$(StilCssDirectory)stil.css" RelativePath="stil.css" />
      <_StilCssCandidate Include="$(StilCssDirectory)stil.min.css" RelativePath="stil.min.css" />
      <_StilCssCandidate Include="$(StilCssDirectory)stil.js" RelativePath="stil.js" />
    </ItemGroup>

    <DefineStaticWebAssets
      CandidateAssets="@(_StilCssCandidate)"
      FingerprintCandidates="$(StaticWebAssetsFingerprintContent)"
      FingerprintPatterns="@(StaticWebAssetFingerprintPattern)"
      SourceType="Discovered"
      SourceId="$(PackageId)"
      ContentRoot="$(StilCssDirectory)"
      BasePath="$(StaticWebAssetBasePath)">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
      <Output TaskParameter="Assets" ItemName="_StilCssStaticWebAsset" />
    </DefineStaticWebAssets>

    <DefineStaticWebAssetEndpoints
      CandidateAssets="@(_StilCssStaticWebAsset)"
      ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="StaticWebAssetEndpoint" />
    </DefineStaticWebAssetEndpoints>
  </Target>

</Project>
