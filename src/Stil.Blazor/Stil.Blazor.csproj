<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Stil</PackageId>
    <AssemblyName>Stil.Blazor</AssemblyName>
    <RootNamespace>Stil.Blazor</RootNamespace>
    <Version>0.1.0</Version>
    <Description>Themeable Blazor components built on the Stil CSS class library: buttons, forms with validation, lists, cards, tabs, dropdowns, dialogs and toasts.</Description>
    <PackageTags>Blazor;CSS;components;Stil</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    The stylesheet is built from src/Stil.Css into src/Stil.Css/dist (committed, so this build
    needs no Node.js). Register the built files as static web assets with that folder as content
    root, so they are served as _content/Stil/stil.css, stil.min.css and stil.js, packed into the NuGet
    package, and picked up live (no copy) when running the demo with "npm run watch".
  -->
  <PropertyGroup>
    <StilCssDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', 'Stil.Css', 'dist'))</StilCssDirectory>
  </PropertyGroup>

  <Target Name="DefineStilCssStaticWebAssets" AfterTargets="ResolveProjectStaticWebAssets" Condition="'$(NoBuild)' != 'true'">
    <ItemGroup>
      <_StilCssCandidate Include="$(StilCssDirectory)stil.css" RelativePath="stil.css" />
      <_StilCssCandidate Include="$(StilCssDirectory)stil.min.css" RelativePath="stil.min.css" />
      <_StilCssCandidate Include="$(StilCssDirectory)stil.js" RelativePath="stil.js" />
    </ItemGroup>

    <DefineStaticWebAssets
      CandidateAssets="@(_StilCssCandidate)"
      FingerprintCandidates="$(StaticWebAssetsFingerprintContent)"
      FingerprintPatterns="@(StaticWebAssetFingerprintPattern)"
      SourceType="Discovered"
      SourceId="$(PackageId)"
      ContentRoot="$(StilCssDirectory)"
      BasePath="$(StaticWebAssetBasePath)">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
      <Output TaskParameter="Assets" ItemName="_StilCssStaticWebAsset" />
    </DefineStaticWebAssets>

    <DefineStaticWebAssetEndpoints
      CandidateAssets="@(_StilCssStaticWebAsset)"
      ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="StaticWebAssetEndpoint" />
    </DefineStaticWebAssetEndpoints>
  </Target>

</Project>
