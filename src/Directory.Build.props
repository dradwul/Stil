<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    The public API baseline of the packages (Phase 16.2). Every public type and member is listed
    in PublicAPI.Shipped.txt (what a released version has) or PublicAPI.Unshipped.txt (what the
    next version adds), next to the project file. A public API that is not listed (RS0016), or a
    listed one that is gone (RS0017), fails the build, so a change to the public API is always
    a change to these files too, and shows in the pull request. See CONTRIBUTING.md.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
    <!-- The BuildRenderTree that Razor generates for a component is not annotated for nullability. -->
    <NoWarn>$(NoWarn);RS0041</NoWarn>
  </PropertyGroup>

</Project>
