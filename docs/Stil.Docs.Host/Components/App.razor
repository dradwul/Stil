<!DOCTYPE html>
<html lang="en" data-stil-theme="auto">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* tools/export-docs.mjs changes this to the site's path on GitHub Pages, /Stil/. *@
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="stil-logo.svg" />
    @* The font: connected to early, and shown only if it arrives in time, so the text never jumps
       when it loads; a later visit has it from the cache. *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geologica:wght,SHRP@400..600,100&amp;display=optional" rel="stylesheet" />
    @* Plain addresses, not fingerprinted ones, so the exported static files are found as they are. *@
    <link rel="stylesheet" href="_content/Stil/stil.css" />
    <link rel="stylesheet" href="_content/Stil/stil-blocks.css" />
    <link rel="stylesheet" href="_content/Stil.Charts/stil-charts.css" />
    <link rel="stylesheet" href="css/docs.css" />
    <script>
        // Apply the saved color mode before the page shows, so it does not flash.
        try {
            const mode = localStorage.getItem('stil-docs-mode');
            if (mode) document.documentElement.setAttribute('data-stil-theme', mode);
        } catch { }
    </script>
    <HeadOutlet @rendermode="InteractiveWebAssembly" />
</head>

<body class="stil-scope">
    <Routes @rendermode="InteractiveWebAssembly" />

    <div id="blazor-error-ui" class="stil-alert stil-alert-danger" role="alert">
        Something went wrong.
        <a href="." class="reload">Reload</a>
        <button type="button" class="dismiss stil-close" aria-label="Dismiss"></button>
    </div>
    @* Stil's script for the page as it is: menus, dropdowns, scrolling boxes and data grid
       handles work before WebAssembly starts. Blazor later imports the same module. *@
    <script type="module" src="_content/Stil/stil.js"></script>
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script>
        // The page is already readable, so WebAssembly waits for the visitor: it starts on the
        // first scroll, pointer move, key, touch or focus, and the examples come alive. Until
        // then, links load the next page's HTML like any static site.
        (() => {
            const events = ['pointermove', 'pointerdown', 'keydown', 'touchstart', 'wheel', 'scroll', 'focusin'];
            const start = () => {
                events.forEach(name => removeEventListener(name, start, true));
                Blazor.start();
            };
            events.forEach(name => addEventListener(name, start, { capture: true, passive: true }));
        })();
    </script>
</body>

</html>
