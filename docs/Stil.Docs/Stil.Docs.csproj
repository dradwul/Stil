<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The WebAssembly half of the docs site; Stil.Docs.Host renders it on the server first. -->
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <AssemblyName>Stil.Docs</AssemblyName>
    <RootNamespace>Stil.Docs</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Culture data for every language of the language selector. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Stil.Blazor\Stil.Blazor.csproj" />
    <ProjectReference Include="..\..\src\Stil.Charts\Stil.Charts.csproj" />
    <ProjectReference Include="..\..\src\Stil.Markdown\Stil.Markdown.csproj" />
    <ProjectReference Include="..\..\src\Stil.RichText\Stil.RichText.csproj" />
  </ItemGroup>

  <!-- Every example is compiled as a component and also embedded as text, so a page shows the
       live example next to its exact source. -->
  <ItemGroup>
    <EmbeddedResource Include="Examples\**\*.razor" LogicalName="Examples/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The XML documentation of the libraries, embedded so the API tables show each parameter's
       description. -->
  <Target Name="EmbedLibraryXmlDocs" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.xml' and $([System.String]::Copy('%(Filename)').StartsWith('Stil.'))" LogicalName="Docs/%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

</Project>
