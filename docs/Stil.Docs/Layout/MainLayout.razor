@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

@* The color mode is on <html>: App.razor's script sets it from storage before the page shows. *@
<StilThemeProvider class="docs-shell">
    <a class="stil-visually-hidden-focusable docs-skip" href="#main">Skip to content</a>
    <StilNavbar Sticky CollapseBelow="StilBreakpoint.Large">
        @* The navbar makes the brand its home link; the logo is named "Stil". *@
        <Brand>
            <BrandLogo Width="58" Height="28" />
        </Brand>
        <ChildContent>
            <StilNav Label="Main">
                <StilNavLink Href="" Match="NavLinkMatch.All">Docs</StilNavLink>
                <StilNavLink Href="components/buttons">Components</StilNavLink>
                <StilNavLink Href="new-app">New app</StilNavLink>
                <StilNavLink Href="theme-builder">Theme builder</StilNavLink>
                <StilNavLink Href="https://github.com/dradwul/Stil" Icon="@StilIcons.External">GitHub</StilNavLink>
            </StilNav>
            <div class="docs-mobile-nav">
                <DocsNav />
            </div>
        </ChildContent>
        <End>
            <StilLanguageSelector Cultures="Languages" Size="StilSize.Small" AlignEnd />
            <StilSelect TValue="StilThemeMode" Value="_mode" ValueChanged="SetModeAsync" Size="StilSize.Small" aria-label="Color mode" />
        </End>
    </StilNavbar>

    <div class="docs-body">
        <aside class="docs-sidebar" aria-label="Documentation">
            <DocsNav />
        </aside>
        <main id="main" class="docs-main" tabindex="-1">
            @Body
            <DocsPager />
        </main>
    </div>

    <StilDialogHost />
    <StilToastHost />
</StilThemeProvider>

@code {
    private const string ModeKey = "stil-docs-mode";
    // The docs are in English; the language changes the examples and Stil's own texts.
    private static readonly string[] Languages = ["en", "sv", "nb", "da", "fi"];

    private StilThemeMode _mode = StilThemeMode.Auto;

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    // The saved mode, for the select: storage is in the browser, so it is read after the first render.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", ModeKey);
            if (Enum.TryParse<StilThemeMode>(saved, ignoreCase: true, out var mode) && mode != _mode)
            {
                _mode = mode;
                StateHasChanged();
            }
        }
        catch (JSException)
        {
            // Storage can be blocked; the default mode is fine.
        }
    }

    private async Task SetModeAsync(StilThemeMode mode)
    {
        _mode = mode;
        var value = mode.ToString().ToLowerInvariant();
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", ModeKey, value);
            await JS.InvokeVoidAsync("document.documentElement.setAttribute", "data-stil-theme", value);
        }
        catch (JSException)
        {
        }
    }

    // Scroll to the top on a new page; keep the position for links to a heading on the same page.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!e.Location.Contains('#'))
        {
            _ = JS.InvokeVoidAsync("scrollTo", 0, 0);
        }
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
