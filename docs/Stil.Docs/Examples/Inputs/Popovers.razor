@* Opens without JavaScript, closes on an outside click or Escape. Manual keeps it open for a form. *@
<div class="stil-cluster">
    <StilPopover Text="What is this?" Title="Order number">
        <p>The number on your receipt, for example 1042.</p>
    </StilPopover>
    <StilPopover IconOnly AriaLabel="Filters" Manual Title="Filters">
        <Toggle><StilIcon Name="@StilIcons.Filter" /></Toggle>
        <ChildContent>
            <StilSwitch @bind-Value="_paidOnly" Label="Paid orders only" />
        </ChildContent>
    </StilPopover>
</div>

@code {
    private bool _paidOnly;
}
