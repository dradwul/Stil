        <StilButton Variant="StilVariant.Secondary">Save draft</StilButton>
    </StilTooltip>
    <StilTooltip Text="Shown below" Position="StilTooltipPosition.Bottom">
        <StilButton Appearance="StilButtonAppearance.Ghost">Below</StilButton>
