<StilTable Items="_orders">
    <Columns>
        <StilTableColumn Title="Order" Value="@(o => $"#{o.Id}")" />
        <StilTableColumn Title="Customer">
            <Template>
                <StilCluster>
                    <StilAvatar Name="@context.Contact" Size="StilSize.Small" />
                    <span>@context.Customer</span>
                </StilCluster>
            </Template>
        </StilTableColumn>
        <StilTableColumn Title="Status">
            <Template>
                <StilBadge Variant="@(context.Paid ? StilVariant.Success : StilVariant.Warning)" Subtle>
                    @(context.Paid ? "Paid" : "Pending")
                </StilBadge>
            </Template>
        </StilTableColumn>
        <StilTableColumn Title="Amount (€)" Value="@(o => o.Amount)" Format="N2" Align="StilTextAlign.End" />
    </Columns>
</StilTable>

@code {
    private static readonly Order[] _orders =
    [
        new(1044, "Kallio Design Oy", "Aino Kallio", 455.2m, false),
        new(1043, "Berglund Outdoor", "Erik Berglund", 2078.9m, true),
        new(1042, "Nordvik Supply", "Ingrid Nordvik", 1499.5m, false),
    ];

    private sealed record Order(int Id, string Customer, string Contact, decimal Amount, bool Paid);
}
