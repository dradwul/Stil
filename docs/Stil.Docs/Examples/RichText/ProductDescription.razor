@using System.ComponentModel.DataAnnotations
@* A product description written with the toolbar, or pasted from a web page or Word. *@
<EditForm Model="_product" OnValidSubmit="Save" class="stil-form">
    <DataAnnotationsValidator />
    <StilRichTextEditor @bind-Value="_product.Description" Label="Description" Placeholder="Describe the product…" />
    <StilButton Type="submit">Save</StilButton>
</EditForm>

@if (_saved is not null)
{
    <div class="stil-card stil-mt-4">
        <StilRichTextView Value="@_saved" />
    </div>
    <details class="stil-mt-2">
        <summary class="stil-text-muted stil-fs-sm">The saved HTML</summary>
        <pre class="stil-fs-xs"><code>@_saved</code></pre>
    </details>
}

@code {
    private readonly Product _product = new()
    {
        Description = "<h2>Oak desk</h2><p>A <strong>solid oak</strong> desk with a <em>cable tray</em>.</p><ul><li>160 × 80 cm</li><li>Oiled finish</li></ul>",
    };

    private string? _saved;

    private void Save() => _saved = _product.Description;

    private sealed class Product
    {
        [Required(ErrorMessage = "Write a description.")]
        [MaxLength(4000)]
        public string? Description { get; set; }
    }
}
