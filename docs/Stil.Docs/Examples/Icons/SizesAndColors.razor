<div class="stil-stack stil-gap-3">
    <p class="stil-mb-0"><StilIcon Name="@StilIcons.Folder" /> Icons are 1em, so they follow the text.</p>
    <p class="stil-fs-xl stil-mb-0"><StilIcon Name="@StilIcons.Folder" /> Larger text, larger icon.</p>
    <div class="stil-cluster stil-gap-3">
        <StilIcon Name="@StilIcons.Home" Size="16px" />
        <StilIcon Name="@StilIcons.Home" Size="24px" />
        <StilIcon Name="@StilIcons.Home" Size="2.5rem" />
    </div>
    <div class="stil-cluster stil-gap-3">
        <span class="stil-text-success"><StilIcon Name="@StilIcons.Success" /> Delivered</span>
        <span class="stil-text-warning"><StilIcon Name="@StilIcons.Warning" /> Delayed</span>
        <span class="stil-text-danger"><StilIcon Name="@StilIcons.Danger" /> Cancelled</span>
    </div>
</div>
