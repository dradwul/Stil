@page "/"
@inject NavigationManager Navigation

<StilSeo Title="Stil: themeable CSS and Blazor components"
         Description="A themeable CSS library and a Blazor component library built on it: light and dark mode, WCAG AA contrast, and your brand in a few tokens. Free and open source (MIT)."
         StructuredData="@([StilStructuredData.WebSite("Stil", Navigation.BaseUri)])" />

<section class="docs-hero">
    <p class="docs-eyebrow">Stil 1.3</p>
    <h1 tabindex="-1">A themeable CSS library, and Blazor components built on it</h1>
    <p class="docs-lead">
        Change a few tokens and both follow your brand, in light and dark mode, with WCAG AA contrast.
        Pick the one you build with.
    </p>
</section>

<div class="docs-paths">
    <StilCard Title="Stil CSS" Subtitle="For HTML and any framework" HeadingLevel="2">
        <ChildContent>
            <p>About 24 kB gzipped: components, a 12-column grid and about 900 utilities. Every class starts with <code>stil-</code>, so it lives next to other CSS.</p>
            <CodeBlock Language="shell" Code="npm install stil-css" />
        </ChildContent>
        <Footer>
            <StilButton Href="get-started/css">Install Stil CSS</StilButton>
        </Footer>
    </StilCard>
    <StilCard Title="Stil for Blazor" Subtitle="Components that include the CSS" HeadingLevel="2">
        <ChildContent>
            <p>About 95 components: forms with validation, a data grid, pickers, dialogs and toasts. You don't need Stil CSS as well.</p>
            <CodeBlock Language="shell" Code="dotnet add package Stil" />
        </ChildContent>
        <Footer>
            <StilButton Href="get-started">Install for Blazor</StilButton>
        </Footer>
    </StilCard>
</div>

<p class="docs-facts">
    No dependencies · 163 contrast checks in CI · Free and open source (MIT) ·
    <a href="theme-builder">Build a theme</a>
</p>
