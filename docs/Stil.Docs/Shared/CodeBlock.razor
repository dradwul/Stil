@inject IJSRuntime JS
@inject IStilToastService Toasts

@* A block of code with a copy button. *@
<div class="docs-code">
    <div class="docs-code-bar">
        <span class="docs-code-language">@Language</span>
        <StilButton Size="StilSize.Small" Appearance="StilButtonAppearance.Ghost" Variant="StilVariant.Secondary"
                    OnClick="CopyAsync" aria-label="@($"Copy {Language} code")">Copy</StilButton>
    </div>
    <pre tabindex="0"><code>@Code</code></pre>
</div>

@code {
    [Parameter, EditorRequired]
    public string Code { get; set; } = "";

    /// <summary>The language shown in the bar, for example razor, csharp, html or css.</summary>
    [Parameter]
    public string Language { get; set; } = "razor";

    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Code);
            Toasts.Success("Copied to the clipboard.");
        }
        catch (JSException)
        {
            Toasts.Error("Could not copy. Select the code and copy it instead.");
        }
    }
}
