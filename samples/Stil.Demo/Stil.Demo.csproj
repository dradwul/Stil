<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <AssemblyName>Stil.Demo</AssemblyName>
    <RootNamespace>Stil.Demo</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Stil.Blazor\Stil.Blazor.csproj" />
    <ProjectReference Include="..\..\src\Stil.Charts\Stil.Charts.csproj" />
    <ProjectReference Include="..\..\src\Stil.Markdown\Stil.Markdown.csproj" />
    <ProjectReference Include="..\..\src\Stil.RichText\Stil.RichText.csproj" />
  </ItemGroup>

  <!-- A project reference does not import the package's build targets (they embed Locales/*.json). -->
  <Import Project="..\..\src\Stil.Blazor\build\Stil.targets" />

</Project>
