@inherits LayoutComponentBase

@* The whole app is themed with StilThemeProvider. The dialog and toast hosts are inside it, so
   dialogs and toasts follow the selected mode and palette. *@
<StilThemeProvider Mode="_mode" Theme="Palettes[_palette]" class="demo-shell">
    <StilNavbar Sticky CollapseBelow="StilBreakpoint.Medium">
        <Brand>
            <img src="stil-logo.svg" alt="" width="64" height="31" />
            Stil for Blazor
        </Brand>
        <ChildContent>
            <StilNav Label="Main">
                <StilNavLink Href="" Match="NavLinkMatch.All" Icon="@StilIcons.Home">Components</StilNavLink>
                <StilNavLink Href="orders" Badge="CRUD">Orders</StilNavLink>
            </StilNav>
        </ChildContent>
        <End>
            <StilSelect @bind-Value="_mode" Size="StilSize.Small" aria-label="Color mode" />
            <StilSelect @bind-Value="_palette" Items="Palettes.Keys" Size="StilSize.Small" aria-label="Palette" />
            <StilLanguageSelector Cultures="Cultures" Size="StilSize.Small" AlignEnd />
        </End>
    </StilNavbar>

    <main class="stil-container stil-py-5">
        @Body
    </main>

    <StilDialogHost />
    <StilToastHost />
</StilThemeProvider>

<footer class="demo-host-content">
    The demo app's own footer sits outside Stil's theme and scope.
</footer>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    /// <summary>The languages the demo offers; Program.cs supports the same ones.</summary>
    public static readonly string[] Cultures = ["en", "sv", "nb", "da", "fi", "ar"];

    private static readonly Dictionary<string, StilTheme> Palettes = new()
    {
        ["Teal"] = new(),
        ["Purple"] = new() { Primary = "#7048e8", Secondary = "#d0bfff" },
        ["Forest"] = new() { Primary = "#2b8a3e", Secondary = "#b2f2bb" },
        ["Sunset"] = new() { Primary = "#e8590c", Secondary = "#ffd8a8" },
    };

    private StilThemeMode _mode = StilThemeMode.Light;
    private string _palette = "Teal";
}
