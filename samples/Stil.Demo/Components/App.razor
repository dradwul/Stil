<!DOCTYPE html>
<html lang="@Language" dir="@StilCulture.Direction()">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Didact+Gothic&display=swap" rel="stylesheet" />
    @* Stil's stylesheet and the global theme from AddStil(). *@
    <StilHead />
    <link rel="stylesheet" href="@Assets["_content/Stil.Charts/stil-charts.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body class="stil-scope">
    <Routes @rendermode="InteractiveServer" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // The UI culture from the culture cookie; the screenshot tests run with the invariant culture.
    private static string Language => CultureInfo.CurrentUICulture.Name is { Length: > 0 } name ? name : "en";
}
