@page "/"
@inject IStilDialogService Dialogs
@inject IStilToastService Toasts

<PageTitle>Stil for Blazor</PageTitle>

<h1>Components</h1>
<p class="stil-text-muted">
    Every Stil for Blazor component, rendered interactively. For the plain CSS classes, open
    <code>samples/Stil.Html/index.html</code>; for a full CRUD example, see <a href="orders">Orders</a>.
</p>

<section class="demo-section" aria-labelledby="buttons">
    <h2 id="buttons">Buttons</h2>
    <div class="stil-stack">
        <div class="stil-cluster">
            @foreach (var variant in Enum.GetValues<StilVariant>())
            {
                <StilButton Variant="variant">@variant</StilButton>
            }
        </div>
        <div class="stil-cluster">
            <StilButton Appearance="StilButtonAppearance.Outline">Outline</StilButton>
            <StilButton Appearance="StilButtonAppearance.Ghost">Ghost</StilButton>
            <StilButton Size="StilSize.Small">Small</StilButton>
            <StilButton Size="StilSize.Large">Large</StilButton>
            <StilButton Disabled>Disabled</StilButton>
            <StilButton Loading="_saving" OnClick="SaveAsync">@(_saving ? "Saving" : "Save (loading)")</StilButton>
            <StilButton Pressed="_bold" OnClick="() => _bold = !_bold" Appearance="StilButtonAppearance.Outline" Variant="StilVariant.Secondary">Bold (toggle)</StilButton>
            <StilButton Href="orders" Appearance="StilButtonAppearance.Ghost">Link to orders</StilButton>
        </div>
    </div>
</section>

<section class="demo-section" aria-labelledby="lists">
    <h2 id="lists">Lists and badges</h2>
    <p>A row with a title and a status, on its own or grouped in a <code>StilList</code>.</p>
    <div class="stil-stack">
        <StilListItem Title="Order #1042" Badge="Delivered" BadgeVariant="StilVariant.Success" />

        <StilList>
            <StilListItem Title="Order #1043" Description="Berglund Outdoor · 7 Oct 2026" Badge="Shipped" BadgeVariant="StilVariant.Info" />
            <StilListItem Title="Order #1044" Description="Kallio Design Oy · 8 Oct 2026" Badge="Pending" BadgeVariant="StilVariant.Warning" BadgeSubtle />
            <StilListItem Title="Order #1045" Description="Østerby Marine · 9 Oct 2026" Badge="Cancelled" BadgeVariant="StilVariant.Danger"
                          OnClick="@(() => Toasts.Info("You clicked order #1045."))" />
            <StilListItem Title="Anna Berg" Description="Administrator">
                <Start><StilAvatar Name="Anna Berg" Size="StilSize.Small" /></Start>
                <End>
                    <StilBadge Variant="StilVariant.Secondary" Subtle>Owner</StilBadge>
                    <StilButton Size="StilSize.Small" Appearance="StilButtonAppearance.Ghost">Edit</StilButton>
                </End>
            </StilListItem>
        </StilList>

        <div class="stil-cluster">
            @foreach (var variant in Enum.GetValues<StilVariant>())
            {
                <StilBadge Variant="variant">@variant</StilBadge>
            }
            <StilBadge Variant="StilVariant.Danger" Subtle>Subtle</StilBadge>
        </div>
    </div>
</section>

<section class="demo-section" aria-labelledby="cards">
    <h2 id="cards">Cards and alerts</h2>
    <div class="stil-grid">
        <StilCard Title="Monthly report" Subtitle="October 2026" HeadingLevel="3" class="stil-col-md-6">
            <ChildContent>
                <p>Revenue is up 12% on last month.</p>
            </ChildContent>
            <Footer>
                <StilButton Appearance="StilButtonAppearance.Ghost">Dismiss</StilButton>
                <StilButton>Open report</StilButton>
            </Footer>
        </StilCard>
        <StilCard Title="Team" HeadingLevel="3" class="stil-col-md-6">
            <HeaderActions>
                <StilButton Size="StilSize.Small" Appearance="StilButtonAppearance.Outline">Invite</StilButton>
            </HeaderActions>
            <ChildContent>
                <p>Four members, one pending invitation.</p>
            </ChildContent>
        </StilCard>
    </div>
    <div class="stil-stack stil-mt-4">
        <StilAlert Variant="StilVariant.Success" Title="Saved">Your changes are live.</StilAlert>
        <StilAlert Variant="StilVariant.Warning" Subtle Dismissible OnDismiss="@(() => Toasts.Info("Alert dismissed."))">
            Scheduled maintenance on Sunday at 02:00.
        </StilAlert>
    </div>
</section>

<section class="demo-section" aria-labelledby="forms">
    <h2 id="forms">Forms and validation</h2>
    <p>Fields bind with <code>@@bind-Value</code> and show DataAnnotations messages inside an <code>EditForm</code>.</p>
    <StilCard>
        <EditForm Model="_signup" OnValidSubmit="SignUpAsync" class="stil-form" novalidate>
            <DataAnnotationsValidator />
            <div class="stil-grid">
                <StilTextBox @bind-Value="_signup.Name" Label="Name" Hint="As it appears on invoices." class="stil-col-md-6" autocomplete="name" />
                <StilTextBox @bind-Value="_signup.Email" Label="Email" Type="email" class="stil-col-md-6" autocomplete="email" />
                <StilNumeric @bind-Value="_signup.Seats" Label="Seats" Min="1" Max="500" class="stil-col-md-4" />
                <StilSelect @bind-Value="_signup.Plan" Label="Plan" class="stil-col-md-4" />
                <StilDatePicker @bind-Value="_signup.StartDate" Label="Start date" class="stil-col-md-4" />
            </div>
            <StilRadioGroup @bind-Value="_signup.Billing" Label="Billing" Inline />
            <StilGrid>
                <StilTextBox @bind-Value="_signup.Website" Label="Website" PrependText="https://" class="stil-col-md-6" />
                <StilNumeric @bind-Value="_signup.Budget" Label="Monthly budget" AppendText="€" class="stil-col-md-6" />
            </StilGrid>
            <StilTextBox @bind-Value="_search" Label="Search with a button" Type="search">
                <Append><StilButton Appearance="StilButtonAppearance.Outline" OnClick="@(() => Toasts.Info($"Searching for {_search}"))"><StilIcon Name="@StilIcons.Search" /> Search</StilButton></Append>
            </StilTextBox>
            <StilTextArea @bind-Value="_signup.Notes" Label="Notes" Rows="2" />
            <StilSwitch @bind-Value="_signup.Newsletter" Label="Send me product updates" />
            <StilCheckbox @bind-Value="_signup.AcceptTerms" Label="I accept the terms" />
            <div class="stil-cluster">
                <StilButton Type="submit">Sign up</StilButton>
                <StilButton Appearance="StilButtonAppearance.Ghost" OnClick="() => _signup = new()">Reset</StilButton>
            </div>
        </EditForm>
    </StilCard>
</section>

<section class="demo-section" aria-labelledby="tabs">
    <h2 id="tabs">Tabs</h2>
    <StilTabs @bind-ActiveId="_pillTab" Appearance="StilTabsAppearance.Pills" KeepAlive Label="Report period" class="stil-mb-4">
        <StilTab Id="week" Title="Week"><StilTextBox @bind-Value="_note" Label="Note (kept when switching tabs)" /></StilTab>
        <StilTab Id="month" Title="Month"><p>Selected: @_pillTab</p></StilTab>
        <StilTab Id="year" Title="Year"><p>Selected: @_pillTab</p></StilTab>
    </StilTabs>
    <StilTabs @bind-ActiveIndex="_tab" Label="Account settings">
        <StilTab Title="Profile"><p>Profile settings. Use the arrow keys to move between tabs.</p></StilTab>
        <StilTab Title="Notifications"><p>Choose what we email you about.</p></StilTab>
        <StilTab Title="Billing" Disabled><p>Not available on the free plan.</p></StilTab>
        <StilTab Title="Security"><p>Two-factor authentication is on.</p></StilTab>
    </StilTabs>
</section>

<section class="demo-section" aria-labelledby="data">
    <h2 id="data">Tables, accordions and layout</h2>
    <StilStack Gap="5">
        <StilCard Title="Recent orders" HeadingLevel="3">
            <HeaderActions>
                <StilButtonGroup Label="View">
                    <StilButton Size="StilSize.Small" Appearance="StilButtonAppearance.Outline" Variant="StilVariant.Secondary" Pressed="!_compact" OnClick="() => _compact = false">Comfortable</StilButton>
                    <StilButton Size="StilSize.Small" Appearance="StilButtonAppearance.Outline" Variant="StilVariant.Secondary" Pressed="_compact" OnClick="() => _compact = true">Compact</StilButton>
                </StilButtonGroup>
            </HeaderActions>
            <ChildContent>
                <div class="stil-card-flush">
                    <StilTable TItem="DemoOrder" Items="PagedOrders" Hover Compact="_compact" Caption="Click a row to open it"
                               OnRowClick="@(order => Toasts.Info($"Order #{order.Id}: {order.Customer}"))">
                        <Columns>
                            <StilColumn Title="Order" Field="@(o => $"#{o.Id}")" />
                            <StilColumn Title="Customer">
                                <Template><StilCluster><StilAvatar Name="@context.Customer" Size="StilSize.Small" />@context.Customer</StilCluster></Template>
                            </StilColumn>
                            <StilColumn Title="Amount" Field="@(o => o.Amount)" Format="N2" Align="StilTextAlign.End" />
                            <StilColumn Title="Status">
                                <Template><StilBadge Variant="@(context.Status == "Paid" ? StilVariant.Success : StilVariant.Warning)">@context.Status</StilBadge></Template>
                            </StilColumn>
                        </Columns>
                    </StilTable>
                </div>
            </ChildContent>
            <Footer>
                <StilPagination @bind-Page="_tablePage" TotalItems="_tableOrders.Length" PageSize="3" Size="StilSize.Small" />
            </Footer>
        </StilCard>

        <StilAccordion>
            <StilAccordionItem Title="How long does shipping take?" Open>Two to four working days within the Nordics.</StilAccordionItem>
            <StilAccordionItem Title="Can I return an order?">Yes, within 30 days. Opening another item closes this one.</StilAccordionItem>
            <StilAccordionItem Title="Do you ship abroad?">Within the EU, yes.</StilAccordionItem>
        </StilAccordion>

        <StilSidebarLayout SidebarLabel="Example sidebar">
            <Sidebar>
                <StilNav Vertical Pills Label="Example sections">
                    <StilNavLink Href="" Match="NavLinkMatch.All">Overview</StilNavLink>
                    <StilNavLink Href="settings">Settings</StilNavLink>
                </StilNav>
            </Sidebar>
            <ChildContent>
                <StilGrid Gap="3">
                    @foreach (var (label, value) in _stats)
                    {
                        <StilCol Span="12" SpanSm="6" SpanLg="3">
                            <StilCard><p class="stil-text-muted stil-fs-sm stil-mb-1">@label</p><p class="stil-fs-xl stil-mb-0">@value</p></StilCard>
                        </StilCol>
                    }
                </StilGrid>
            </ChildContent>
        </StilSidebarLayout>
    </StilStack>
</section>

<section class="demo-section" aria-labelledby="navigation">
    <h2 id="navigation">Icons and navigation</h2>
    <div class="stil-stack">
        <div class="stil-cluster stil-gap-3 stil-fs-lg">
            @foreach (var name in StilIcons.BuiltIn.Keys)
            {
                <StilTooltip Text="@name"><StilIcon Name="@name" Label="@name" /></StilTooltip>
            }
        </div>
        <StilBreadcrumbs Items="_crumbs" />
        <div class="stil-cluster stil-gap-4">
            <StilPagination @bind-Page="_page" TotalItems="480" PageSize="20" />
            <span class="stil-text-muted">Page @_page of 24</span>
        </div>
        <StilPagination @bind-Page="_page" PageCount="24" ShowFirstLast Size="StilSize.Small" MaxVisiblePages="9" />
        <StilNav Pills Label="Example">
            <StilNavLink Href="" Match="NavLinkMatch.All" Icon="@StilIcons.Home">Overview</StilNavLink>
            <StilNavLink Href="orders" Icon="@StilIcons.Filter" Badge="4">Orders</StilNavLink>
            <StilNavLink Href="reports" Icon="@StilIcons.Info">Reports</StilNavLink>
        </StilNav>
        <div class="stil-cluster">
            <StilButton Appearance="StilButtonAppearance.Outline" OnClick="() => _drawerOpen = true">
                <StilIcon Name="@StilIcons.Filter" /> Open drawer
            </StilButton>
            <StilButton Appearance="StilButtonAppearance.Outline" OnClick="() => _drawerEndOpen = true">
                Drawer from the end <StilIcon Name="@StilIcons.ArrowRight" />
            </StilButton>
        </div>
    </div>
</section>

<StilDrawer @bind-Open="_drawerOpen" Title="Filters">
    <ChildContent>
        <div class="stil-form">
            <StilSelect @bind-Value="_drawerStatus" Label="Status" Items="_statuses" />
            <StilSwitch @bind-Value="_drawerExpress" Label="Express only" />
        </div>
    </ChildContent>
    <Footer>
        <StilButton Appearance="StilButtonAppearance.Ghost" Variant="StilVariant.Secondary" OnClick="() => _drawerOpen = false">Cancel</StilButton>
        <StilButton OnClick="() => _drawerOpen = false">Apply</StilButton>
    </Footer>
</StilDrawer>

<StilDrawer @bind-Open="_drawerEndOpen" Title="Order #1043" Position="StilDrawerPosition.End" Width="26rem">
    <StilList Flush>
        <StilListItem Title="Customer" Description="Berglund Outdoor" />
        <StilListItem Title="Amount" Description="2,078.90 €" />
        <StilListItem Title="Status" Badge="Shipped" BadgeVariant="StilVariant.Info" />
    </StilList>
</StilDrawer>

<section class="demo-section" aria-labelledby="menus">
    <h2 id="menus">Dropdowns and tooltips</h2>
    <div class="stil-cluster">
        <StilDropdown Text="Actions" Appearance="StilButtonAppearance.Outline">
            <StilDropdownHeader>Order #1043</StilDropdownHeader>
            <StilDropdownItem OnClick="@(() => Toasts.Info("Edit clicked."))">Edit</StilDropdownItem>
            <StilDropdownItem OnClick="@(() => Toasts.Info("Duplicated."))">Duplicate</StilDropdownItem>
            <StilDropdownItem Disabled>Archive</StilDropdownItem>
            <StilDropdownDivider />
            <StilDropdownItem class="stil-text-danger" OnClick="DeleteDemoAsync">Delete…</StilDropdownItem>
        </StilDropdown>
        <StilDropdown Text="@(_menuOpen ? "Open" : "Closed")" @bind-Open="_menuOpen" Items="_menuItems"
                      Appearance="StilButtonAppearance.Outline" Variant="StilVariant.Secondary" />
        <StilDropdown Text="Disabled" Disabled Appearance="StilButtonAppearance.Outline" Variant="StilVariant.Secondary" />
        <StilCloseButton Label="Close the example" OnClick="@(() => Toasts.Info("Close button clicked."))" />
        <StilTooltip Text="Saves without leaving the page">
            <StilButton Variant="StilVariant.Secondary">Hover me</StilButton>
        </StilTooltip>
        <StilTooltip Text="Shown below" Position="StilTooltipPosition.Bottom">
            <StilButton Appearance="StilButtonAppearance.Ghost">And me</StilButton>
        </StilTooltip>
    </div>
</section>

<section class="demo-section" aria-labelledby="feedback">
    <h2 id="feedback">Progress, spinners, dialogs and toasts</h2>
    <div class="stil-stack">
        <StilProgress Value="_progress" Label="Upload" />
        <StilProgress Value="72" Label="Storage" ShowValue Size="StilSize.Large" Variant="StilVariant.Success" />
        <div class="stil-cluster">
            <StilButton Size="StilSize.Small" Appearance="StilButtonAppearance.Outline" OnClick="() => _progress = Math.Min(100, _progress + 10)">+10%</StilButton>
            <StilSpinner Size="StilSize.Small" />
            <StilSpinner Variant="StilVariant.Primary" />
        </div>
        <div class="stil-cluster">
            <StilButton OnClick="() => _dialogOpen = true">Open dialog</StilButton>
            <StilButton Variant="StilVariant.Danger" Appearance="StilButtonAppearance.Outline" OnClick="DeleteDemoAsync">Confirm dialog</StilButton>
            <StilButton Variant="StilVariant.Success" Appearance="StilButtonAppearance.Outline" OnClick="@(() => Toasts.Success("Order #1043 shipped.", "Shipped"))">Success toast</StilButton>
            <StilButton Variant="StilVariant.Danger" Appearance="StilButtonAppearance.Outline" OnClick="@(() => Toasts.Error("The payment provider did not respond."))">Error toast</StilButton>
        </div>
    </div>
</section>

<section class="demo-section" aria-labelledby="pickers">
    <h2 id="pickers">Pickers, uploads and KPI cards</h2>
    <div class="stil-grid stil-mb-4">
        <StilStatCard Label="Revenue" Value="48,200 €" Icon="@StilIcons.Success" Trend="+12.4%" TrendDirection="StilTrendDirection.Up"
                      Description="vs last month" class="stil-col-sm-6 stil-col-lg-4" />
        <StilStatCard Label="Open tickets" Value="17" Trend="-3" TrendDirection="StilTrendDirection.Down" TrendVariant="StilVariant.Success"
                      Description="since Monday" class="stil-col-sm-6 stil-col-lg-4" />
        <StilStatCard Label="Orders" Value="64" Href="orders" Description="Open the orders page" class="stil-col-sm-6 stil-col-lg-4" />
    </div>
    <div class="stil-grid">
        <StilAutocomplete TItem="string" @bind-Value="_city" Items="_cities" Label="City" Placeholder="Start typing…"
                          Hint="@($"Chosen: {_city ?? "nothing"}")" class="stil-col-md-6" />
        <StilAutocomplete TItem="string" @bind-Value="_country" Search="SearchCountriesAsync" Label="Country (searched on the server)"
                          Placeholder="Type at least 1 letter" Hint="Simulates a 400 ms server call." class="stil-col-md-6" />
        <StilMultiSelect TItem="string" @bind-Value="_tags" Items="_tagOptions" Label="Tags" Placeholder="Add tags"
                         Hint="Backspace removes the last tag." class="stil-col-md-6" />
        <StilDateRangePicker TValue="DateOnly?" @bind-Start="_from" @bind-End="_to" Label="Delivery window" class="stil-col-md-6" />
        <StilFileUpload Label="Attachments" Multiple Accept=".pdf,image/*" MaxFileSize="5 * 1024 * 1024" MaxFiles="3"
                        Hint="PDF or images, at most 5 MB each and 3 files." class="stil-col-12" />
    </div>
</section>

<section class="demo-section" aria-labelledby="trees">
    <h2 id="trees">Tree view and navigation groups</h2>
    <div class="stil-grid">
        <div class="stil-col-md-6">
            <StilTreeView TItem="DemoNode" Items="_tree" ChildrenSelector="n => n.Children" ItemText="n => n.Name"
                          ItemIcon="n => n.Children.Length > 0 ? StilIcons.Folder : StilIcons.File"
                          @bind-SelectedItem="_node" @bind-ExpandedItems="_expanded" Label="Project files" />
            <p class="stil-text-muted stil-fs-sm stil-mt-2">Selected: @(_node?.Name ?? "nothing"). Use the arrow keys, Home and End.</p>
        </div>
        <div class="stil-col-md-6">
            <StilNav Vertical Label="Sections">
                <StilNavLink Href="" Match="NavLinkMatch.All" Icon="@StilIcons.Home">Components</StilNavLink>
                <StilNavGroup Title="Sales" Icon="@StilIcons.Folder">
                    <StilNavLink Href="orders">Orders</StilNavLink>
                    <StilNavLink Href="orders?view=invoices">Invoices</StilNavLink>
                </StilNavGroup>
                <StilNavGroup Title="Help" Icon="@StilIcons.Info" @bind-Expanded="_helpOpen">
                    <StilNavLink Href="https://github.com/dradwul/StilCSS#readme" Icon="@StilIcons.External">Documentation</StilNavLink>
                    <StilNavLink Href="https://github.com/dradwul/StilCSS/issues" Icon="@StilIcons.External">Report an issue</StilNavLink>
                </StilNavGroup>
            </StilNav>
        </div>
    </div>
</section>

<section class="demo-section" aria-labelledby="charts">
    <h2 id="charts">Charts</h2>
    <p>From the separate <code>Stil.Charts</code> package: SVG charts that follow the theme and dark mode.</p>
    <div class="stil-grid">
        <div class="stil-col-lg-7">
            <StilLineChart Items="_revenue" Category="m => m.Month" Title="Revenue" Description="Thousands of euros" Format="N0" Height="260">
                <StilChartSeries Name="2025" Value="m => m.LastYear" />
                <StilChartSeries Name="2026" Value="m => m.ThisYear" />
            </StilLineChart>
        </div>
        <div class="stil-col-lg-5">
            <StilDonutChart Items="_channels" Category="c => c.Name" Title="Orders by channel" Format="N0" Height="180">
                <StilChartSeries Name="Orders" Value="c => c.Orders" />
            </StilDonutChart>
        </div>
        <div class="stil-col-lg-7">
            <StilBarChart Items="_revenue" Category="m => m.Month" Title="Revenue, stacked" Format="N0" Height="220" Stacked>
                <StilChartSeries Name="2025" Value="m => m.LastYear" />
                <StilChartSeries Name="2026" Value="m => m.ThisYear" />
            </StilBarChart>
        </div>
        <div class="stil-col-lg-5">
            <StilBarChart Items="_channels" Category="c => c.Name" Title="Orders by channel" Format="N0"
                          Orientation="StilChartOrientation.Horizontal" ShowValues>
                <StilChartSeries Name="Orders" Value="c => c.Orders" />
            </StilBarChart>
            <StilSparkline Values="_weekly" Label="Orders per week, last 10 weeks" Area class="stil-mt-4" />
        </div>
    </div>
</section>

<section class="demo-section" aria-labelledby="calendar">
    <h2 id="calendar">Calendar and planner</h2>
    <p>
        One list of events in three views. Drag an event in the week to move or resize it, drag on empty time or click
        a free block to create one, and click a day in the month twice to open its week.
    </p>
    <StilWeekPlanner TItem="DemoEvent" Items="_events" Start="e => e.Start" End="e => e.End" Title="e => e.Title"
                     Variant="e => e.Variant" Color="e => e.Color" Details="e => e.Place" Draft="e => e.Draft"
                     View="StilWeekView.WorkWeek" @bind-Date="_plannerDate" Now="DemoNow" Culture="_calendarCulture"
                     HeadingLevel="3" Editable OnItemClick="ShowEvent" OnItemChange="MoveEvent" OnSlotSelect="CreateEvent" />
    <div class="stil-grid stil-mt-4">
        <div class="stil-col-lg-7">
            <StilCalendar TItem="DemoEvent" Items="_events" Start="e => e.Start" End="e => e.End" Title="e => e.Title"
                          Variant="e => e.Variant" Color="e => e.Color" Details="e => e.Place" Draft="e => e.Draft"
                          Now="DemoNow" Culture="_calendarCulture" HeadingLevel="3" @bind-SelectedDate="_calendarDate"
                          OnItemClick="ShowEvent" OnDateOpen="d => _plannerDate = d" />
        </div>
        <div class="stil-col-lg-5">
            <StilAgenda TItem="DemoEvent" Items="_events" Start="e => e.Start" End="e => e.End" Title="e => e.Title"
                        Variant="e => e.Variant" Color="e => e.Color" Details="e => e.Place" Draft="e => e.Draft"
                        Now="DemoNow" Culture="_calendarCulture" HeadingLevel="3" Days="3" OnItemClick="ShowEvent" />
        </div>
    </div>
</section>

<section class="demo-section" aria-labelledby="datagrid">
    <h2 id="datagrid">Data grid</h2>
    <p>
        <code>StilDataGrid</code> with sorting, filters, paging and selection is on the <a href="orders">Orders</a> page.
        This one renders 10,000 rows with <code>Virtualize</code>: only the visible rows are in the page.
    </p>
    <StilDataGrid TItem="DemoRow" Items="_rows" Virtualize Height="20rem" Compact Filterable Caption="Virtualized rows">
        <Columns>
            <StilDataGridColumn Property="r => r.Id" Title="#" Width="6rem" />
            <StilDataGridColumn Property="r => r.Name" />
            <StilDataGridColumn Property="r => r.Region" />
            <StilDataGridColumn Property="r => r.Score" Align="StilTextAlign.End" Format="N1" />
        </Columns>
    </StilDataGrid>
</section>

<StilDialog @bind-Open="_dialogOpen" Title="Invite a team member">
    <ChildContent>
        <p>They will get an email with a link to join.</p>
        <StilTextBox @bind-Value="_inviteEmail" Label="Email" Type="email" />
    </ChildContent>
    <Footer>
        <StilButton Appearance="StilButtonAppearance.Ghost" OnClick="() => _dialogOpen = false">Cancel</StilButton>
        <StilButton OnClick="Invite">Send invite</StilButton>
    </Footer>
</StilDialog>

@code {
    private sealed record DemoNode(string Name, params DemoNode[] Children);

    private sealed record MonthlyRevenue(string Month, int LastYear, int? ThisYear);

    private sealed record Channel(string Name, int Orders);

    private static readonly MonthlyRevenue[] _revenue =
    [
        new("Jan", 182, 204), new("Feb", 175, 211), new("Mar", 198, 236), new("Apr", 210, 249),
        new("May", 236, 268), new("Jun", 251, 290), new("Jul", 229, null), new("Aug", 240, null),
    ];

    private static readonly Channel[] _channels = [new("Web shop", 642), new("Stores", 418), new("Wholesale", 196), new("Phone", 57)];

    private static readonly double[] _weekly = [92, 104, 99, 118, 121, 109, 130, 127, 141, 152];

