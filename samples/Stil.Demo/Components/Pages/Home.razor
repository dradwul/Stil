@page "/"

<PageTitle>Stil</PageTitle>

<div class="stil-scope site-container">
    <header class="site-header stil-bg-primary">
        <img src="/stil-logo.svg" alt="Stil" class="logo" />
        <nav aria-label="Component sections">
            <a href="#buttons">Buttons</a>
            <a href="#inputs">Inputs</a>
            <a href="#cards">Cards</a>
            <a href="#alerts">Alerts</a>
            <a href="#typography">Typography</a>
            <a href="#tables">Tables</a>
            <div class="theme-picker">
                <select class="stil-input" data-theme-mode aria-label="Color mode">
                    <option value="light">Light</option>
                    <option value="dark">Dark</option>
                    <option value="auto">Auto (OS)</option>
                </select>
                <select class="stil-input" data-theme-palette aria-label="Palette">
                    <option value="teal">Teal (default)</option>
                    <option value="purple">Purple</option>
                    <option value="forest">Forest</option>
                    <option value="sunset">Sunset</option>
                </select>
            </div>
        </nav>
    </header>

    <section class="component-group" aria-labelledby="layout-heading">
        <h1 id="layout-heading">Layout</h1>
        <div class="component-group-code-example">
            <code>&lt;div class="stil-container"&gt;</code>
            <div class="component-group-code-example-content">
                <span>This is a simple container.</span>
            </div>
            <code>&lt;/div&gt;</code>
        </div>
        <div class="component-group-code-example-outcome">
            <span>Outcome:</span>
            <div class="stil-container">
                <p>This is a simple container.</p>
            </div>
        </div>
    </section>

    <section class="component-group" aria-labelledby="navigation-heading">
        <h1 id="navigation-heading">Navigation</h1>
        <div class="component-group-code-example">
            <code>&lt;nav&gt;</code>
            <div class="component-group-code-example-content">
                <span>&lt;a href="#"&gt;Home&lt;/a&gt;</span>
                <span>&lt;a href="#"&gt;About&lt;/a&gt;</span>
                <span>&lt;a href="#"&gt;Services&lt;/a&gt;</span>
                <span>&lt;a href="#"&gt;Contact&lt;/a&gt;</span>
            </div>
            <code>&lt;/nav&gt;</code>
        </div>
        <div class="component-group-code-example-outcome">
            <span>Outcome:</span>
            <nav aria-label="Example navigation">
                <a href="#layout-heading">Home</a>
                <a href="#typography">About</a>
                <a href="#buttons">Services</a>
                <a href="#forms-heading">Contact</a>
            </nav>
        </div>
    </section>

    <section class="component-group" aria-labelledby="colors-heading">
        <h1 id="colors-heading">Colors</h1>
        <div class="component-group-code-example">
            <code>&lt;div class="color-swatch stil-bg-primary"&gt;Primary&lt;/div&gt;</code>
            <code>&lt;div class="color-swatch stil-bg-secondary"&gt;Secondary&lt;/div&gt;</code>
            <code>&lt;div class="color-swatch stil-bg-success"&gt;Success&lt;/div&gt;</code>
            <code>&lt;div class="color-swatch stil-bg-danger"&gt;Danger&lt;/div&gt;</code>
            <code>&lt;div class="color-swatch stil-bg-warning"&gt;Warning&lt;/div&gt;</code>
            <code>&lt;div class="color-swatch stil-bg-info"&gt;Info&lt;/div&gt;</code>
        </div>
        <div class="component-group-code-example-outcome">
            <span>Outcome:</span>
            <div class="color-swatch stil-bg-primary">Primary</div>
            <div class="color-swatch stil-bg-secondary">Secondary</div>
            <div class="color-swatch stil-bg-success">Success</div>
            <div class="color-swatch stil-bg-danger">Danger</div>
            <div class="color-swatch stil-bg-warning">Warning</div>
            <div class="color-swatch stil-bg-info">Info</div>
        </div>
    </section>

    <section class="component-group" aria-labelledby="buttons">
        <h1 id="buttons">Buttons</h1>
        <div class="component-group-code-example">
            <code>&lt;button class="stil-btn stil-btn-primary"&gt;Primary Button&lt;/button&gt;</code>
            <code>&lt;button class="stil-btn stil-btn-sm stil-btn-primary"&gt;Small Button&lt;/button&gt;</code>
            <code>&lt;button class="stil-btn stil-btn-lg stil-btn-primary"&gt;Large Button&lt;/button&gt;</code>
        </div>
        <div class="component-group-code-example-outcome">
            <span>Outcome:</span>
            <div class="stil-btn-group">
                <button type="button" class="stil-btn stil-btn-primary">Primary Button</button>
                <button type="button" class="stil-btn stil-btn-secondary">Secondary Button</button>
                <button type="button" class="stil-btn stil-btn-success">Success Button</button>
                <button type="button" class="stil-btn stil-btn-danger">Danger Button</button>
                <button type="button" class="stil-btn stil-btn-warning">Warning Button</button>
                <button type="button" class="stil-btn stil-btn-info">Info Button</button>
            </div>
            <div class="stil-btn-group">
                <button type="button" class="stil-btn stil-btn-sm stil-btn-primary">Primary Button</button>
                <button type="button" class="stil-btn stil-btn-sm stil-btn-secondary">Secondary Button</button>
                <button type="button" class="stil-btn stil-btn-sm stil-btn-success">Success Button</button>
                <button type="button" class="stil-btn stil-btn-sm stil-btn-danger">Danger Button</button>
                <button type="button" class="stil-btn stil-btn-sm stil-btn-warning">Warning Button</button>
                <button type="button" class="stil-btn stil-btn-sm stil-btn-info">Info Button</button>
            </div>
            <div class="stil-btn-group">
                <button type="button" class="stil-btn stil-btn-lg stil-btn-primary">Primary Button</button>
                <button type="button" class="stil-btn stil-btn-lg stil-btn-secondary">Secondary Button</button>
                <button type="button" class="stil-btn stil-btn-lg stil-btn-success">Success Button</button>
                <button type="button" class="stil-btn stil-btn-lg stil-btn-danger">Danger Button</button>
                <button type="button" class="stil-btn stil-btn-lg stil-btn-warning">Warning Button</button>
                <button type="button" class="stil-btn stil-btn-lg stil-btn-info">Info Button</button>
            </div>
        </div>
    </section>

    <section class="component-group" aria-labelledby="inputs">
        <h1 id="inputs">Inputs</h1>
        <div class="component-group-code-example">
            <code>&lt;div class="stil-input-group"&gt;</code>
            <div class="component-group-code-example-content">
                <span>&lt;label for="text-input"&gt;Text input&lt;/label&gt;</span>
                <span>&lt;input type="text" id="text-input" class="stil-input"&gt;</span>
            </div>
            <code>&lt;/div&gt;</code>
        </div>
        <div class="component-group-code-example-outcome">
            <span>Outcome:</span>
            <div class="stil-input-group">
                <label for="text-input">Text input</label>
                <input type="text" id="text-input" class="stil-input" />
            </div>
        </div>
    </section>

    <section class="component-group" aria-labelledby="cards">
        <h1 id="cards">Cards</h1>
        <div class="component-group-code-example">
            <code>&lt;StilCard HeaderText="Card Title"&gt;</code>
            <div class="component-group-code-example-content">
                <span>This is a simple card component.</span>
                <span>Put your content and actions inside the component.</span>
            </div>
            <code>&lt;/StilCard&gt;</code>
        </div>
        <div class="component-group-code-example-outcome">
            <span>Outcome:</span>
            <StilCard HeaderText="Card Title">
                <p>This is a simple card component.</p>
                <div class="stil-card-footer">
                    <button type="button" class="stil-btn stil-btn-primary">Action</button>
                </div>
            </StilCard>
        </div>
    </section>

    <section class="component-group" aria-labelledby="alerts">
        <h1 id="alerts">Alerts</h1>
        <div class="component-group-code-example">
            <code>&lt;StilAlert Variant="StilVariant.Success"&gt;This is a success alert.&lt;/StilAlert&gt;</code>
            <code>&lt;StilAlert Variant="StilVariant.Danger"&gt;This is a danger alert.&lt;/StilAlert&gt;</code>
            <code>&lt;StilAlert Variant="StilVariant.Warning"&gt;This is a warning message.&lt;/StilAlert&gt;</code>
        </div>
        <div class="component-group-code-example-outcome">
            <span>Outcome:</span>
            <StilAlert Variant="StilVariant.Success">This is a success alert.</StilAlert>
            <StilAlert Variant="StilVariant.Danger">This is a danger alert.</StilAlert>
            <StilAlert Variant="StilVariant.Warning">This is a warning message.</StilAlert>
        </div>
    </section>

    <section class="component-group" aria-labelledby="typography">
        <h1 id="typography">Typography</h1>
        <div class="component-group-code-example">
            <code>&lt;p&gt;This is a paragraph of text.&lt;/p&gt;</code>
            <code>&lt;h2&gt;Heading 2&lt;/h2&gt;</code>
            <code>&lt;h3&gt;Heading 3&lt;/h3&gt;</code>
            <code>&lt;h4&gt;Heading 4&lt;/h4&gt;</code>
            <code>&lt;h5&gt;Heading 5&lt;/h5&gt;</code>
        </div>
        <div class="component-group-code-example-outcome">
            <span>Outcome:</span>
            <p>This is a paragraph of text. It uses the Didact Gothic font.</p>
            <h2>Heading 2</h2>
            <h3>Heading 3</h3>
            <h4>Heading 4</h4>
            <h5>Heading 5</h5>
        </div>
    </section>

    <section class="component-group" aria-labelledby="tables">
        <h1 id="tables">Tables</h1>
        <div class="component-group-code-example">
            <code>&lt;table class="stil-table"&gt;</code>
            <div class="component-group-code-example-content">
                <span>&lt;tr&gt;&lt;th&gt;Header 1&lt;/th&gt;&lt;th&gt;Header 2&lt;/th&gt;&lt;/tr&gt;</span>
                <span>&lt;tr&gt;&lt;td&gt;Data 1&lt;/td&gt;&lt;td&gt;Data 2&lt;/td&gt;&lt;/tr&gt;</span>
            </div>
            <code>&lt;/table&gt;</code>
        </div>
        <div class="component-group-code-example-outcome">
            <span>Outcome:</span>
            <table class="stil-table">
                <thead>
                    <tr>
                        <th scope="col">Header 1</th>
                        <th scope="col">Header 2</th>
                        <th scope="col">Header 3</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Data 1</td>
                        <td>Data 2</td>
                        <td>Data 3</td>
                    </tr>
                    <tr>
                        <td>Data 4</td>
                        <td>Data 5</td>
                        <td>Data 6</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="component-group" aria-labelledby="links-heading">
        <h1 id="links-heading">Links</h1>
        <div class="component-group-code-example">
            <code>&lt;a href="#buttons"&gt;This is a link&lt;/a&gt;</code>
        </div>
        <div class="component-group-code-example-outcome">
            <span>Outcome:</span>
            <a href="#buttons">This is a link</a>
        </div>
    </section>

    <section class="component-group" aria-labelledby="forms-heading">
        <h1 id="forms-heading">Forms</h1>
        <div class="component-group-code-example">
            <code>&lt;form class="stil-form"&gt;</code>
            <div class="component-group-code-example-content">
                <span>&lt;label for="name"&gt;Name&lt;/label&gt;</span>
                <span>&lt;input type="text" id="name" class="stil-input"&gt;</span>
                <span>&lt;label for="email"&gt;Email&lt;/label&gt;</span>
                <span>&lt;input type="email" id="email" class="stil-input"&gt;</span>
                <span>&lt;label for="message"&gt;Message&lt;/label&gt;</span>
                <span>&lt;textarea id="message" class="stil-input"&gt;&lt;/textarea&gt;</span>
                <span>&lt;button type="submit" class="stil-btn stil-btn-lg stil-btn-primary"&gt;Submit&lt;/button&gt;</span>
            </div>
            <code>&lt;/form&gt;</code>
        </div>
        <div class="component-group-code-example-outcome">
            <span>Outcome:</span>
            <form class="stil-form">
                <div class="stil-input-group">
                    <label for="name">Name</label>
                    <input type="text" id="name" class="stil-input" />
                </div>
                <div class="stil-input-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" class="stil-input" />
                </div>
                <div class="stil-input-group">
                    <label for="message">Message</label>
                    <textarea id="message" class="stil-input"></textarea>
                </div>
                <button type="submit" class="stil-btn stil-btn-lg stil-btn-primary">Submit</button>
            </form>
        </div>
    </section>
</div>
