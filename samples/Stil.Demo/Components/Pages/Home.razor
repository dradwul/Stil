    // A fixed "now" and culture, so the calendar looks the same on every run. The culture is built
    // from the invariant one (Monday first, 24-hour clock), since the screenshot tests run the demo
    // with invariant globalization, where named cultures are not available.
    private static readonly DateTime DemoNow = new(2026, 10, 14, 10, 20, 0);
    private static readonly System.Globalization.CultureInfo _calendarCulture = CreateCalendarCulture();

    private static System.Globalization.CultureInfo CreateCalendarCulture()
    {
        var culture = (System.Globalization.CultureInfo)System.Globalization.CultureInfo.InvariantCulture.Clone();
        var format = culture.DateTimeFormat;
        format.FirstDayOfWeek = DayOfWeek.Monday;
        format.YearMonthPattern = "MMMM yyyy";
        format.MonthDayPattern = "d MMMM";
        format.LongDatePattern = "dddd d MMMM yyyy";
        format.ShortTimePattern = "HH:mm";
        return System.Globalization.CultureInfo.ReadOnly(culture);
    }

