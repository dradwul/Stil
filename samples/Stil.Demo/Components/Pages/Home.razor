@page "/"
@inject IStilDialogService Dialogs
@inject IStilToastService Toasts

<PageTitle>Stil for Blazor</PageTitle>

<h1>Components</h1>
<p class="stil-text-muted">
    Every Stil for Blazor component, rendered interactively. For the plain CSS classes, open
    <code>samples/Stil.Html/index.html</code>; for a full CRUD example, see <a href="orders">Orders</a>.
</p>

<section class="demo-section" aria-labelledby="buttons">
    <h2 id="buttons">Buttons</h2>
    <div class="stil-stack">
        <div class="stil-cluster">
            @foreach (var variant in Enum.GetValues<StilVariant>())
            {
                <StilButton Variant="variant">@variant</StilButton>
            }
        </div>
        <div class="stil-cluster">
            <StilButton Appearance="StilButtonAppearance.Outline">Outline</StilButton>
            <StilButton Appearance="StilButtonAppearance.Ghost">Ghost</StilButton>
            <StilButton Size="StilSize.Small">Small</StilButton>
            <StilButton Size="StilSize.Large">Large</StilButton>
            <StilButton Disabled>Disabled</StilButton>
            <StilButton Loading="_saving" OnClick="SaveAsync">@(_saving ? "Saving" : "Save (loading)")</StilButton>
            <StilButton Pressed="_bold" OnClick="() => _bold = !_bold" Appearance="StilButtonAppearance.Outline" Variant="StilVariant.Secondary">Bold (toggle)</StilButton>
            <StilButton Href="orders" Appearance="StilButtonAppearance.Ghost">Link to orders</StilButton>
        </div>
    </div>
</section>

<section class="demo-section" aria-labelledby="lists">
    <h2 id="lists">Lists and badges</h2>
    <p>A row with a title and a status, on its own or grouped in a <code>StilList</code>.</p>
    <div class="stil-stack">
        <StilListItem Title="Order #1042" Badge="Delivered" BadgeVariant="StilVariant.Success" />

        <StilList>
            <StilListItem Title="Order #1043" Description="Berglund Outdoor · 7 Oct 2026" Badge="Shipped" BadgeVariant="StilVariant.Info" />
            <StilListItem Title="Order #1044" Description="Kallio Design Oy · 8 Oct 2026" Badge="Pending" BadgeVariant="StilVariant.Warning" BadgeSubtle />
            <StilListItem Title="Order #1045" Description="Østerby Marine · 9 Oct 2026" Badge="Cancelled" BadgeVariant="StilVariant.Danger"
                          OnClick="@(() => Toasts.Info("You clicked order #1045."))" />
            <StilListItem Title="Anna Berg" Description="Administrator">
                <Start><span class="stil-avatar stil-avatar-sm">AB</span></Start>
                <End>
                    <StilBadge Variant="StilVariant.Secondary" Subtle>Owner</StilBadge>
                    <StilButton Size="StilSize.Small" Appearance="StilButtonAppearance.Ghost">Edit</StilButton>
                </End>
            </StilListItem>
        </StilList>

        <div class="stil-cluster">
            @foreach (var variant in Enum.GetValues<StilVariant>())
            {
                <StilBadge Variant="variant">@variant</StilBadge>
            }
            <StilBadge Variant="StilVariant.Danger" Subtle>Subtle</StilBadge>
        </div>
    </div>
</section>

<section class="demo-section" aria-labelledby="cards">
    <h2 id="cards">Cards and alerts</h2>
    <div class="stil-grid">
        <StilCard Title="Monthly report" Subtitle="October 2026" HeadingLevel="3" class="stil-col-md-6">
            <ChildContent>
                <p>Revenue is up 12% on last month.</p>
            </ChildContent>
            <Footer>
                <StilButton Appearance="StilButtonAppearance.Ghost">Dismiss</StilButton>
                <StilButton>Open report</StilButton>
            </Footer>
        </StilCard>
        <StilCard Title="Team" HeadingLevel="3" class="stil-col-md-6">
            <HeaderActions>
                <StilButton Size="StilSize.Small" Appearance="StilButtonAppearance.Outline">Invite</StilButton>
            </HeaderActions>
            <ChildContent>
                <p>Four members, one pending invitation.</p>
            </ChildContent>
        </StilCard>
    </div>
    <div class="stil-stack stil-mt-4">
        <StilAlert Variant="StilVariant.Success" Title="Saved">Your changes are live.</StilAlert>
        <StilAlert Variant="StilVariant.Warning" Subtle Dismissible OnDismiss="@(() => Toasts.Info("Alert dismissed."))">
            Scheduled maintenance on Sunday at 02:00.
        </StilAlert>
    </div>
</section>

<section class="demo-section" aria-labelledby="forms">
    <h2 id="forms">Forms and validation</h2>
    <p>Fields bind with <code>@@bind-Value</code> and show DataAnnotations messages inside an <code>EditForm</code>.</p>
    <StilCard>
        <EditForm Model="_signup" OnValidSubmit="SignUpAsync" class="stil-form" novalidate>
            <DataAnnotationsValidator />
            <div class="stil-grid">
                <StilTextBox @bind-Value="_signup.Name" Label="Name" Hint="As it appears on invoices." class="stil-col-md-6" autocomplete="name" />
                <StilTextBox @bind-Value="_signup.Email" Label="Email" Type="email" class="stil-col-md-6" autocomplete="email" />
                <StilNumeric @bind-Value="_signup.Seats" Label="Seats" Min="1" Max="500" class="stil-col-md-4" />
                <StilSelect @bind-Value="_signup.Plan" Label="Plan" class="stil-col-md-4" />
                <StilDatePicker @bind-Value="_signup.StartDate" Label="Start date" class="stil-col-md-4" />
            </div>
            <StilRadioGroup @bind-Value="_signup.Billing" Label="Billing" Inline />
            <StilTextArea @bind-Value="_signup.Notes" Label="Notes" Rows="2" />
            <StilSwitch @bind-Value="_signup.Newsletter" Label="Send me product updates" />
            <StilCheckbox @bind-Value="_signup.AcceptTerms" Label="I accept the terms" />
            <div class="stil-cluster">
                <StilButton Type="submit">Sign up</StilButton>
                <StilButton Appearance="StilButtonAppearance.Ghost" OnClick="() => _signup = new()">Reset</StilButton>
            </div>
        </EditForm>
    </StilCard>
</section>

<section class="demo-section" aria-labelledby="tabs">
    <h2 id="tabs">Tabs</h2>
    <StilTabs @bind-ActiveIndex="_tab" Label="Account settings">
        <StilTab Title="Profile"><p>Profile settings. Use the arrow keys to move between tabs.</p></StilTab>
        <StilTab Title="Notifications"><p>Choose what we email you about.</p></StilTab>
        <StilTab Title="Billing" Disabled><p>Not available on the free plan.</p></StilTab>
        <StilTab Title="Security"><p>Two-factor authentication is on.</p></StilTab>
    </StilTabs>
</section>

<section class="demo-section" aria-labelledby="menus">
    <h2 id="menus">Dropdowns and tooltips</h2>
    <div class="stil-cluster">
        <StilDropdown Text="Actions" Appearance="StilButtonAppearance.Outline">
            <StilDropdownHeader>Order #1043</StilDropdownHeader>
            <StilDropdownItem OnClick="@(() => Toasts.Info("Edit clicked."))">Edit</StilDropdownItem>
            <StilDropdownItem OnClick="@(() => Toasts.Info("Duplicated."))">Duplicate</StilDropdownItem>
            <StilDropdownItem Disabled>Archive</StilDropdownItem>
            <StilDropdownDivider />
            <StilDropdownItem class="stil-text-danger" OnClick="DeleteDemoAsync">Delete…</StilDropdownItem>
        </StilDropdown>
        <StilTooltip Text="Saves without leaving the page">
            <StilButton Variant="StilVariant.Secondary">Hover me</StilButton>
        </StilTooltip>
        <StilTooltip Text="Shown below" Position="StilTooltipPosition.Bottom">
            <StilButton Appearance="StilButtonAppearance.Ghost">And me</StilButton>
        </StilTooltip>
    </div>
</section>

<section class="demo-section" aria-labelledby="feedback">
    <h2 id="feedback">Progress, spinners, dialogs and toasts</h2>
    <div class="stil-stack">
        <StilProgress Value="_progress" Label="Upload" />
        <StilProgress Value="72" Label="Storage" ShowValue Size="StilSize.Large" Variant="StilVariant.Success" />
        <div class="stil-cluster">
            <StilButton Size="StilSize.Small" Appearance="StilButtonAppearance.Outline" OnClick="() => _progress = Math.Min(100, _progress + 10)">+10%</StilButton>
            <StilSpinner Size="StilSize.Small" />
            <StilSpinner Variant="StilVariant.Primary" />
        </div>
        <div class="stil-cluster">
            <StilButton OnClick="() => _dialogOpen = true">Open dialog</StilButton>
            <StilButton Variant="StilVariant.Danger" Appearance="StilButtonAppearance.Outline" OnClick="DeleteDemoAsync">Confirm dialog</StilButton>
            <StilButton Variant="StilVariant.Success" Appearance="StilButtonAppearance.Outline" OnClick="@(() => Toasts.Success("Order #1043 shipped.", "Shipped"))">Success toast</StilButton>
            <StilButton Variant="StilVariant.Danger" Appearance="StilButtonAppearance.Outline" OnClick="@(() => Toasts.Error("The payment provider did not respond."))">Error toast</StilButton>
        </div>
    </div>
</section>

<StilDialog @bind-Open="_dialogOpen" Title="Invite a team member">
    <ChildContent>
        <p>They will get an email with a link to join.</p>
        <StilTextBox @bind-Value="_inviteEmail" Label="Email" Type="email" />
    </ChildContent>
    <Footer>
        <StilButton Appearance="StilButtonAppearance.Ghost" OnClick="() => _dialogOpen = false">Cancel</StilButton>
        <StilButton OnClick="Invite">Send invite</StilButton>
    </Footer>
</StilDialog>

@code {
    private bool _saving;
    private bool _bold;
    private int _tab;
    private double _progress = 40;
    private bool _dialogOpen;
    private string? _inviteEmail;
    private SignUp _signup = new();

    private async Task SaveAsync()
    {
        _saving = true;
        await Task.Delay(1500);
        _saving = false;
        Toasts.Success("Saved.");
    }

    private async Task DeleteDemoAsync()
    {
        var confirmed = await Dialogs.ConfirmAsync("Delete order?", "Order #1043 will be removed. This cannot be undone.",
            new StilConfirmOptions { ConfirmText = "Delete", ConfirmVariant = StilVariant.Danger });
        if (confirmed)
        {
            Toasts.Warning("Order #1043 deleted (not really, this is a demo).");
        }
    }

    private void Invite()
    {
        _dialogOpen = false;
        Toasts.Success($"Invitation sent to {_inviteEmail}.");
        _inviteEmail = null;
    }

    private Task SignUpAsync()
    {
        Toasts.Success($"Welcome, {_signup.Name}! Plan: {_signup.Plan}.", "Signed up");
        return Task.CompletedTask;
    }

    private enum Plan { Free, Team, Enterprise }

    private enum Billing { Monthly, Yearly }

    private sealed class SignUp
    {
        [Required(ErrorMessage = "Enter your name.")]
        public string? Name { get; set; }

        [Required(ErrorMessage = "Enter your email.")]
        [EmailAddress(ErrorMessage = "Enter a complete email address, like name@example.com.")]
        public string? Email { get; set; }

        [Range(1, 500, ErrorMessage = "Choose between 1 and 500 seats.")]
        public int Seats { get; set; } = 5;

        public Plan Plan { get; set; } = Plan.Team;

        public DateOnly? StartDate { get; set; }

        public Billing Billing { get; set; }

        public string? Notes { get; set; }

        public bool Newsletter { get; set; } = true;

        [Range(typeof(bool), "true", "true", ErrorMessage = "You need to accept the terms.")]
        public bool AcceptTerms { get; set; }
    }
}
