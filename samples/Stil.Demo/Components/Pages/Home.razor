    private void ShowEvent(DemoEvent e) =>
        Toasts.Info(string.Create(_calendarCulture, $"{e.Start:dddd d MMMM HH:mm}–{e.End:HH:mm}{(e.Place is null ? "" : $", {e.Place}")}"), e.Title);

    private void MoveEvent(StilCalendarItemChange<DemoEvent> change)
    {
        _events[_events.IndexOf(change.Item)] = change.Item with { Start = change.Start, End = change.End };
        Toasts.Success(string.Create(_calendarCulture, $"{change.Item.Title}: {change.Start:ddd HH:mm}–{change.End:HH:mm}."), "Moved");
    }

    private void CreateEvent(StilTimeSlot slot)
    {
        _events.Add(new("New event", slot.Start, slot.End, StilVariant.Primary, Draft: true));
        Toasts.Success(string.Create(_calendarCulture, $"{slot.Start:ddd HH:mm}–{slot.End:HH:mm}. In an app, this opens the editor."), "Draft created");
    }

