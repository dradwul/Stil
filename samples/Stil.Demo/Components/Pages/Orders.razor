@page "/orders"
@inject OrderStore Store
@inject IStilDialogService Dialogs
@inject IStilToastService Toasts
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>Orders · Stil for Blazor</PageTitle>

<div class="stil-d-flex stil-flex-wrap stil-justify-content-between stil-align-items-center stil-gap-3 stil-mb-4">
    <div>
        <h1 class="stil-mb-1">Orders</h1>
        <p class="stil-text-muted stil-mb-0">A CRUD page built only with Stil for Blazor: a data grid with sorting, filters, paging, selection, grouping and editing in place.</p>
    </div>
    <StilButton OnClick="NewRowAsync">New order</StilButton>
</div>

<div class="stil-grid stil-mb-4">
    <StilStatCard Label="Orders" Value="@_orders.Count.ToString("N0")" Icon="@StilIcons.File" class="stil-col-sm-6 stil-col-lg-3" />
    <StilStatCard Label="Revenue" Value="@($"{_orders.Where(o => o.Status != OrderStatus.Cancelled).Sum(o => o.Amount):N0} €")"
                  Trend="+8.2%" TrendDirection="StilTrendDirection.Up" Description="vs last month" class="stil-col-sm-6 stil-col-lg-3" />
    <StilStatCard Label="Pending" Value="@Count(OrderStatus.Pending).ToString()" Description="waiting to ship" class="stil-col-sm-6 stil-col-lg-3" />
    <StilStatCard Label="Cancelled" Value="@Count(OrderStatus.Cancelled).ToString()" Trend="-2" TrendDirection="StilTrendDirection.Down"
                  TrendVariant="StilVariant.Success" Description="vs last month" class="stil-col-sm-6 stil-col-lg-3" />
</div>

@* The dashboard: revenue and margin per week, the share delivered, and when orders come in. *@
<div class="stil-grid stil-mb-4">
    <div class="stil-card stil-card-body stil-col-lg-7 stil-align-self-start">
        <StilBarChart Items="Weeks" Category="w => w.Week" Title="Revenue and margin" Description="Per week, cancelled orders left out"
                      Format="N0" ValueAxisTitle="Revenue (€)" SecondaryAxisTitle="Margin (%)" SecondaryMin="0" Height="280">
            <StilChartSeries Name="Revenue" Value="w => w.Revenue" />
            <StilChartSeries Name="Margin" Value="w => w.Margin" Line="true" SecondaryAxis="true" Format="0.0'%'" />
        </StilBarChart>
    </div>
    <div class="stil-col-lg-5 stil-stack">
        <div class="stil-card stil-card-body">
            <StilGauge Value="DeliveredShare" Max="1" Target="0.6" Format="P0" Ranges="_deliveredRanges" Size="220"
                       Title="Delivered" Description="Share of the orders that are not cancelled" />
        </div>
        <div class="stil-card stil-card-body">
            <StilHeatMap Items="_orders" Row="o => DayName(o.OrderDate)" Column="o => TimeSlot(o.OrderTime)" Rows="DayNames" Columns="_timeSlots"
                         Title="Orders by day and time" RowTitle="Day" ColumnTitle="Time" />
        </div>
    </div>
</div>

<StilDataGrid @ref="_grid" TItem="Order" Items="_orders" EditMode="StilDataGridEditMode.Row" OnRowSave="SaveRowAsync" Filterable PageSize="10" PageSizeOptions="[10, 25, 50]"
              SelectionMode="StilSelectionMode.Multiple" @bind-SelectedItems="_selected" ItemKey="o => o.Id"
              RowClass="@(o => o.Status == OrderStatus.Cancelled ? "stil-text-muted" : null)" Caption="Orders, newest first"
              ShowExport ExportFileName="orders.csv" ResizableColumns ReorderableColumns ShowColumnChooser
              Layout="_layout" LayoutChanged="SaveLayoutAsync" ShowGroupChooser @bind-GroupBy="_groupBy">
    <Toolbar>
        <span class="stil-text-muted">@(_selected.Count == 0 ? "Select orders to act on several at once." : $"{_selected.Count} selected")</span>
        @if (_selected.Count > 0)
        {
            <StilButton Variant="StilVariant.Danger" Appearance="StilButtonAppearance.Outline" Size="StilSize.Small"
                        OnClick="DeleteSelectedAsync">Delete selected</StilButton>
        }
    </Toolbar>
    <Columns>
        <StilDataGridColumn Property="o => o.Id" Title="Order" InitialSort="StilSortDirection.Descending" Width="7rem" Frozen="StilFrozen.Start" Hideable="false" Editable="false">
            <Template>#@context.Id</Template>
        </StilDataGridColumn>
        <StilDataGridColumn Property="o => o.Customer" />
        <StilDataGridColumn Property="o => o.OrderDate" Title="Date" Format="d MMM yyyy" />
        <StilDataGridColumn Property="o => o.Status">
            <Template>
                <StilBadge Variant="@VariantOf(context.Status)" Subtle>@context.Status</StilBadge>
            </Template>
        </StilDataGridColumn>
        <StilDataGridColumn Property="o => o.Express" TrueText="Express" FalseText="Standard">
            <Template>@(context.Express ? "Express" : "")</Template>
        </StilDataGridColumn>
        <StilDataGridColumn Property="o => o.Amount" Title="Amount (€)" Format="N2" Align="StilTextAlign.End" Aggregate="StilAggregate.Sum" />
        <StilDataGridEditColumn TItem="Order" Frozen="StilFrozen.End" Reorderable="false" Resizable="false"
                                EditLabel="@(o => $"Edit order {o.Id}")" />
        <StilDataGridTemplateColumn Title="Actions" Align="StilTextAlign.End" Frozen="StilFrozen.End" Hideable="false" Reorderable="false" Resizable="false">
            <StilDropdown Text="⋯" AriaLabel="@($"Actions for order {context.Id}")" Appearance="StilButtonAppearance.Ghost"
                          Variant="StilVariant.Secondary" Size="StilSize.Small" AlignEnd IconOnly>
                <StilDropdownItem OnClick="() => _viewing = context">Details…</StilDropdownItem>
                <StilDropdownItem OnClick="() => Edit(context)">Edit all fields…</StilDropdownItem>
                <StilDropdownDivider />
                <StilDropdownItem class="stil-text-danger" OnClick="() => DeleteAsync(context)">Delete…</StilDropdownItem>
            </StilDropdown>
        </StilDataGridTemplateColumn>
    </Columns>
</StilDataGrid>

@* Details: the notes as Markdown and the product description as sanitized rich text. *@
<StilDialog Open="_viewing is not null" OpenChanged="open => { if (!open) _viewing = null; }" Size="StilSize.Large"
            Title="@($"Order #{_viewing?.Id}")">
    <ChildContent>
        @if (_viewing is { } order)
        {
            <p class="stil-text-muted">@order.Customer · @order.OrderDate.ToString("d MMM yyyy") @order.OrderTime.ToString("HH:mm") · @order.Amount.ToString("N2") €</p>
            <h3 class="stil-fs-md">Notes</h3>
            @if (string.IsNullOrWhiteSpace(order.Notes))
            {
                <p class="stil-text-muted">No notes.</p>
            }
            else
            {
                <StilMarkdown Value="@order.Notes" />
            }
            <h3 class="stil-fs-md stil-mt-4">Product description</h3>
            @if (StilRichText.HasText(order.Description))
            {
                <StilRichTextView Value="@order.Description" />
            }
            else
            {
                <p class="stil-text-muted">No description.</p>
            }
        }
    </ChildContent>
    <Footer>
        <StilButton Appearance="StilButtonAppearance.Ghost" Variant="StilVariant.Secondary" OnClick="() => _viewing = null">Close</StilButton>
        <StilButton OnClick="EditViewed">Edit</StilButton>
    </Footer>
</StilDialog>

<StilDialog @bind-Open="_editing" Size="StilSize.Large" Title="@(_draft.Id == 0 ? "New order" : $"Edit order #{_draft.Id}")">
    <ChildContent>
        <EditForm Model="_draft" OnValidSubmit="Save" class="stil-form" id="order-form" novalidate>
            <DataAnnotationsValidator />
            <StilTextBox @bind-Value="_draft.Customer" Label="Customer" autocomplete="organization" list="customers" />
            <datalist id="customers">
                @foreach (var customer in OrderStore.Customers)
                {
                    <option value="@customer"></option>
                }
            </datalist>
            <StilTextBox @bind-Value="_draft.Email" Label="Email" Type="email" />
            <div class="stil-grid">
                <StilNumeric @bind-Value="_draft.Amount" Label="Amount (€)" Step="0.01" Min="0" class="stil-col-sm-6" />
                <StilDatePicker @bind-Value="_draft.OrderDate" Label="Order date" class="stil-col-sm-6" />
            </div>
            <StilSelect @bind-Value="_draft.Status" Label="Status" />
            <StilSwitch @bind-Value="_draft.Express" Label="Express delivery" Hint="Ships within 24 hours." />
            <StilMarkdownEditor @bind-Value="_draft.Notes" Label="Notes" Hint="Markdown: **bold**, lists and links. Only staff see the notes." Rows="4" />
            <StilRichTextEditor @bind-Value="_draft.Description" Label="Product description" Placeholder="Describe the product, or paste from a web page…" />
        </EditForm>
    </ChildContent>
    <Footer>
        <StilButton Appearance="StilButtonAppearance.Ghost" Variant="StilVariant.Secondary" OnClick="() => _editing = false">Cancel</StilButton>
        <StilButton Type="submit" form="order-form">Save</StilButton>
    </Footer>
</StilDialog>

@code {
    private IReadOnlyList<Order> _orders = [];
    private IReadOnlyCollection<Order> _selected = [];
    private bool _editing;
    private Order _draft = new();
    private Order? _viewing;

    private void EditViewed()
    {
        if (_viewing is { } order)
        {
            _viewing = null;
            Edit(order);
        }
    }

    // The dashboard, worked out from the orders on every render, so it follows edits.

    private sealed record WeekResult(string Week, decimal Revenue, double Margin);

    private IEnumerable<WeekResult> Weeks => _orders
        .Where(o => o.Status != OrderStatus.Cancelled)
        .GroupBy(o => System.Globalization.ISOWeek.GetWeekOfYear(o.OrderDate.ToDateTime(TimeOnly.MinValue)))
        .OrderBy(g => g.Key)
        .Select(g =>
        {
            var revenue = g.Sum(o => o.Amount);
            var margin = revenue == 0 ? 0 : (double)((revenue - g.Sum(o => o.Cost)) / revenue) * 100;
            return new WeekResult($"W{g.Key}", revenue, Math.Round(margin, 1));
        });

    private double DeliveredShare
    {
        get
        {
            var active = _orders.Count(o => o.Status != OrderStatus.Cancelled);
            return active == 0 ? 0 : (double)Count(OrderStatus.Delivered) / active;
        }
    }

    private static readonly StilGaugeRange[] _deliveredRanges =
    [
        new(0, 0.4, "var(--stil-color-danger)", "Low"),
        new(0.4, 0.6, "var(--stil-color-warning)", "Fair"),
        new(0.6, 1, "var(--stil-color-success)", "Good"),
    ];

    // Monday first, in the current culture's short day names.
    private static IEnumerable<object> DayNames =>
        Enumerable.Range(1, 7).Select(d => (object)CultureInfo.CurrentCulture.DateTimeFormat.AbbreviatedDayNames[d % 7]);

    private static string DayName(DateOnly date) => CultureInfo.CurrentCulture.DateTimeFormat.AbbreviatedDayNames[(int)date.DayOfWeek];

    // Three-hour slots from 08 to 23.
    private static readonly object[] _timeSlots = [.. Enumerable.Range(0, 5).Select(i => (object)$"{8 + i * 3:00}–{11 + i * 3:00}")];

    private static string TimeSlot(TimeOnly time) => (string)_timeSlots[Math.Clamp((time.Hour - 8) / 3, 0, 4)];

    protected override void OnInitialized() => _orders = Store.All();

    // The column layout (order, widths, hidden columns, sort) is kept in the browser, so it survives a reload.
    private const string LayoutKey = "stil-demo-orders-layout";
    private StilDataGridLayout? _layout;

    // Grouped by status, with the number of orders and the total amount per status.
    private IReadOnlyList<string> _groupBy = ["Status"];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var json = await JS.InvokeAsync<string?>("localStorage.getItem", LayoutKey);
        if (!string.IsNullOrEmpty(json))
        {
            _layout = System.Text.Json.JsonSerializer.Deserialize<StilDataGridLayout>(json);
            StateHasChanged();
        }
    }

    private async Task SaveLayoutAsync(StilDataGridLayout layout)
    {
        _layout = layout;
        await JS.InvokeVoidAsync("localStorage.setItem", LayoutKey, System.Text.Json.JsonSerializer.Serialize(layout));
    }

    private int Count(OrderStatus status) => _orders.Count(o => o.Status == status);

    private static StilVariant VariantOf(OrderStatus status) => status switch
    {
        OrderStatus.Pending => StilVariant.Warning,
        OrderStatus.Shipped => StilVariant.Info,
        OrderStatus.Delivered => StilVariant.Success,
        _ => StilVariant.Danger,
    };

    private StilDataGrid<Order> _grid = default!;

    // A new order is a row at the top of the grid, edited in place; Save adds it to the store.
    private Task NewRowAsync() => _grid.AddRowAsync(new Order { Email = "orders@example.com" });

    private Task<bool> SaveRowAsync(StilDataGridEditArgs<Order> args)
    {
        Store.Save(args.Item);
        _orders = Store.All();
        Toasts.Success(args.IsNew ? $"Order #{args.Item.Id} created." : $"Order #{args.Item.Id} saved.");
        return Task.FromResult(true);
    }

    private void Edit(Order order)
    {
        _draft = order.Clone();
        _editing = true;
    }

    private void Save()
    {
        var isNew = _draft.Id == 0;
        Store.Save(_draft);
        _orders = Store.All();
        _editing = false;
        Toasts.Success(isNew ? $"Order #{_draft.Id} created." : $"Order #{_draft.Id} saved.");
    }

    private async Task DeleteAsync(Order order)
    {
        var confirmed = await Dialogs.ConfirmAsync(
            $"Delete order #{order.Id}?",
            $"The order for {order.Customer} will be removed. This cannot be undone.",
            new StilConfirmOptions { ConfirmText = "Delete", ConfirmVariant = StilVariant.Danger });

        if (!confirmed)
        {
            return;
        }

        Store.Delete(order.Id);
        _orders = Store.All();
        Toasts.Warning($"Order #{order.Id} deleted.");
    }

    private async Task DeleteSelectedAsync()
    {
        var count = _selected.Count;
        var confirmed = await Dialogs.ConfirmAsync(
            $"Delete {count} orders?",
            "The selected orders will be removed. This cannot be undone.",
            new StilConfirmOptions { ConfirmText = "Delete", ConfirmVariant = StilVariant.Danger });

        if (!confirmed)
        {
            return;
        }

        Store.Delete(_selected.Select(o => o.Id));
        _orders = Store.All();
        _selected = [];
        Toasts.Warning($"{count} orders deleted.");
    }
}
