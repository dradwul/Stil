@page "/orders"
@inject OrderStore Store
@inject IStilDialogService Dialogs
@inject IStilToastService Toasts

<PageTitle>Orders · Stil for Blazor</PageTitle>

<div class="stil-d-flex stil-flex-wrap stil-justify-content-between stil-align-items-center stil-gap-3 stil-mb-4">
    <div>
        <h1 class="stil-mb-1">Orders</h1>
        <p class="stil-text-muted stil-mb-0">A CRUD page built only with Stil for Blazor: a data grid with sorting, filters, paging and selection.</p>
    </div>
    <StilButton OnClick="New">New order</StilButton>
</div>

<div class="stil-grid stil-mb-4">
    <StilStatCard Label="Orders" Value="@_orders.Count.ToString("N0")" Icon="@StilIcons.File" class="stil-col-sm-6 stil-col-lg-3" />
    <StilStatCard Label="Revenue" Value="@($"{_orders.Where(o => o.Status != OrderStatus.Cancelled).Sum(o => o.Amount):N0} €")"
                  Trend="+8.2%" TrendDirection="StilTrendDirection.Up" Description="vs last month" class="stil-col-sm-6 stil-col-lg-3" />
    <StilStatCard Label="Pending" Value="@Count(OrderStatus.Pending).ToString()" Description="waiting to ship" class="stil-col-sm-6 stil-col-lg-3" />
    <StilStatCard Label="Cancelled" Value="@Count(OrderStatus.Cancelled).ToString()" Trend="-2" TrendDirection="StilTrendDirection.Down"
                  TrendVariant="StilVariant.Success" Description="vs last month" class="stil-col-sm-6 stil-col-lg-3" />
</div>

<StilDataGrid TItem="Order" Items="_orders" Filterable PageSize="10" PageSizeOptions="[10, 25, 50]"
              SelectionMode="StilSelectionMode.Multiple" @bind-SelectedItems="_selected" ItemKey="o => o.Id"
              RowClass="@(o => o.Status == OrderStatus.Cancelled ? "stil-text-muted" : null)" Caption="Orders, newest first">
    <Toolbar>
        <span class="stil-text-muted">@(_selected.Count == 0 ? "Select orders to act on several at once." : $"{_selected.Count} selected")</span>
        @if (_selected.Count > 0)
        {
            <StilButton Variant="StilVariant.Danger" Appearance="StilButtonAppearance.Outline" Size="StilSize.Small"
                        OnClick="DeleteSelectedAsync">Delete selected</StilButton>
        }
    </Toolbar>
    <Columns>
        <StilDataGridColumn Property="o => o.Id" Title="Order" InitialSort="StilSortDirection.Descending" Width="7rem">
            <Template>#@context.Id</Template>
        </StilDataGridColumn>
        <StilDataGridColumn Property="o => o.Customer" />
        <StilDataGridColumn Property="o => o.OrderDate" Title="Date" Format="d MMM yyyy" />
        <StilDataGridColumn Property="o => o.Status">
            <Template>
                <StilBadge Variant="@VariantOf(context.Status)" Subtle>@context.Status</StilBadge>
            </Template>
        </StilDataGridColumn>
        <StilDataGridColumn Property="o => o.Express" TrueText="Express" FalseText="Standard">
            <Template>@(context.Express ? "Express" : "")</Template>
        </StilDataGridColumn>
        <StilDataGridColumn Property="o => o.Amount" Title="Amount (€)" Format="N2" Align="StilTextAlign.End" />
        <StilDataGridTemplateColumn Title="Actions" Align="StilTextAlign.End">
            <StilDropdown Text="⋯" AriaLabel="@($"Actions for order {context.Id}")" Appearance="StilButtonAppearance.Ghost"
                          Variant="StilVariant.Secondary" Size="StilSize.Small" AlignEnd IconOnly>
                <StilDropdownItem OnClick="() => Edit(context)">Edit</StilDropdownItem>
                <StilDropdownDivider />
                <StilDropdownItem class="stil-text-danger" OnClick="() => DeleteAsync(context)">Delete…</StilDropdownItem>
            </StilDropdown>
        </StilDataGridTemplateColumn>
    </Columns>
</StilDataGrid>

<StilDialog @bind-Open="_editing" Title="@(_draft.Id == 0 ? "New order" : $"Edit order #{_draft.Id}")">
    <ChildContent>
        <EditForm Model="_draft" OnValidSubmit="Save" class="stil-form" id="order-form" novalidate>
            <DataAnnotationsValidator />
            <StilTextBox @bind-Value="_draft.Customer" Label="Customer" autocomplete="organization" list="customers" />
            <datalist id="customers">
                @foreach (var customer in OrderStore.Customers)
                {
                    <option value="@customer"></option>
                }
            </datalist>
            <StilTextBox @bind-Value="_draft.Email" Label="Email" Type="email" />
            <div class="stil-grid">
                <StilNumeric @bind-Value="_draft.Amount" Label="Amount (€)" Step="0.01" Min="0" class="stil-col-sm-6" />
                <StilDatePicker @bind-Value="_draft.OrderDate" Label="Order date" class="stil-col-sm-6" />
            </div>
            <StilSelect @bind-Value="_draft.Status" Label="Status" />
            <StilSwitch @bind-Value="_draft.Express" Label="Express delivery" Hint="Ships within 24 hours." />
        </EditForm>
    </ChildContent>
    <Footer>
        <StilButton Appearance="StilButtonAppearance.Ghost" Variant="StilVariant.Secondary" OnClick="() => _editing = false">Cancel</StilButton>
        <StilButton Type="submit" form="order-form">Save</StilButton>
    </Footer>
</StilDialog>

@code {
    private IReadOnlyList<Order> _orders = [];
    private IReadOnlyCollection<Order> _selected = [];
    private bool _editing;
    private Order _draft = new();

    protected override void OnInitialized() => _orders = Store.All();

    private int Count(OrderStatus status) => _orders.Count(o => o.Status == status);

    private static StilVariant VariantOf(OrderStatus status) => status switch
    {
        OrderStatus.Pending => StilVariant.Warning,
        OrderStatus.Shipped => StilVariant.Info,
        OrderStatus.Delivered => StilVariant.Success,
        _ => StilVariant.Danger,
    };

    private void New()
    {
        _draft = new Order();
        _editing = true;
    }

    private void Edit(Order order)
    {
        _draft = order.Clone();
        _editing = true;
    }

    private void Save()
    {
        var isNew = _draft.Id == 0;
        Store.Save(_draft);
        _orders = Store.All();
        _editing = false;
        Toasts.Success(isNew ? $"Order #{_draft.Id} created." : $"Order #{_draft.Id} saved.");
    }

    private async Task DeleteAsync(Order order)
    {
        var confirmed = await Dialogs.ConfirmAsync(
            $"Delete order #{order.Id}?",
            $"The order for {order.Customer} will be removed. This cannot be undone.",
            new StilConfirmOptions { ConfirmText = "Delete", ConfirmVariant = StilVariant.Danger });

        if (!confirmed)
        {
            return;
        }

        Store.Delete(order.Id);
        _orders = Store.All();
        Toasts.Warning($"Order #{order.Id} deleted.");
    }

    private async Task DeleteSelectedAsync()
    {
        var count = _selected.Count;
        var confirmed = await Dialogs.ConfirmAsync(
            $"Delete {count} orders?",
            "The selected orders will be removed. This cannot be undone.",
            new StilConfirmOptions { ConfirmText = "Delete", ConfirmVariant = StilVariant.Danger });

        if (!confirmed)
        {
            return;
        }

        Store.Delete(_selected.Select(o => o.Id));
        _orders = Store.All();
        _selected = [];
        Toasts.Warning($"{count} orders deleted.");
    }
}
