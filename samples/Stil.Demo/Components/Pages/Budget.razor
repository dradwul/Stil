@page "/budget"

<PageTitle>Budget · Stil for Blazor</PageTitle>

<div class="stil-mb-4">
    <h1 class="stil-mb-1">Budget</h1>
    <p class="stil-text-muted stil-mb-0">A cost-centre budget as a tree grid: departments roll up into divisions.</p>
</div>

<StilTreeGrid @ref="_grid" TItem="CostCentre" Items="_divisions" Children="c => c.Children" ExpandedLevels="1"
              ItemKey="c => c.Code" Filterable ShowExport ExportFileName="budget.csv" Caption="Budget 2027, in euros"
              RowClass="@(c => c.Remaining < 0 ? "stil-text-danger" : null)">
    <Toolbar>
        <StilButton Size="StilSize.Small" Variant="StilVariant.Secondary" Appearance="StilButtonAppearance.Ghost" OnClick="() => _grid.ExpandAllAsync()">Expand all</StilButton>
        <StilButton Size="StilSize.Small" Variant="StilVariant.Secondary" Appearance="StilButtonAppearance.Ghost" OnClick="() => _grid.CollapseAllAsync()">Collapse all</StilButton>
    </Toolbar>
    <Columns>
        <StilDataGridColumn Property="c => c.Name" Title="Cost centre" />
        <StilDataGridColumn Property="c => c.Code" />
        <StilDataGridColumn Property="c => c.Owner" />
        <StilDataGridColumn Property="c => c.Budget" Format="N0" Aggregate="StilAggregate.Sum" Align="StilTextAlign.End" />
        <StilDataGridColumn Property="c => c.Actual" Format="N0" Aggregate="StilAggregate.Sum" Align="StilTextAlign.End" />
        <StilDataGridColumn Property="c => c.Remaining" Format="N0" Aggregate="StilAggregate.Sum" Align="StilTextAlign.End" />
    </Columns>
</StilTreeGrid>

@code {
    private StilTreeGrid<CostCentre> _grid = default!;

    private sealed record CostCentre(string Code, string Name, string Owner, decimal Budget = 0, decimal Actual = 0, List<CostCentre>? Children = null)
    {
        public decimal Remaining => Budget - Actual;
    }

    private readonly List<CostCentre> _divisions =
    [
        new("100", "Sales", "Maja Lind", Children:
        [
